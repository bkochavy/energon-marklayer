@@ -0,0 +1,186 @@
+import { createExecutionContext, env, waitOnExecutionContext } from "cloudflare:test";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import worker from "../src/index";
+import type { Env } from "../src/types";
+import { access, auth, createSite, json, mint } from "./helpers";
+
+const enabled = { ...env, COMMENTS_ENABLED: "true" } as Env;
+const html = '<!doctype html><html><head><title>Native review</title></head><body><h1>Keep this content</h1><a href="next.html">Next</a></body></html>';
+afterEach(() => vi.restoreAllMocks());
+
+async function run(url: string, init?: RequestInit, bindings = enabled) {
+  const ctx = createExecutionContext();
+  const response = await worker.fetch(new Request(url.startsWith("http") ? url : `http://127.0.0.1${url}`, init), bindings, ctx);
+  await waitOnExecutionContext(ctx);
+  return response;
+}
+async function fixture(extra: Record<string, unknown> = {}) {
+  const token = await mint(`review-route-${crypto.randomUUID()}`);
+  const site = await createSite(token, `review-route-${crypto.randomUUID().slice(0, 8)}`, extra);
+  expect((await json(`/v1/sites/${site.id}/files/index.html`, { method: "PUT", headers: auth(token, { "content-type": "text/html" }), body: html })).status).toBe(201);
+  return { ...site, token };
+}
+function provider() {
+  const rooms = new Map<string, { url: string; ops: unknown[] }>();
+  const fetch = vi.spyOn(globalThis, "fetch").mockImplementation(async (input, init) => {
+    const url = new URL(String(input));
+    expect(url.origin).toBe("https://marklayer.app");
+    const id = url.pathname.split("/")[2];
+    if (init?.method === "POST") {
+      if (rooms.has(id)) return Response.json({}, { status: 409 });
+      rooms.set(id, { url: JSON.parse(String(init.body)).url, ops: [] });
+      return Response.json({ id, url: `https://marklayer.app/s/${id}`, version: null, previous: null });
+    }
+    return rooms.has(id) ? Response.json(rooms.get(id)) : Response.json({}, { status: 404 });
+  });
+  return { rooms, fetch };
+}
+
+describe("native review routing", () => {
+  it("preserves clean bytes and sandbox; review redirects to one stable room without contaminating cache", async () => {
+    const f = await fixture(); const p = provider();
+    expect(await (await run(f.url)).text()).toBe(html);
+    const head = await run(`${f.url}?comments=1`, { method: "HEAD" });
+    expect(await head.text()).toBe(""); expect(p.fetch).not.toHaveBeenCalled();
+    const open = await run(`${f.url}?view=mobile&comments=1`);
+    expect(open.status).toBe(302);
+    const review = open.headers.get("location")!;
+    expect(new URL(review).searchParams.get("view")).toBe("mobile");
+    expect(new URL(review).searchParams.get("comments")).not.toBe("1");
+    const response = await run(review);
+    expect(response.headers.get("cache-control")).toBe("private, no-store");
+    expect(response.headers.get("content-security-policy")).toContain("sandbox allow-scripts");
+    expect(response.headers.get("content-security-policy")).not.toContain("allow-same-origin");
+    expect(response.headers.has("etag")).toBe(false); expect(response.headers.has("content-length")).toBe(false);
+    expect(await response.text()).toContain('data-energon-comments="1"');
