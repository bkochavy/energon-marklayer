++      // Clicking elsewhere must not resurrect a pill for an old selection.
++      if (requireChanged && beforePointer && sameRange(beforePointer, sel.getRangeAt(0))) return;
++      const next = create.current(captured);
++      if (!next) {
++        clear();
++        return;
++      }
++      snapshot = sel.getRangeAt(0).cloneRange();
++      setPending(next);
