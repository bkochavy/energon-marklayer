@@ -0,0 +1,23 @@
+import { isExpired } from "../expire";
+import { contentOrigin, isPublicContentPath, publicOrigin } from "../http";
+import { storedLinkAccess } from "../link-access";
+import type { Env } from "../types";
+
+export type ReviewLinks = { review_url?: string; new_review_url?: string; comments_api_url?: string };
+
+/** Cheap additive metadata; provisioning only happens on an explicit review request. */
+export function reviewLinks(env: Env, url: string, page: {
+  content_type?: string | null; password_hash?: string | null; link_access?: string | null; expires_at?: string | null;
+}): ReviewLinks {
+  if (!/^(true|1|yes)$/i.test(env.COMMENTS_ENABLED?.trim() ?? "") || page.password_hash || storedLinkAccess(page.link_access) !== "public" ||
+      isExpired(page.expires_at) || page.content_type?.split(";", 1)[0].trim().toLowerCase() !== "text/html") return {};
+  const review = new URL(url), fresh = new URL(url), lookup = new URL("/v1/comments", publicOrigin(env));
+  // Legacy catalog rows can have only a token-authenticated API fallback URL.
+  // That preserves file access, but is not a published page for review controls.
+  if (![contentOrigin(env), publicOrigin(env)].includes(review.origin) || review.username || review.password ||
+      !isPublicContentPath(review.pathname)) return {};
+  review.searchParams.set("comments", "1");
+  fresh.searchParams.set("comments", "new");
+  lookup.searchParams.set("url", url);
+  return { review_url: review.href, new_review_url: fresh.href, comments_api_url: lookup.href };
+}
diff --git a/src/comments/presentation.ts b/src/comments/presentation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..cff6de970efb09c3fe8f6ea8a5c61769b2f37cd6
--- /dev/null
+++ b/src/comments/presentation.ts
@@ -0,0 +1,55 @@
+import { bootstrapCommentIdentity } from "./identity";
+import { escapeHtml } from "../chrome";
+import { ApiError, contentOrigin, publicOrigin, wantsDownload } from "../http";
+import type { Env } from "../types";
+import { COMMENT_WIDGET_PATH } from "./assets";
+import { commentMode, requestedCommentRoom } from "./query";
+import { commentsEnabled, ensureCommentRoom, getCommentLink, resolveCommentTarget } from "./service";
+
+/** Transform only the explicit review view, after the normal serving gates and raw-body cache. */
+export async function decorateCommentResponse(env: Env, request: Request, response: Response): Promise<Response> {
+  const url = new URL(request.url);
+  if (!commentsEnabled(env) || request.method !== "GET" || response.status !== 200 ||
+      wantsDownload(request) || url.searchParams.has("raw") || response.headers.has("content-range") ||
+      response.headers.get("content-type")?.split(";", 1)[0].trim().toLowerCase() !== "text/html") return response;
+  try {
+    const mode = commentMode(url.searchParams);
+    if (!mode || mode === "0") return response;
+    const roomId = requestedCommentRoom(url.href);
+    const target = await resolveCommentTarget(env, url.href);
+    if (mode === "new") {
+      const start = new URL("/comments/new", publicOrigin(env));
+      start.searchParams.set("url", target.url);
+      await response.body?.cancel();
+      return new Response(null, { status: 302, headers: { location: start.href, "cache-control": "private, no-store" } });
+    }
+    const room = roomId ? await getCommentLink(env, target, roomId) : await ensureCommentRoom(env, target);
+    if (!room || room.state === "pending")
+      throw new ApiError(410, "comment_room_expired", "This review is unavailable. Open the page with comments=1 to start or resume its current review.");
+    // Keep a concrete expired link on its own round. The widget offers explicit recovery;
+    // redirecting it through the generic link would silently select another conversation.
+    const review = new URL(target.url);
+    review.searchParams.set("comments", room.id);
+    const reviewUrl = review.href;
+    if (url.href !== reviewUrl) {
+      await response.body?.cancel();
+      return new Response(null, { status: 302, headers: { location: reviewUrl, "cache-control": "private, no-store" } });
+    }
+    const headers = new Headers(response.headers);
+    for (const name of ["content-length", "etag", "last-modified", "content-encoding", "cache-tag"]) headers.delete(name);
+    headers.set("cache-control", "private, no-store");
+    // Preference storage is optional. An outage must not stop native commenting.
+    const identity = await bootstrapCommentIdentity(env, request, target, headers).catch(() => null);
+    const identityAttribute = identity ? ` data-identity="${escapeHtml(JSON.stringify(identity))}"` : "";
+    const src = `${contentOrigin(env)}${COMMENT_WIDGET_PATH}`;
+    const script = `<script data-energon-comments="1" src="${escapeHtml(src)}" data-room="${escapeHtml(room.id)}" data-room-state="${room.state}"${identityAttribute} async referrerpolicy="no-referrer"></script>`;
+    let embedded = false;
+    return new HTMLRewriter()
+      .on("script[data-energon-comments]", { element() { embedded = true; } })
+      .onDocument({ end(end) { if (!embedded) end.append(script, { html: true }); } })
+      .transform(new Response(response.body, { status: response.status, headers }));
+  } catch (error) {
+    await response.body?.cancel().catch(() => undefined);
+    throw error;
+  }
+}
