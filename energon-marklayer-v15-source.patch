--- /dev/null
+++ b/src/comments/embed.ts
@@ -0,0 +1,28 @@
+import { ApiError } from "../http";
+import { MARKLAYER_ORIGIN } from "./provider";
+
+/** Inspect author HTML without buffering it or executing any of its scripts. */
+export async function assertNoCommentEmbed(body: ReadableStream<Uint8Array>, pageUrl: string): Promise<void> {
+  let embedded = false;
+  const handler = {
+    element(element: Element) {
+      if (element.hasAttribute("data-energon-comments")) { embedded = true; return; }
+      const source = element.getAttribute("src");
+      if (!source) return;
+      try {
+        const script = new URL(source, pageUrl);
+        if (script.pathname.endsWith("/widget.js") &&
+            (script.origin === MARKLAYER_ORIGIN || element.getAttribute("data-api-origin")?.replace(/\/$/, "") === MARKLAYER_ORIGIN))
+          embedded = true;
+      } catch { /* An unrelated malformed script URL does not configure this integration. */ }
+    },
+  };
+  const response = new HTMLRewriter()
+    .on("script[data-room]", handler)
+    .on("script[data-project]", handler)
+    .on("script[data-energon-comments]", handler)
+    .transform(new Response(body));
+  await response.body!.pipeTo(new WritableStream<Uint8Array>({ write() {} }));
+  if (embedded) throw new ApiError(409, "comments_already_embedded",
+    "This page already embeds comments. Use its original URL, or remove the existing embed before enabling Energon comments.");
+}
diff --git a/src/comments/identity.ts b/src/comments/identity.ts
new file mode 100644
index 0000000000000000000000000000000000000000..dc36b67c0aedffa8916e7a518963a54f4da423de
--- /dev/null
+++ b/src/comments/identity.ts
@@ -0,0 +1,140 @@
+import { jwtVerify, SignJWT } from "jose";
+import { ApiError, contentOrigin, isLocalHost, nanoid, readBodyCapped, sha256Hex } from "../http";
+import { getUserById } from "../handles";
+import { emailAllowed, instancePolicy } from "../policy";
+import type { Env } from "../types";
+import { commentsEnabled } from "./target";
+import type { CommentTarget } from "./types";
+
+export const COMMENT_IDENTITY_PATH = "/comments/identity";
+const TOKEN_SECONDS = 60 * 60;
+const PREFERENCE_SECONDS = 90 * 24 * 60 * 60;
+const PURPOSE = "energon-comment-identity";
+const HEX_ID = /^[a-f0-9]{64}$/;
+const REVISION = /^[a-f0-9]{8}-(?:[a-f0-9]{4}-){3}[a-f0-9]{12}$/;
+type Preference = { id: string; author_id: string; name: string | null; generation: string; expires_at: number };
+type Grant = { id: string; authorId: string; generation: string; exp: number };
+export type CommentIdentity = { id: string; name: string | null; endpoint: string; capability: string };
+
+function key(env: Env): Uint8Array | null {
+  return env.COMMENTS_IDENTITY_SECRET && env.COMMENTS_IDENTITY_SECRET.length >= 32
+    ? new TextEncoder().encode(env.COMMENTS_IDENTITY_SECRET) : null;
+}
+function endpoint(env: Env): string { return `${contentOrigin(env)}${COMMENT_IDENTITY_PATH}`; }
+function nowSeconds(): number { return Math.floor(Date.now() / 1000); }
+
+async function sign(env: Env, grant: Grant): Promise<string> {
+  return new SignJWT({ authorId: grant.authorId, generation: grant.generation, purpose: PURPOSE })
+    .setProtectedHeader({ alg: "HS256", typ: "JWT" }).setSubject(grant.id)
+    .setIssuer(contentOrigin(env)).setAudience(endpoint(env)).setExpirationTime(grant.exp).sign(key(env)!);
+}
+
+/** A name is a native MarkLayer preference, never an account or room permission. */
+export async function bootstrapCommentIdentity(env: Env, request: Request, target: CommentTarget,
+  headers: Headers): Promise<CommentIdentity | null> {
+  if (!key(env)) return null;
+  const cookieName = isLocalHost(new URL(request.url).hostname) ? "energon-reviewer" : "__Host-energon-reviewer";
+  const offered = request.headers.get("cookie")?.split(";").map(s => s.trim()).find(s => s.startsWith(`${cookieName}=`))?.slice(cookieName.length + 1);
+  const browser = offered && /^[A-Za-z0-9_-]{43}$/.test(offered) ? offered : nanoid(43);
+  const policy = instancePolicy(env);
+  // Existing public pages can outlive their owner's allowed-domain membership.
+  // Share a preference only when the current account still belongs to this company.
+  const companyOwner = policy.writePolicy === "org" && policy.allowedEmailDomains.length && target.ownerId
+    ? await getUserById(env, target.ownerId) : null;
+  const scope = companyOwner && emailAllowed(policy, companyOwner.email)
+    ? `org:${policy.allowedEmailDomains.slice().sort().join(",")}` : `owner:${target.ownerId ?? target.key}`;
+  const id = await sha256Hex(`${PURPOSE}:record:${scope}:${browser}`);
+  const authorId = await sha256Hex(`${PURPOSE}:author:${scope}:${browser}`);
+  const row = await env.DB.prepare("SELECT name, generation, expires_at FROM comment_identities WHERE id = ?")
+    .bind(id).first<Pick<Preference, "name" | "generation" | "expires_at">>();
+  const now = nowSeconds();
+  const capability = await sign(env, { id, authorId, generation: row?.generation ?? "new", exp: now + TOKEN_SECONDS });
+  if (browser !== offered) headers.append("set-cookie", `${cookieName}=${browser}; Path=/; Max-Age=${PREFERENCE_SECONDS}; HttpOnly; SameSite=Lax${isLocalHost(new URL(request.url).hostname) ? "" : "; Secure"}`);
+  return { id: authorId, name: row && row.expires_at > now ? row.name : null, endpoint: endpoint(env), capability };
+}
+
+function response(body: unknown, status = 200): Response {
+  return new Response(status === 204 ? null : JSON.stringify(body), { status, headers: {
+    "content-type": "application/json; charset=utf-8", "cache-control": "private, no-store", pragma: "no-cache",
+    "access-control-allow-origin": "*", "access-control-allow-methods": "POST, DELETE, OPTIONS",
+    "access-control-allow-headers": "Authorization, Content-Type", "access-control-max-age": "600",
+  } });
+}
+const rejected = () => response({ error: "identity_capability_invalid" }, 401);
+
+async function authorize(env: Env, request: Request): Promise<Grant | null> {
+  const token = /^Bearer ([^\s]+)$/.exec(request.headers.get("authorization") ?? "")?.[1];
+  if (!token || token.length > 2048) return null;
+  try {
+    const { payload } = await jwtVerify(token, key(env)!, {
+      algorithms: ["HS256"], issuer: contentOrigin(env), audience: endpoint(env), typ: "JWT",
+    });
+    if (payload.purpose !== PURPOSE || typeof payload.sub !== "string" || !HEX_ID.test(payload.sub) ||
+      typeof payload.authorId !== "string" || !HEX_ID.test(payload.authorId) ||
+      typeof payload.generation !== "string" || (payload.generation !== "new" && !REVISION.test(payload.generation)) ||
+      typeof payload.exp !== "number" || payload.exp > nowSeconds() + TOKEN_SECONDS) return null;
+    return { id: payload.sub, authorId: payload.authorId, generation: payload.generation, exp: payload.exp };
+  } catch { return null; }
+}
+
+async function readName(request: Request, env: Env): Promise<string | null> {
+  if (request.headers.get("content-type")?.split(";", 1)[0].trim().toLowerCase() !== "application/json") return null;
+  const bytes = await readBodyCapped(request, 1024, contentOrigin(env));
+  let body: unknown;
+  try { body = JSON.parse(new TextDecoder().decode(bytes)); }
+  catch { return null; }
+  const value = body && typeof body === "object" && !Array.isArray(body) ? (body as { name?: unknown }).name : undefined;
+  if (typeof value !== "string") return null;
+  const name = value.trim();
+  return !name || name.length > 24 || [...name].some(c => c.charCodeAt(0) < 32 || c.charCodeAt(0) === 127) ? null : name;
+}
+
+/** The opaque sandbox origin is allowed by CORS, but only the scoped bearer grants authority. */
+export async function commentIdentityResponse(env: Env, request: Request): Promise<Response> {
+  const url = new URL(request.url);
+  if ((!isLocalHost(url.hostname) && url.origin !== contentOrigin(env)) || !commentsEnabled(env) || !key(env))
+    return response({ error: "not_found" }, 404);
+  if (request.method === "OPTIONS") return response(null, 204);
+  if (request.method !== "POST" && request.method !== "DELETE") return response({ error: "method_not_allowed" }, 405);
+  const grant = await authorize(env, request);
+  if (!grant) return rejected();
+  try {
+    let name: string | null = null;
+    if (request.method === "POST") {
+      name = await readName(request, env);
+      if (!name) return response({ error: "identity_name_invalid" }, 400);
+    }
+    const generation = crypto.randomUUID();
+    const expires = nowSeconds() + PREFERENCE_SECONDS;
+    // A deliberate Forget wins across tabs and leaves a tombstone. Name saves are
+    // conditional: a late save cannot undo Forget. Only a new-profile capability can
+    // insert a name. Random revisions prevent an old token matching a recreated row.
+    const result = request.method === "DELETE"
+      ? await env.DB.prepare(`INSERT INTO comment_identities (id, author_id, name, generation, expires_at)
+          VALUES (?, ?, NULL, ?, ?) ON CONFLICT(id) DO UPDATE SET name = NULL,
+          generation = excluded.generation, expires_at = excluded.expires_at
+          WHERE comment_identities.author_id = excluded.author_id RETURNING generation`)
+        .bind(grant.id, grant.authorId, generation, expires).first<{ generation: string }>()
+      : grant.generation === "new"
+      ? await env.DB.prepare(`INSERT INTO comment_identities (id, author_id, name, generation, expires_at)
+          VALUES (?, ?, ?, ?, ?) ON CONFLICT(id) DO NOTHING RETURNING generation`)
+        .bind(grant.id, grant.authorId, name, generation, expires).first<{ generation: string }>()
+      : await env.DB.prepare(`UPDATE comment_identities SET name = ?, generation = ?, expires_at = ?
+          WHERE id = ? AND author_id = ? AND generation = ? RETURNING generation`)
+        .bind(name, generation, expires, grant.id, grant.authorId, grant.generation).first<{ generation: string }>();
+    if (!result) return response({ error: "identity_changed" }, 409);
+    // Keep the document's original deadline: responses do not turn a one-hour grant into a session.
+    return response({ name, capability: await sign(env, { ...grant, generation: result.generation }) });
+  } catch (error) {
+    if (error instanceof ApiError && error.status === 413) return response({ error: "too_large" }, 413);
+    return response({ error: "identity_unavailable" }, 503);
+  }
+}
+
+/** At 90 days every capability that could have inserted this row has long expired.
+ * Existing-profile revisions cannot reinsert after cleanup. Limit each existing cron pass. */
+export async function purgeCommentIdentities(env: Env): Promise<void> {
+  await env.DB.prepare(`DELETE FROM comment_identities WHERE id IN
+    (SELECT id FROM comment_identities WHERE expires_at < ? LIMIT 500)`)
+    .bind(nowSeconds()).run();
+}
