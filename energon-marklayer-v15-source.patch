++/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
++/** Adopt isolated styles without weakening a page's style-src; preserve sheets owned by others. */
++export function adoptStyles({ root, css }: { root: ShadowRoot | Document; css: string }): () => void {
++  if ('adoptedStyleSheets' in root && typeof CSSStyleSheet.prototype.replaceSync === 'function') {
++    const sheet = new CSSStyleSheet();
++    sheet.replaceSync(css);
++    root.adoptedStyleSheets = [...root.adoptedStyleSheets, sheet];
++    return () => {
++      root.adoptedStyleSheets = root.adoptedStyleSheets.filter((existing) => existing !== sheet);
++    };
++  }
++  const doc = root.nodeType === 9 ? (root as Document) : root.ownerDocument!;
++  const style = doc.createElement('style');
++  style.textContent = css;
++  (root.nodeType === 9 ? doc.head : root).append(style);
++  return () => style.remove();
++}
