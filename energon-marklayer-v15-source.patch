++      if (ownEvent(e)) return;
++      touching = e.pointerType === 'touch' || coarse;
++      suppressed = false;
++      const sel = window.getSelection();
++      beforePointer = sel?.rangeCount ? sel.getRangeAt(0).cloneRange() : null;
