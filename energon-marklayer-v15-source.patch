+<script lang="ts">
+  import { onMount } from 'svelte';
+  import type { CommentsNewData } from '../types';
+  let { data }: { data: CommentsNewData } = $props();
+  let dialog: HTMLDialogElement;
+  let submitting = $state(false);
+  const returnUrl = $derived(data.current_review_url || data.url);
+
+  onMount(() => {
+    // The server-rendered open dialog keeps the ordinary form usable before hydration.
+    dialog.close();
+    dialog.showModal();
+  });
+
+  function cancel(event: Event) {
+    event.preventDefault();
+    if (!submitting) window.location.assign(returnUrl);
+  }
+
+  function submit(event: SubmitEvent) {
+    if (submitting) event.preventDefault();
+    else submitting = true;
+  }
+</script>
+
+<main class="review-preview">
+  <iframe src={data.url} title="Published page preview" sandbox="allow-scripts" referrerpolicy="no-referrer" inert tabindex="-1" aria-hidden="true"></iframe>
