new file mode 100644
index 0000000000000000000000000000000000000000..ae0fe960d7bc52f73cdd5468236e7680d6b44173
--- /dev/null
+++ b/test/pages.comments.spec.ts
@@ -0,0 +1,91 @@
+import { describe, expect, it } from 'vitest';
+import { uiPage } from '../src/ui-render';
+import type { CatalogItem, HubData } from '../src/ui/types';
+
+const clean = 'https://share.example.com/ben/s/Abc123/prototype/';
+const item: CatalogItem = {
+  kind: 'site', id: 'Abc123', slug: 'prototype', url: clean, file_count: 1, size: 100,
+  created_by: 'ben@example.com', last_written_by: 'ben@example.com',
+  created_at: '2026-11-09T12:00:00Z', updated_at: '2026-11-09T12:00:00Z', expires_at: null,
+  password_protected: false, write_policy: 'org', link_access: 'public',
+};
+function hub(entry: CatalogItem) {
+  const data: HubData = {
+    email: 'ben@example.com', handle: 'ben', origin: 'https://hub.example.com', content_origin: 'https://share.example.com',
+    items: [entry], total: 1, cursor: null, words: [],
+    policy: { presets: [{ id: 'never', label: 'Never' }], default_ttl: 'never', allow_unlimited: true, write_policy: 'org' },
+  };
+  return uiPage('Energon', { page: 'hub', data });
+}
+
+describe('Hub comments actions', () => {
+  it('keeps the ordinary catalog link and copy action alongside an eligible review link', () => {
+    const html = hub({ ...item, review_url: clean + '?comments=1' });
+    expect(html).toContain(`href="${clean}"`);
+    expect(html).toContain('aria-label="Copy URL"');
+    expect(html).toContain(`href="${clean}?comments=1"`);
+    expect(html).toContain('aria-label="Open with comments"');
+  });
+
+  it('adds no review control when support is absent, private, or password-protected', () => {
+    for (const entry of [item, { ...item, review_url: clean + '?comments=1', link_access: 'private' as const }, { ...item, review_url: clean + '?comments=1', password_protected: true }]) {
+      expect(hub(entry)).not.toContain('aria-label="Open with comments"');
+    }
+  });
+});
+
+
+describe('New review confirmation page', () => {
+  const data = {
+    email: 'ben@example.com', url: clean, title: 'Prototype', current_review_url: clean + '?comments=old-room',
+    idempotency_key: 'review-operation-123',
+  };
+
+  it('offers a native explicit POST and keeps cancel on the current review', () => {
+    const html = uiPage('Start a new review', { page: 'comments-new', data }).replace(/<!--.*?-->/g, '');
+    expect(html).toContain('id="comments-new-form" method="post" action="/account/comments/new"');
+    expect(html).toContain('name="url" value="' + clean + '"');
+    expect(html).toContain('name="idempotency_key" value="review-operation-123"');
+    expect(html).toContain('id="comments-new-submit"');
+    expect(html).toContain('type="submit"');
+    expect(html).toContain('>Start a new review</button>');
+    expect(html).toContain('Start a fresh review?');
+    expect(html).toContain('Existing feedback stays in the previous review');
+    expect(html).toContain('href="' + data.current_review_url + '"');
+    expect(html).toContain('>Cancel</a>');
+    expect(html).not.toContain('id="who"');
+  });
+
+  it('keeps the preview isolated and outside the trusted confirmation controls', () => {
+    const html = uiPage('Start a new review', { page: 'comments-new', data, footer: 'Hub footer' }).replace(/<!--.*?-->/g, '');
+    const frame = html.match(/<iframe\b[^>]*>/)?.[0] ?? '';
+    expect(frame).toContain(`src="${clean}"`);
+    expect(frame).toContain('sandbox="allow-scripts"');
+    expect(frame).toContain('inert');
+    expect(frame).toContain('tabindex="-1"');
+    expect(frame).toContain('aria-hidden="true"');
+    expect(frame).toContain('referrerpolicy="no-referrer"');
+    expect(html).toContain('<dialog open');
+    expect(html).toContain('aria-labelledby="new-review-title"');
+    expect(html).not.toContain('<footer');
+    expect(html).not.toContain('id="who"');
+  });
+
+  it('includes scoped dialog styling in the initial HTML without waiting for JavaScript', () => {
+    const html = uiPage('Start a new review', { page: 'comments-new', data });
+    const head = html.slice(0, html.indexOf('</head>'));
+    const css = [...head.matchAll(/<style>([\s\S]*?)<\/style>/g)].map(match => match[1]).join('\n');
+    expect(css).toMatch(/\.page-comments-new \.review-dialog\{[^}]*position:fixed/);
+    expect(css).toMatch(/\.page-comments-new iframe\{[^}]*pointer-events:none/);
+    expect(css).toContain('.page-comments-new .review-dialog:not(:modal)');
+    expect(css).toContain('.page-comments-new .review-dialog::backdrop');
+  });
+
+  it('uses the clean page for cancel without an existing review and escapes supplied titles', () => {
+    const html = uiPage('Start a new review', { page: 'comments-new', data: { ...data, title: '<script>bad()</script>', current_review_url: null } });
+    expect(html).not.toContain('<script>bad()</script>');
+    expect(html).toContain('&lt;script>bad()&lt;/script>');
+    expect(html).not.toContain('>Open the current review</a>');
+    expect(html).toContain('href="' + clean + '"');
+  });
+});
