++        ? {
++            id: e.pointerId,
++            x: e.clientX,
++            y: e.clientY,
++            scrollX,
++            scrollY,
++            dragged: false,
++            touch: e.pointerType === 'touch',
++            started: Date.now(),
++          }
++        : null;
++  };
