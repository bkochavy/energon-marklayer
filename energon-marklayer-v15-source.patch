++  const target = e.composedPath()[0];
++  if (!(target instanceof Element)) return null;
++  // closest() cannot cross a shadow root; the event path includes our UI's host.
++  if (e.composedPath().some((node) => node instanceof Element && isExtensionElement(node))) return null;
