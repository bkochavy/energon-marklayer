++afterEach(() => {
++  render(null, root);
++  root.remove();
++  activeTool.value = 'navigate';
++});
++test('B and V both browse through the native keymap but do not steal typing', async () => {
++  document.body.append(root);
++  await act(() => render(<Flow />, root));
++  for (const key of ['b', 'v']) {
++    activeTool.value = 'comment';
++    await act(() => {
++      window.dispatchEvent(new KeyboardEvent('keydown', { key, code: `Key${key.toUpperCase()}`, bubbles: true }));
++    });
++    expect(String(activeTool.value)).toBe('navigate');
++  }
++  activeTool.value = 'comment';
++  await act(() => {
++    root.querySelector('input')!.dispatchEvent(new KeyboardEvent('keydown', { key: 'b', code: 'KeyB', bubbles: true }));
++  });
++  expect(activeTool.value).toBe('comment');
++});
++
++test('L copies the current published page and concrete active room through the native clipboard path', async () => {
++  document.body.append(root);
