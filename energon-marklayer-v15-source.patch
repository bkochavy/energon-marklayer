@@ -0,0 +1,69 @@
+import { ApiError, capStream } from "../http";
+
+export const MARKLAYER_ORIGIN = "https://marklayer.app";
+const PROVIDER_TIMEOUT_MS = 5000;
+const MAX_RESPONSE_BYTES = 4 * 1024 * 1024;
+
+function providerError(status?: number): ApiError {
+  return new ApiError(503, "comment_provider_unavailable", "The comment service is temporarily unavailable. Try again; existing comments have not been changed.",
+    status === 429 ? { retry_after: 60 } : {});
+}
+
+function pageKey(raw: string): string | null {
+  try { const url = new URL(raw); return `${url.origin}${url.pathname.replace(/\/+$/, "")}`; }
+  catch { return null; }
+}
+
+async function readJsonBounded(response: Response): Promise<unknown> {
+  if (!response.body) throw providerError();
+  try {
+    return await new Response(capStream(response.body, MAX_RESPONSE_BYTES, () => providerError())).json();
+  } catch (error) {
+    if (error instanceof ApiError) throw error;
+    throw providerError();
+  }
+}
+
+async function request(path: string, init?: RequestInit): Promise<Response> {
+  try {
+    return await fetch(`${MARKLAYER_ORIGIN}${path}`, { ...init, redirect: "manual", signal: AbortSignal.timeout(PROVIDER_TIMEOUT_MS) });
+  } catch { throw providerError(); }
+}
+
+/** 404 alone means absent. Passwords, rate limits, transport failures and bad payloads never do. */
+export async function hostedRoomExists(id: string, pageUrl: string): Promise<boolean> {
+  const response = await request(`/api/${encodeURIComponent(id)}`);
+  if (response.status === 404) { await response.body?.cancel(); return false; }
+  if (!response.ok) { await response.body?.cancel(); throw providerError(response.status); }
+  const body = await readJsonBounded(response);
+  if (!body || typeof body !== "object" || !("url" in body) || typeof body.url !== "string") throw providerError();
+  if (pageKey(body.url) !== pageKey(pageUrl))
+    throw new ApiError(409, "comment_room_conflict", "This comment room belongs to a different page.");
+  return true;
+}
+
+/** Native preview creation is insert-only, so retries can never replace another viewer's comments. */
+export async function createHostedRoom(id: string, pageUrl: string, title: string): Promise<void> {
+  let response: Response;
+  try {
+    response = await request(`/api/${encodeURIComponent(id)}/preview`, {
+      method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ url: pageUrl, title: title.slice(0, 200) }),
+    });
+  } catch (error) {
+    // The insert may have committed before its response was lost.
+    if (await hostedRoomExists(id, pageUrl)) return;
+    throw error;
+  }
+  if (response.ok) {
+    const body = await readJsonBounded(response);
+    if (!body || typeof body !== "object" || !("id" in body) || body.id !== id) throw providerError();
+    return;
+  }
+  if (response.status === 409 || response.status >= 500) {
+    await response.body?.cancel();
+    if (await hostedRoomExists(id, pageUrl)) return;
+    throw providerError();
+  }
+  await response.body?.cancel();
+  throw providerError(response.status);
+}
diff --git a/src/comments/query.ts b/src/comments/query.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4abac29452543c096decb3ae067549e1edd63d59
--- /dev/null
+++ b/src/comments/query.ts
@@ -0,0 +1,19 @@
+import { ApiError } from "../http";
+
+/** All aliases share one mode; mixed or repeated parameters are ambiguous. */
+export function commentMode(params: URLSearchParams): string | null {
+  const values = [...params.getAll("comments"), ...params.getAll("comment"), ...params.getAll("feedback")];
+  if (values.length > 1)
+    throw new ApiError(400, "bad_comment_mode", "Use one comment, comments, or feedback parameter: 0, 1, new, or a review room ID.");
+  return values.length ? values[0] || "1" : null;
+}
+
+export function requestedCommentRoom(url: string): string | undefined {
+  const params = new URL(url).searchParams;
+  const mode = commentMode(params);
+  if (!mode || mode === "0" || mode === "1" || mode === "new") return undefined;
+  if (!/^[A-Za-z0-9_-]{16,128}$/.test(mode))
+    throw new ApiError(400, "bad_comment_mode", "Use comments=1, comments=new, or a review room ID.");
+  return mode;
+}
+
diff --git a/src/comments/routes.ts b/src/comments/routes.ts
new file mode 100644
index 0000000000000000000000000000000000000000..979ace3c06cedfdb06a3f1bca5ec2e582b71b6a1
--- /dev/null
+++ b/src/comments/routes.ts
@@ -0,0 +1,46 @@
+import { requestedCommentRoom } from "./query";
+export { requestedCommentRoom } from "./query";
+import { PRIVATE_HTML_HEADERS } from "../chrome";
+import { ApiError, publicOrigin, readBodyCapped, readJson, secretJson } from "../http";
+import { uiPage } from "../ui-render";
+import { pageChrome } from "../upstream";
+import type { Actor, Env } from "../types";
+import { commentLinks, ensureCommentRoom, getCommentLink, newCommentRoom, resolveCommentTarget } from "./service";
+
+
+export async function lookupComments(env: Env, actor: Actor, url: string): Promise<Response> {
+  const target = await resolveCommentTarget(env, url, actor);
+  return secretJson(commentLinks(env, target, await getCommentLink(env, target, requestedCommentRoom(url))));
+}
+
+export async function createCommentReview(env: Env, actor: Actor, request: Request): Promise<Response> {
+  const body = await readJson(request, 16 * 1024);
+  const action = body.action ?? "ensure";
+  if (action !== "ensure" && action !== "new")
+    throw new ApiError(400, "bad_comment_mode", "action must be ensure or new.");
+  const target = await resolveCommentTarget(env, body.url as string, actor, { mutate: true });
+  const room = action === "new"
+    ? await newCommentRoom(env, target, body.idempotency_key as string)
+    : await ensureCommentRoom(env, target);
+  return secretJson(commentLinks(env, target, room));
+}
+
+/** Viewing this page is read-only; only its explicit form submission starts a new round. */
+export async function newReviewPage(env: Env, actor: Actor, url: string): Promise<Response> {
+  const target = await resolveCommentTarget(env, url, actor, { mutate: true });
+  const room = await getCommentLink(env, target);
+  return new Response(uiPage("Start a new review", { page: "comments-new", data: {
+    email: actor.email, admin: Boolean(actor.admin), title: target.title, url: target.url,
+    current_review_url: room?.state === "ready" ? commentLinks(env, target, room).review_url : null,
+    idempotency_key: crypto.randomUUID(),
+  }, ...await pageChrome(env, Boolean(actor.admin)) }), { headers: { ...PRIVATE_HTML_HEADERS, "cache-control": "private, no-store" } });
+}
+
+export async function submitNewReview(env: Env, actor: Actor, request: Request): Promise<Response> {
+  if (!request.headers.get("content-type")?.startsWith("application/x-www-form-urlencoded"))
+    throw new ApiError(400, "bad_comment_mode", "Submit the new review form.");
+  const form = new URLSearchParams(new TextDecoder().decode(await readBodyCapped(request, 16 * 1024, publicOrigin(env))));
+  const target = await resolveCommentTarget(env, form.get("url") ?? "", actor, { mutate: true });
+  const room = await newCommentRoom(env, target, form.get("idempotency_key") ?? "");
+  return new Response(null, { status: 303, headers: { location: commentLinks(env, target, room).review_url, "cache-control": "private, no-store" } });
+}
diff --git a/src/comments/service.ts b/src/comments/service.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7f684927f184e9bdc8ec4d2444e6c48a4b987b4b
--- /dev/null
+++ b/src/comments/service.ts
@@ -0,0 +1,78 @@
+import { ApiError, publicOrigin } from "../http";
+import type { Env } from "../types";
+import { createHostedRoom, hostedRoomExists, MARKLAYER_ORIGIN } from "./provider";
+import { currentRoom, findRoom, markRoomMissing, markRoomReady, promoteRoom, reserveCurrentRoom, reserveRoom } from "./store";
+import { revalidateCommentTarget } from "./target";
+import type { CommentLinks, CommentRoom, CommentTarget } from "./types";
+
+export { commentsEnabled, resolveCommentTarget } from "./target";
+export type { CommentLinks, CommentRoom, CommentTarget } from "./types";
+
+export function commentLinks(env: Env, target: CommentTarget, room: CommentRoom | null): CommentLinks {
+  const review = new URL(target.url), fresh = new URL(target.url), lookup = new URL(`${publicOrigin(env)}/v1/comments`);
+  const mapped = room?.state === "ready" || room?.state === "missing";
+  review.searchParams.set("comments", mapped ? room.id : "1");
+  fresh.searchParams.set("comments", "new");
+  lookup.searchParams.set("url", mapped ? review.href : target.url);
+  return {
+    url: target.url, review_url: review.href, new_review_url: fresh.href, comments_api_url: lookup.href,
+    provider: "marklayer", status: room?.state ?? "none",
+    room: room ? { id: room.id, created_at: room.created_at, content_generation: room.content_generation,
+      feedback_url: `${MARKLAYER_ORIGIN}/api/${room.id}`, mcp_url: `${MARKLAYER_ORIGIN}/s/${room.id}/mcp?readonly=1` } : null,
+  };
+}
+
+/** Read-only discovery deliberately does not provision a room or prolong native inactivity retention. */
+export async function getCommentLink(env: Env, target: CommentTarget, roomId?: string): Promise<CommentRoom | null> {
+  if (roomId && !/^[A-Za-z0-9_-]{16,128}$/.test(roomId))
+    throw new ApiError(404, "comment_room_not_found", "No comment room for this page.");
+  const room = roomId ? await findRoom(env.DB, target.key, roomId) : await currentRoom(env.DB, target.key);
+  if (roomId && (!room || room.page_url !== target.canonicalUrl)) throw new ApiError(404, "comment_room_not_found", "No comment room for this page.");
+  if (!roomId && room?.page_url !== target.canonicalUrl) return null;
+  return room;
+}
+
+async function provision(env: Env, target: CommentTarget, room: CommentRoom): Promise<CommentRoom> {
+  if (room.page_url !== target.canonicalUrl)
+    throw new ApiError(409, "comment_page_changed", "This review belongs to the page's previous URL. Start a new review.");
+  if (room.state === "missing")
+    throw new ApiError(410, "comment_room_expired", "This comment room is no longer available. Start a new review.");
+  if (room.state === "pending") await createHostedRoom(room.id, room.page_url, target.title);
+  await revalidateCommentTarget(env, target);
+  return room.state === "ready" ? room : markRoomReady(env.DB, room);
+}
+
+export async function ensureCommentRoom(env: Env, target: CommentTarget): Promise<CommentRoom> {
+  await revalidateCommentTarget(env, target);
+  let room = await currentRoom(env.DB, target.key);
+  if (!room) room = await reserveCurrentRoom(env.DB, target);
+  // One replacement per missing room. Other requests can create/promote a newer round meanwhile.
+  for (let attempt = 0; attempt < 3; attempt++) {
+    if (room.state === "ready" && room.page_url === target.canonicalUrl) {
+      if (await hostedRoomExists(room.id, room.page_url)) {
+        await revalidateCommentTarget(env, target);
+        return room;
+      }
+      await markRoomMissing(env.DB, room);
+      room = { ...room, state: "missing" };
+    }
+    if (room.state === "missing" || room.page_url !== target.canonicalUrl) {
+      room = await reserveCurrentRoom(env.DB, target, room);
+      continue;
+    }
+    return provision(env, target, room);
+  }
+  throw new ApiError(409, "comment_page_changed", "The current review changed while it was opening. Reload and try again.");
+}
+
+export async function newCommentRoom(env: Env, target: CommentTarget, idempotencyKey: string): Promise<CommentRoom> {
+  if (!target.authority?.mutate)
+    throw new ApiError(403, "forbidden_write", "Sign in with permission to write this page before starting a new review.");
+  if (typeof idempotencyKey !== "string" || !/^[A-Za-z0-9._:-]{8,128}$/.test(idempotencyKey))
+    throw new ApiError(400, "bad_idempotency_key", "A new review requires idempotency_key: 8–128 letters, digits, dots, underscores, colons or hyphens. Reuse it when retrying.");
+  await revalidateCommentTarget(env, target);
+  const reserved = await reserveRoom(env.DB, target, `new:${idempotencyKey}`);
+  const room = await provision(env, target, reserved);
+  await promoteRoom(env.DB, room);
+  return room;
+}
diff --git a/src/comments/store.ts b/src/comments/store.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a0579bb1c90ed318045b01f1dcf351c0379cc718
--- /dev/null
+++ b/src/comments/store.ts
@@ -0,0 +1,54 @@
+import type { CommentRoom, CommentTarget } from "./types";
+
+const ROOM_COLUMNS = "sequence, id, page_key, page_url, owner_id, content_generation, created_at, state, request_key";
+
+export async function currentRoom(db: D1Database, key: string): Promise<CommentRoom | null> {
+  return db.prepare(`SELECT ${ROOM_COLUMNS.split(", ").map(column => `r.${column}`).join(", ")}
+    FROM comment_pages p JOIN comment_rooms r ON r.id = p.current_room_id WHERE p.page_key = ?`)
+    .bind(key).first<CommentRoom>();
+}
+
+export function findRoom(db: D1Database, key: string, id: string): Promise<CommentRoom | null> {
+  return db.prepare(`SELECT ${ROOM_COLUMNS} FROM comment_rooms WHERE page_key = ? AND id = ?`)
+    .bind(key, id).first<CommentRoom>();
+}
+
+/** A named intent reserves exactly one random native ID, even across isolates and lost responses. */
+export async function reserveRoom(db: D1Database, target: CommentTarget, requestKey: string): Promise<CommentRoom> {
+  await db.prepare(`INSERT INTO comment_rooms
+    (id, page_key, page_url, owner_id, content_generation, created_at, state, request_key)
+    VALUES (?, ?, ?, ?, ?, ?, 'pending', ?) ON CONFLICT(page_key, request_key) DO NOTHING`)
+    .bind(crypto.randomUUID(), target.key, target.canonicalUrl, target.ownerId, target.contentGeneration,
+      new Date().toISOString(), requestKey).run();
+  return (await db.prepare(`SELECT ${ROOM_COLUMNS} FROM comment_rooms WHERE page_key = ? AND request_key = ?`)
+    .bind(target.key, requestKey).first<CommentRoom>())!;
+}
+
+export async function reserveCurrentRoom(db: D1Database, target: CommentTarget, previous?: CommentRoom): Promise<CommentRoom> {
+  const room = await reserveRoom(db, target, previous ? `replace:${previous.id}` : "initial");
+  if (previous) {
+    await db.prepare("UPDATE comment_pages SET current_room_id = ? WHERE page_key = ? AND current_room_id = ?")
+      .bind(room.id, target.key, previous.id).run();
+  } else {
+    await db.prepare("INSERT INTO comment_pages (page_key, current_room_id) VALUES (?, ?) ON CONFLICT(page_key) DO NOTHING")
+      .bind(target.key, room.id).run();
+  }
+  return (await currentRoom(db, target.key))!;
+}
+
+export async function markRoomReady(db: D1Database, room: CommentRoom): Promise<CommentRoom> {
+  await db.prepare("UPDATE comment_rooms SET state = 'ready' WHERE id = ? AND state = 'pending'").bind(room.id).run();
+  return (await findRoom(db, room.page_key, room.id))!;
+}
+
+export async function markRoomMissing(db: D1Database, room: CommentRoom): Promise<void> {
+  await db.prepare("UPDATE comment_rooms SET state = 'missing' WHERE id = ? AND state = 'ready'").bind(room.id).run();
+}
+
+/** A slower earlier request cannot move the current pointer back over a later review intent. */
+export async function promoteRoom(db: D1Database, room: CommentRoom): Promise<void> {
+  await db.prepare(`INSERT INTO comment_pages (page_key, current_room_id) VALUES (?, ?)
+    ON CONFLICT(page_key) DO UPDATE SET current_room_id = excluded.current_room_id
+    WHERE (SELECT sequence FROM comment_rooms WHERE id = comment_pages.current_room_id) < ?`)
+    .bind(room.page_key, room.id, room.sequence).run();
+}
diff --git a/src/comments/target.ts b/src/comments/target.ts
new file mode 100644
index 0000000000000000000000000000000000000000..34baee43a1271a4aed7613c242a51d45f65f9026
--- /dev/null
+++ b/src/comments/target.ts
@@ -0,0 +1,135 @@
+import { fileKey } from "../config";
+import { isExpired, isPurgeClaimed } from "../expire";
+import { ApiError, contentOrigin, publicOrigin } from "../http";
+import { hiddenFrom, storedLinkAccess } from "../link-access";
+import { assertCanMutate } from "../policy";
+import { withSiteRead } from "../site-reads";
+import { assertFilePath, getSiteById, requireSite } from "../sites";
+import type { Actor, Env, LooseFileRow, SiteRow } from "../types";
+import { filePublicUrl, isObjectId, sitePublicUrl, urlFilename } from "../urls";
+import type { CommentTarget } from "./types";
+import { assertNoCommentEmbed } from "./embed";
+
+type PageIdentity = Omit<CommentTarget, "url" | "authority">;
+type ParsedPage = { input: URL; kind: "site" | "file"; handle: string; id: string; name: string; path?: string };
+
+export function commentsEnabled(env: Env): boolean {
+  return /^(true|1|yes)$/i.test((env.COMMENTS_ENABLED ?? "").trim());
+}
+
+function unavailable(): never {
+  throw new ApiError(400, "comments_unavailable", "Comments are available on public HTML pages without a share password.");
+}
+
+function notFound(kind: "site" | "file"): never {
+  throw new ApiError(404, kind === "site" ? "site_not_found" : "file_not_found", "No published page at that URL.");
+}
+
+function decode(part: string): string {
+  try { return decodeURIComponent(part); }
+  catch { throw new ApiError(400, "bad_comment_url", "The page URL contains invalid encoding."); }
+}
+
+function eligible(row: { link_access?: string | null; password_hash?: string | null; expires_at?: string | null; last_written_by?: string | null }): void {
+  if (storedLinkAccess(row.link_access) !== "public" || row.password_hash) unavailable();
+  if (isExpired(row.expires_at) || isPurgeClaimed(row.last_written_by))
+    throw new ApiError(410, "expired", "This page has expired or is being deleted.");
+}
+
+function html(type: string): boolean { return type.split(";", 1)[0].trim().toLowerCase() === "text/html"; }
+
+function parsePage(env: Env, rawUrl: string): ParsedPage {
+  if (typeof rawUrl !== "string" || rawUrl.length > 8192)
+    throw new ApiError(400, "bad_comment_url", "Provide a published page URL from this Energon (at most 8192 characters).");
+  let input: URL;
+  try { input = new URL(rawUrl); }
+  catch { throw new ApiError(400, "bad_comment_url", "Provide an absolute published page URL from this Energon."); }
+  if (![contentOrigin(env), publicOrigin(env)].includes(input.origin) || input.username || input.password)
+    throw new ApiError(400, "bad_comment_url", "The page must be hosted by this Energon.");
+  if (input.searchParams.has("download") || input.searchParams.has("raw")) unavailable();
+  const match = /^\/([^/]+)\/(s|f)\/([^/]+)\/([^/]+)(?:\/(.*))?$/.exec(input.pathname);
+  if (!match || !isObjectId(decode(match[3])))
+    throw new ApiError(400, "bad_comment_url", "Provide a published site page or HTML file URL.");
+  return { input, kind: match[2] === "s" ? "site" : "file", handle: decode(match[1]).toLowerCase(),
+    id: decode(match[3]), name: decode(match[4]), path: match[5] };
+}
+
+async function requireSiteHtml(env: Env, site: SiteRow, path: string, root: boolean): Promise<void> {
+  let supported = false;
+  await withSiteRead(env, site, "comments", async snapshot => {
+    const metadata = snapshot.versionId ? await snapshot.metadata(path) : null;
+    const object = await snapshot.get(path);
+    if (!object) {
+      // An existing site's root falls back to Markdown or a directory listing.
+      // An explicitly requested missing file still has the normal 404 semantics.
+      if (root) unavailable();
+      notFound("site");
+    }
+    supported = path === "index.html" || html(object.httpMetadata?.contentType ?? metadata?.content_type ?? "");
+    if (supported) await assertNoCommentEmbed(object.body, sitePublicUrl(env, site.handle, site.id, site.slug, path));
+    else await object.body.cancel();
+    return new Response(null, { status: 204 });
+  });
+  if (!supported) unavailable();
+}
+
+async function resolveSitePage(env: Env, page: ParsedPage, actor: Actor | undefined, mutate: boolean): Promise<PageIdentity> {
+  const site = actor ? await requireSite(env, actor, page.id, { mutate }) : await getSiteById(env, page.id);
+  if (!site || site.handle !== page.handle || site.slug !== page.name) notFound("site");
+  // An unauthenticated lookup must not distinguish another account's private page from missing.
+  if (!actor && storedLinkAccess(site.link_access) === "private") notFound("site");
+  eligible(site);
+  const path = page.path ? assertFilePath(page.path) : "index.html";
+  await requireSiteHtml(env, site, path, !page.path);
+  const publicPath = path === "index.html" ? "" : path.split("/").map(encodeURIComponent).join("/");
+  return { key: `site:${page.id}:${path}`, kind: "site", id: page.id, path,
+    canonicalUrl: sitePublicUrl(env, site.handle, site.id, site.slug, publicPath),
+    title: path === "index.html" ? site.slug : `${site.slug} / ${path}`, ownerId: site.owner_id ?? null,
+    contentGeneration: site.content_generation ?? 0 };
+}
+
+async function resolveLoosePage(env: Env, page: ParsedPage, actor: Actor | undefined, mutate: boolean): Promise<PageIdentity> {
+  if (page.path !== undefined) notFound("file");
+  const row = await env.DB.prepare("SELECT * FROM loose_files WHERE id = ?").bind(page.id).first<LooseFileRow>();
+  if (!row || (row.handle && row.handle !== page.handle) || (actor && hiddenFrom(actor, row))) notFound("file");
+  if (!actor && storedLinkAccess(row.link_access) === "private") notFound("file");
+  eligible(row);
+  if (actor && mutate) assertCanMutate(actor, row);
+  // serveLoose redirects old names to the stored name; use that same canonical URL.
+  const object = await env.BUCKET.get(fileKey(page.id, row.filename));
+  if (!object) notFound("file");
+  if (!html(object.httpMetadata?.contentType ?? row.content_type)) {
+    await object.body.cancel();
+    unavailable();
+  }
+  const filename = urlFilename(row.filename);
+  const canonicalUrl = filePublicUrl(env, row.handle || page.handle, page.id, encodeURIComponent(filename));
+  await assertNoCommentEmbed(object.body, canonicalUrl);
+  return { key: `file:${page.id}`, kind: "file", id: page.id, path: filename,
+    canonicalUrl,
+    title: row.filename, ownerId: row.owner_id ?? null, contentGeneration: row.content_generation };
+}
+
+export async function resolveCommentTarget(
+  env: Env, rawUrl: string, actor?: Actor, options: { mutate?: boolean } = {},
+): Promise<CommentTarget> {
+  if (!commentsEnabled(env)) throw new ApiError(404, "comments_disabled", "Comments are not enabled on this Energon.");
+  const page = parsePage(env, rawUrl);
+  const target = page.kind === "site"
+    ? await resolveSitePage(env, page, actor, Boolean(options.mutate))
+    : await resolveLoosePage(env, page, actor, Boolean(options.mutate));
+  const url = new URL(target.canonicalUrl);
+  page.input.searchParams.delete("comments");
+  page.input.searchParams.delete("comment");
+  page.input.searchParams.delete("feedback");
+  url.search = page.input.search;
+  url.hash = page.input.hash;
+  return { ...target, url: url.href, ...(actor ? { authority: { actor, mutate: Boolean(options.mutate) } } : {}) };
+}
+
+/** Never expose a room discovered before a provider call if access changed while it was in flight. */
+export async function revalidateCommentTarget(env: Env, target: CommentTarget): Promise<void> {
+  const current = await resolveCommentTarget(env, target.url, target.authority?.actor, { mutate: target.authority?.mutate });
+  if (current.key !== target.key || current.canonicalUrl !== target.canonicalUrl || current.ownerId !== target.ownerId)
+    throw new ApiError(409, "comment_page_changed", "The page changed while its review was being prepared. Reload and try again.");
+}
diff --git a/src/comments/types.ts b/src/comments/types.ts
new file mode 100644
index 0000000000000000000000000000000000000000..76f28c506b32695a9a2e820aff4ece7d52674c23
--- /dev/null
+++ b/src/comments/types.ts
@@ -0,0 +1,44 @@
+import type { Actor } from "../types";
+
+/** Page identity is independent of query, fragment, and published content generation. */
+export type CommentTarget = {
+  key: string;
+  kind: "site" | "file";
+  id: string;
+  path: string;
+  url: string;
+  canonicalUrl: string;
+  title: string;
+  ownerId: string | null;
+  contentGeneration: number;
+  /** Kept in memory only, so a provider round trip can recheck the original authority. */
+  authority?: { actor: Actor; mutate: boolean };
+};
+
+export type CommentRoom = {
+  sequence: number;
+  id: string;
+  page_key: string;
+  page_url: string;
+  owner_id: string | null;
+  content_generation: number;
+  created_at: string;
+  state: "pending" | "ready" | "missing";
+  request_key: string;
+};
+
+export type CommentLinks = {
+  url: string;
+  review_url: string;
+  new_review_url: string;
+  comments_api_url: string;
+  provider: "marklayer";
+  status: "none" | CommentRoom["state"];
+  room: null | {
+    id: string;
