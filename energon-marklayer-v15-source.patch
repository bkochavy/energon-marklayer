@@ -0,0 +1,95 @@
+import { createExecutionContext, env, waitOnExecutionContext } from "cloudflare:test";
+import { describe, expect, it } from "vitest";
+import worker from "../src/index";
+import { reviewLinks } from "../src/comments/links";
+import { resolveCommentTarget } from "../src/comments/target";
+import type { Env } from "../src/types";
+import { access, auth, createSite, json, mint } from "./helpers";
+
+const enabled = { ...env, COMMENTS_ENABLED: "true" } as Env;
+async function run(url: string, init?: RequestInit): Promise<Response> {
+  const ctx = createExecutionContext();
+  const response = await worker.fetch(new Request(url.startsWith("http") ? url : `http://127.0.0.1${url}`, init), enabled, ctx);
+  await waitOnExecutionContext(ctx);
+  return response;
+}
+async function lookup(url: string, token: string) {
+  const response = await run(`/v1/comments?url=${encodeURIComponent(url)}`, { headers: auth(token) });
+  return { status: response.status, body: await response.json() as any };
+}
+
+describe("comment eligibility", () => {
+  it.each(["markdown", "directory"])("reports an existing %s root as unsupported while missing files stay missing", async kind => {
+    const token = await mint(`comment-eligibility-${crypto.randomUUID()}`);
+    const site = await createSite(token, `comment-eligibility-${crypto.randomUUID().slice(0, 8)}`);
+    if (kind === "markdown") {
+      expect((await json(`/v1/sites/${site.id}/files/index.md`, {
+        method: "PUT", headers: auth(token, { "content-type": "text/markdown" }), body: "# Existing root",
+      })).status).toBe(201);
+    }
+    expect((await run(site.url, { headers: { accept: "text/html" } })).status).toBe(200);
+    for (const url of [site.url, site.url.slice(0, -1)]) {
+      expect(await lookup(url, token)).toMatchObject({ status: 400, body: { error: "comments_unavailable" } });
+    }
+    const browser = await run(`${site.url}?comments=1`, { headers: { accept: "text/html" } });
+    expect(browser.status).toBe(400);
+    expect(await browser.json()).toMatchObject({ error: "comments_unavailable" });
+    for (const path of ["index.html", "missing.html"]) {
+      expect(await lookup(site.url + path, token)).toMatchObject({ status: 404, body: { error: "site_not_found" } });
+    }
+  });
+
+  it("keeps hidden and absent roots indistinguishable, and preserves supported HTML aliases", async () => {
+    const token = await mint(`comment-root-owner-${crypto.randomUUID()}`);
+    const other = await mint(`comment-root-other-${crypto.randomUUID()}`, "bob@esperlabs.app");
+    const privateSite = await createSite(token, `comment-private-${crypto.randomUUID().slice(0, 8)}`, { link_access: "private" });
+    expect(await lookup(privateSite.url, other)).toMatchObject({ status: 404, body: { error: "site_not_found" } });
+    await expect(resolveCommentTarget(enabled, privateSite.url)).rejects.toMatchObject({ status: 404, code: "site_not_found" });
+    const missingUrl = privateSite.url.replace(`/${privateSite.id}/`, "/NoSuch1/");
+    expect(await lookup(missingUrl, other)).toMatchObject({ status: 404, body: { error: "site_not_found" } });
+    const site = await createSite(token, `comment-html-${crypto.randomUUID().slice(0, 8)}`);
+    expect((await json(`/v1/sites/${site.id}/files/index.html`, {
+      method: "PUT", headers: auth(token, { "content-type": "text/html" }), body: "<!doctype html><h1>Supported</h1>",
+    })).status).toBe(201);
+    const root = await lookup(site.url, token), index = await lookup(site.url + "index.html", token);
+    expect(root.status).toBe(200);
+    expect(root.body).toMatchObject({ status: "none", review_url: `${site.url}?comments=1` });
+    expect(index).toEqual(root);
+  });
+
+  it("omits review controls for a legacy API fallback in both the file list and Hub", async () => {
+    const token = await mint(`comment-legacy-${crypto.randomUUID()}`);
+    const created = await json("/v1/files", {
+      method: "POST", headers: auth(token, { "content-type": "text/html", "X-Filename": "comment-legacy.html" }),
+      body: "<!doctype html><h1>Legacy content</h1>",
+    });
+    expect(created.status).toBe(201);
+    const { id, url } = created.body;
+    const list = async () => (await (await run("/v1/files", { headers: auth(token) })).json() as any).files.find((row: any) => row.id === id);
+    expect((await list()).review_url).toBe(`${url}?comments=1`);
+    await env.DB.prepare("UPDATE loose_files SET handle = NULL WHERE id = ?").bind(id).run();
+    const row = await list();
+    const hub = await (await run("/account/data", { headers: access("ada@esperlabs.app") })).json() as any;
+    for (const item of [row, hub.items.find((item: any) => item.id === id)]) {
+      expect(item.url).toBe(`https://hub.energon.example.com/v1/files/${id}`);
+      expect(item).not.toHaveProperty("review_url");
+      expect(item).not.toHaveProperty("new_review_url");
+      expect(item).not.toHaveProperty("comments_api_url");
+    }
+    expect((await run(url)).status).toBe(200);
+    expect(await env.DB.prepare("SELECT handle FROM loose_files WHERE id = ?").bind(id).first()).toEqual({ handle: null });
+  });
+
+  it("adds metadata only to this Energon's public content paths", () => {
+    const page = { content_type: "text/html" };
+    for (const url of [
+      "https://hub.energon.example.com/v1/files/Abc123",
+      "https://foreign.example/ada/f/Abc123/page.html",
+      "https://energon.example.com/admin/f/Abc123/page.html",
+      "https://user:secret@energon.example.com/ada/f/Abc123/page.html",
+    ]) expect(reviewLinks(enabled, url, page)).toEqual({});
+    const url = "https://energon.example.com/ada/s/Abc123/site/page.html?variant=a#details";
+    const links = reviewLinks(enabled, url, page);
+    expect(links.review_url).toBe("https://energon.example.com/ada/s/Abc123/site/page.html?variant=a&comments=1#details");
+  });
+});
