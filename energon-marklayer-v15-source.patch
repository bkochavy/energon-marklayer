+++ b/src/ui/comment-links.ts
@@ -0,0 +1,21 @@
+/** The server supplies review_url only for a page that supports comments. */
+export type CommentLinkSource = {
+  url: string;
+  review_url?: string;
+  new_review_url?: string;
+  link_access?: 'public' | 'private';
+  password_protected?: boolean;
+  password?: string;
+};
+
+export function commentLinks(source: CommentLinkSource): { review: string; fresh: string } | null {
+  if (!source.review_url || source.link_access === 'private' || source.password_protected || source.password) return null;
+  try {
+    const clean = new URL(source.url);
+    const review = new URL(source.review_url);
+    if (!['https:', 'http:'].includes(review.protocol) || review.origin !== clean.origin) return null;
+    const fresh = new URL(review);
+    fresh.searchParams.set('comments', 'new');
+    return { review: review.href, fresh: fresh.href };
+  } catch { return null; }
+}
