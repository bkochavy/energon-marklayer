@@ -0,0 +1,191 @@
+import { createExecutionContext, env, waitOnExecutionContext } from "cloudflare:test";
+import { decodeJwt, SignJWT } from "jose";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import worker from "../src/index";
+import { bootstrapCommentIdentity, COMMENT_IDENTITY_PATH, purgeCommentIdentities, type CommentIdentity } from "../src/comments/identity";
+import { resolveCommentTarget } from "../src/comments/target";
+import { ensureSchema } from "../src/db";
+import type { Env } from "../src/types";
+import type { CommentTarget } from "../src/comments/types";
+import { auth, createSite, json, mint } from "./helpers";
+
+const enabled = { ...env, COMMENTS_ENABLED: "true", COMMENTS_IDENTITY_SECRET: "test-only-comment-identity-signing-key-32-bytes" } as Env;
+const origin = "https://energon.example.com";
+const endpoint = `${origin}${COMMENT_IDENTITY_PATH}`;
+const target = (ownerId: string): CommentTarget => ({ key: `site:${ownerId}`, kind: "site", id: ownerId, path: "index.html",
+  url: `${origin}/ada/s/ABCDEF/review/`, canonicalUrl: `${origin}/ada/s/ABCDEF/review/`, title: "Review", ownerId, contentGeneration: 1 });
+afterEach(() => vi.restoreAllMocks());
+beforeEach(async () => {
+  await ensureSchema(env.DB);
+  for (const id of ["owner-a", "owner-b", "publisher-a", "publisher-b"]) {
+    await env.DB.prepare("INSERT OR IGNORE INTO users (id, email, handle, created_at) VALUES (?, ?, ?, ?)")
+      .bind(id, `${id}@esperlabs.app`, id, new Date().toISOString()).run();
+  }
+});
+
+async function run(url: string, init?: RequestInit, bindings = enabled) {
+  const ctx = createExecutionContext();
+  const result = await worker.fetch(new Request(url, init), bindings, ctx);
+  await waitOnExecutionContext(ctx);
+  return result;
+}
+async function boot(cookie?: string, ownerId = "owner-a", bindings = enabled) {
+  await ensureSchema(bindings.DB);
+  const headers = new Headers();
+  const identity = await bootstrapCommentIdentity(bindings, new Request(target(ownerId).url, { headers: cookie ? { cookie } : {} }), target(ownerId), headers);
+  return { identity: identity!, cookie: headers.get("set-cookie")?.split(";", 1)[0] ?? cookie!, headers };
+}
+const write = (identity: CommentIdentity, name?: string, method = "POST", bindings = enabled) => run(endpoint, {
+  method, headers: { authorization: `Bearer ${identity.capability}`, "content-type": "application/json", origin: "null" },
+  ...(method === "POST" ? { body: JSON.stringify({ name }) } : {}),
+}, bindings);
+async function updated(identity: CommentIdentity, name: string) {
+  const r = await write(identity, name); expect(r.status).toBe(200);
+  return { ...identity, ...await r.json() as { name: string; capability: string } };
+}
+
+describe("native reviewer preference transport", () => {
+  it("bootstraps without writing, keeps the cookie out of native identity and remembers a committed name across company publishers", async () => {
+    const first = await boot();
+    expect(first.headers.get("set-cookie")).toMatch(/^__Host-energon-reviewer=.+; Path=\/; Max-Age=7776000; HttpOnly; SameSite=Lax; Secure$/);
+    const claims = decodeJwt(first.identity.capability);
+    expect(first.identity.id).not.toBe(claims.sub);
+    expect(first.identity.capability).not.toContain(first.cookie.split("=")[1]);
+    expect(await env.DB.prepare("SELECT id FROM comment_identities WHERE id = ?").bind(claims.sub).first()).toBeNull();
+    await updated(first.identity, "  Reviewer One  ");
+    const second = await boot(first.cookie, "owner-b");
+    expect(second.identity.id).toBe(first.identity.id);
+    expect(second.identity.name).toBe("Reviewer One");
+    expect(second.headers.has("set-cookie")).toBe(false);
+    const otherBrowser = await boot(undefined, "owner-b");
+    expect(otherBrowser.identity.name).toBeNull(); expect(otherBrowser.identity.id).not.toBe(first.identity.id);
+  });
+
+  it("keeps open installations and owner-policy installations isolated by publisher", async () => {
+    for (const bindings of [{ ...enabled, ALLOWED_EMAIL_DOMAINS: "" }, { ...enabled, WRITE_POLICY: "owner" }]) {
+      const a = await boot(undefined, "publisher-a", bindings);
+      expect((await write(a.identity, "Private Preference", "POST", bindings)).status).toBe(200);
+      const b = await boot(a.cookie, "publisher-b", bindings);
+      expect(b.identity.id).not.toBe(a.identity.id); expect(b.identity.name).toBeNull();
+    }
+  });
+
+  it("isolates still-public legacy pages whose publisher is outside the current company boundary", async () => {
+    const token = await mint(`former-publisher-${crypto.randomUUID()}`, "former@esperlabs.ai");
+    const site = await createSite(token, `former-publisher-${crypto.randomUUID().slice(0, 8)}`);
+    expect((await json(`/v1/sites/${site.id}/files/index.html`, { method: "PUT",
+      headers: auth(token, { "content-type": "text/html" }), body: "<!doctype html><title>Still public</title>" })).status).toBe(201);
+    const restricted = { ...enabled, ALLOWED_EMAIL_DOMAINS: "esperlabs.app" };
+    const first = await boot(undefined, "owner-a", restricted);
+    expect((await write(first.identity, "Company reviewer", "POST", restricted)).status).toBe(200);
+    const oldTarget = await resolveCommentTarget(restricted, site.url);
+    const outside = await bootstrapCommentIdentity(restricted, new Request(site.url, { headers: { cookie: first.cookie } }), oldTarget, new Headers());
+    expect(outside!.name).toBeNull(); expect(outside!.id).not.toBe(first.identity.id);
+    expect((await write(outside!, "Outside-page name", "POST", restricted)).status).toBe(200);
+    expect((await boot(first.cookie, "owner-b", restricted)).identity.name).toBe("Company reviewer");
+    const unknown = await boot(first.cookie, "unproven-owner", restricted);
+    expect(unknown.identity.name).toBeNull(); expect(unknown.identity.id).not.toBe(first.identity.id);
+  });
+
+  it("makes explicit Forget from an older tab win and rejects both initial and later stale saves", async () => {
+    const first = await boot();
+    const saved = await updated(first.identity, "Alice");
+    expect((await write(first.identity, "Late first write")).status).toBe(409);
+    const newer = await updated(saved, "Alicia");
+    const forget = await write(saved, undefined, "DELETE");
+    expect(forget.status).toBe(200);
+    const forgotten = { ...saved, ...await forget.json() as { name: null; capability: string } };
+    expect(forgotten.name).toBeNull();
+    expect((await write(newer, "Stale tab name")).status).toBe(409);
+    expect((await boot(first.cookie)).identity.name).toBeNull();
+    expect((await updated(forgotten, "New explicit name")).name).toBe("New explicit name");
+  });
+
+  it("allows only one concurrent first save and preserves the document token deadline", async () => {
+    const first = await boot();
+    const responses = await Promise.all([write(first.identity, "One"), write(first.identity, "Two")]);
+    expect(responses.map(r => r.status).sort()).toEqual([200, 409]);
+    const body = await responses.find(r => r.status === 200)!.json() as { capability: string };
+    expect(decodeJwt(body.capability).exp).toBe(decodeJwt(first.identity.capability).exp);
+  });
+
+  it("rejects expired, tampered, wrong-purpose and wrong-audience capabilities and does not authenticate by cookie or opaque origin", async () => {
+    const first = await boot();
+    const claims = decodeJwt(first.identity.capability);
+    const sign = (overrides: Record<string, unknown>) => new SignJWT({ ...claims, ...overrides })
+      .setProtectedHeader({ alg: "HS256", typ: "JWT" }).sign(new TextEncoder().encode(enabled.COMMENTS_IDENTITY_SECRET));
+    for (const token of [await sign({ exp: Math.floor(Date.now() / 1000) - 1 }), await sign({ purpose: "account" }),
+      await sign({ aud: "https://wrong.example/comments/identity" }), first.identity.capability + "x"]) {
+      expect((await write({ ...first.identity, capability: token }, "No")).status).toBe(401);
+    }
+    const noToken = await run(endpoint, { method: "DELETE", headers: { origin: "null", cookie: first.cookie } });
+    expect(noToken.status).toBe(401); expect(noToken.headers.get("cache-control")).toBe("private, no-store");
+    expect(noToken.headers.get("access-control-allow-origin")).toBe("*");
+    expect(noToken.headers.has("access-control-allow-credentials")).toBe(false);
+    expect((await run(endpoint, { method: "OPTIONS", headers: { origin: "null" } })).status).toBe(204);
+    expect((await run("https://hub.energon.example.com/comments/identity", { method: "DELETE", headers: { authorization: `Bearer ${first.identity.capability}` } })).status).toBe(404);
+  });
+
+  it("validates bounded names and bodies before durable state exists", async () => {
+    const first = await boot();
+    for (const name of ["", "   ", "x".repeat(25), "line\nbreak"]) expect((await write(first.identity, name)).status).toBe(400);
+    expect((await run(endpoint, { method: "POST", headers: { authorization: `Bearer ${first.identity.capability}`, "content-type": "application/json" }, body: "x".repeat(1025) })).status).toBe(413);
+    expect(await env.DB.prepare("SELECT id FROM comment_identities WHERE id = ?").bind(decodeJwt(first.identity.capability).sub).first()).toBeNull();
+  });
+
+  it("does not restore an expired preference and cannot reinsert a forgotten or expired row through an old revision", async () => {
+    const first = await boot();
+    const saved = await updated(first.identity, "Expired");
+    await env.DB.prepare("UPDATE comment_identities SET expires_at = ? WHERE id = ?")
+      .bind(Math.floor(Date.now() / 1000) + 1, decodeJwt(saved.capability).sub).run();
+    const justBeforeExpiry = (await boot(first.cookie)).identity;
+    await env.DB.prepare("UPDATE comment_identities SET expires_at = ? WHERE id = ?").bind(1, decodeJwt(saved.capability).sub).run();
+    expect((await boot(first.cookie)).identity.name).toBeNull();
+    await purgeCommentIdentities(enabled);
+    expect((await write(saved, "Resurrect")).status).toBe(409);
+    const fresh = await boot(first.cookie);
+    expect((await updated(fresh.identity, "Explicit new choice")).name).toBe("Explicit new choice");
+    // The old row and the recreated row must not share a revision (the ABA case).
+    expect((await write(justBeforeExpiry, "Stale recreated name")).status).toBe(409);
+    expect((await boot(first.cookie)).identity.name).toBe("Explicit new choice");
+  });
+
+  it("keeps ordinary commenting available when preference memory is disabled", async () => {
+    expect((await boot(undefined, "owner-a", { ...enabled, COMMENTS_IDENTITY_SECRET: undefined })).identity).toBeNull();
+    expect((await run(endpoint, { method: "OPTIONS" }, { ...enabled, COMMENTS_IDENTITY_SECRET: undefined })).status).toBe(404);
+  });
+
+  it("decorates only final eligible review documents, safely encodes names and never contaminates clean/cache responses", async () => {
+    const token = await mint(`identity-${crypto.randomUUID()}`);
+    const site = await createSite(token, `identity-${crypto.randomUUID().slice(0, 8)}`);
+    const html = "<!doctype html><title>Identity test</title><h1>Untouched</h1>";
+    expect((await json(`/v1/sites/${site.id}/files/index.html`, { method: "PUT", headers: auth(token, { "content-type": "text/html" }), body: html })).status).toBe(201);
+    vi.spyOn(globalThis, "fetch").mockImplementation(async (input, init) => {
+      const id = new URL(String(input)).pathname.split("/")[2];
+      return Response.json(init?.method === "POST" ? { id } : { url: site.url, ops: [] });
+    });
+    const redirect = await run(`${site.url}?comments=1`);
+    expect(redirect.status).toBe(302); expect(redirect.headers.has("set-cookie")).toBe(false);
+    const review = redirect.headers.get("location")!;
+    const page = await run(review);
+    expect(page.status).toBe(200);
+    const cookie = page.headers.get("set-cookie")!.split(";", 1)[0];
+    const firstText = await page.text();
+    const encoded = /data-identity="([^"]+)"/.exec(firstText)![1];
+    const identity = JSON.parse(encoded.replaceAll("&quot;", '"').replaceAll("&#39;", "'").replaceAll("&lt;", "<").replaceAll("&gt;", ">").replaceAll("&amp;", "&")) as CommentIdentity;
+    const name = '"><script>bad</script>';
+    await updated(identity, name);
+    const next = await run(review, { headers: { cookie, "if-none-match": '"old"', "if-modified-since": "Tue, 01 Jan 2030 00:00:00 GMT" } });
+    expect(next.status).toBe(200); expect(next.headers.get("cache-control")).toBe("private, no-store");
+    expect(next.headers.has("etag")).toBe(false); expect(next.headers.has("last-modified")).toBe(false);
+    expect(next.headers.get("content-security-policy")).not.toContain("allow-same-origin");
+    const text = await next.text(); expect(text).not.toContain(name); expect(text).toContain("&lt;script&gt;");
+    const clean = await run(site.url, { headers: { cookie } });
+    expect(await clean.text()).toBe(html); expect(clean.headers.has("set-cookie")).toBe(false);
+    const other = await run(review); expect(await other.text()).not.toContain("&lt;script&gt;");
+    const disabled = await run(review, undefined, { ...enabled, COMMENTS_IDENTITY_SECRET: undefined });
+    const disabledText = await disabled.text();
+    expect(disabledText).toContain('data-energon-comments="1"'); expect(disabledText).not.toContain("data-identity");
+    expect(disabled.headers.has("set-cookie")).toBe(false);
+  });
+});
