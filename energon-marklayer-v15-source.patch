+diff --git a/apps/extension/widget/useFeedbackFlow.ts b/apps/extension/widget/useFeedbackFlow.ts
+new file mode 100644
+index 0000000000000000000000000000000000000000..dd761ac501e411ed08c62d51b300dd81218bbe46
+--- /dev/null
++++ b/apps/extension/widget/useFeedbackFlow.ts
+@@ -0,0 +1,125 @@
++/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
++import { useCallback, useEffect, useRef, useState } from 'preact/hooks';
++import { editableTarget } from '../lib/dom';
++import { bindKeymap } from '../lib/keymap';
++import { overlayHost } from '../lib/overlay-mount';
++import { activeTool, selectTool } from '../lib/tool-state';
++import { TOOL_SHORTCUTS } from '../lib/tools';
++import { copyReviewLink } from './copy-review-link';
++import { reviewPanelOpen } from './review-state';
++
++/** Transitions for the selected review bar; annotation state stays in the native layers. */
++export function useFeedbackFlow() {
++  const [pinOpen, setPinOpen] = useState(false);
++  const [textOpen, setTextOpen] = useState(false);
++  const pinCancel = useRef<(() => void) | null>(null);
++  const textCancel = useRef<(() => void) | null>(null);
++  const [confirmation, setConfirmation] = useState(false);
++  const successTimer = useRef<ReturnType<typeof setTimeout>>();
++  useEffect(() => () => clearTimeout(successTimer.current), []);
++
++  const focusControls = useCallback(() => {
++    const focus = () => {
++      overlayHost()?.shadowRoot?.querySelector<HTMLElement>('[data-feedback-focus]')?.focus({ preventScroll: true });
++    };
++    focus();
++    requestAnimationFrame(focus);
++  }, []);
++
++  const cancel = useCallback(() => {
++    const dismiss = textCancel.current ?? pinCancel.current;
++    if (dismiss) return dismiss();
++    activeTool.value = 'navigate';
++    reviewPanelOpen.value = false;
++    setConfirmation(false);
++    clearTimeout(successTimer.current);
++    window.getSelection()?.removeAllRanges();
++    focusControls();
++  }, [focusControls]);
++
++  const comment = useCallback(() => {
++    clearTimeout(successTimer.current);
++    setConfirmation(false);
++    reviewPanelOpen.value = false;
++    selectTool({ tool: 'comment', via: 'toolbar' });
++  }, []);
++
++  const submitted = useCallback(() => {
++    activeTool.value = 'navigate';
++    setConfirmation(true);
++    clearTimeout(successTimer.current);
++    successTimer.current = setTimeout(() => setConfirmation(false), 1600);
++  }, []);
++
++  const composerClosed = useCallback(() => {
++    activeTool.value = 'navigate';
++    focusControls();
++  }, [focusControls]);
++
++  const showThreads = useCallback(() => {
++    activeTool.value = 'navigate';
++    reviewPanelOpen.value = !reviewPanelOpen.value;
++    if (!reviewPanelOpen.value) focusControls();
++  }, [focusControls]);
++
++  useEffect(
++    () =>
++      bindKeymap({
++        scope: window,
++        bindings: [
++          ...[...TOOL_SHORTCUTS, { tool: 'navigate' as const, pattern: 'KeyB' }]
++            .filter(({ tool }) => ['comment', 'selection', 'navigate'].includes(tool))
++            .map(({ tool, pattern }) => ({
++              keys: pattern,
++              on: (e: KeyboardEvent) => {
++                if (e.defaultPrevented || e.isComposing || editableTarget(e)) return;
++                e.preventDefault();
++                if (tool === 'comment') return comment();
++                if (tool === 'navigate') return cancel();
++                reviewPanelOpen.value = false;
++                selectTool({ tool, via: 'shortcut' });
++              },
++            })),
++          {
++            keys: 'KeyL',
++            on: (e: KeyboardEvent) => {
++              if (e.defaultPrevented || e.isComposing || e.repeat || editableTarget(e)) return;
++              if (copyReviewLink()) e.preventDefault();
++            },
++          },
++          {
++            keys: 'KeyT',
++            on: (e: KeyboardEvent) => {
++              if (e.isComposing || e.repeat || editableTarget(e) || pinOpen || textOpen) return;
++              e.preventDefault();
++              showThreads();
++            },
++          },
++          {
++            keys: 'Escape',
++            on: (e: KeyboardEvent) => {
++              if (e.defaultPrevented || e.isComposing || editableTarget(e)) return;
++              cancel();
++            },
++          },
++        ],
++      }),
++    [pinOpen, textOpen, comment, cancel, showThreads],
++  );
++
++  return {
++    pinOpen,
++    setPinOpen,
++    textOpen,
++    setTextOpen,
++    pinCancel,
++    textCancel,
++    confirmation,
++    focusControls,
++    cancel,
++    comment,
++    submitted,
++    composerClosed,
++    showThreads,
++  };
++}
