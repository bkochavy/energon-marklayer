+diff --git a/apps/extension/lib/view-context.ts b/apps/extension/lib/view-context.ts
+new file mode 100644
+index 0000000000000000000000000000000000000000..990f07267a04b6d075f80fe32d85ed78c96fb75f
+--- /dev/null
++++ b/apps/extension/lib/view-context.ts
+@@ -0,0 +1,30 @@
++/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
++import type { CaptureViewport, DeviceMode } from '@marklayer/types/ops';
++
++export interface ViewContext {
++  device?: DeviceMode;
++  captureViewport?: CaptureViewport;
++  meta?: { viewport?: CaptureViewport };
++}
++
++/** Embed layout bands, not hardware detection or the full viewer's fixed frame sizes. */
++export function deviceForWidth(width: number): DeviceMode {
++  return width < 768 ? 'mobile' : width < 1024 ? 'tablet' : 'desktop';
++}
++
++export function captureView() {
++  const captureViewport = { width: window.innerWidth, height: window.innerHeight };
++  return { captureViewport, device: deviceForWidth(captureViewport.width) };
++}
++
++export function viewContext(op: ViewContext) {
++  const saved = op.captureViewport ?? op.meta?.viewport;
++  const viewport = saved && Number.isFinite(saved.width) && saved.width > 0 ? saved : undefined;
++  const device = op.device ?? (viewport ? deviceForWidth(viewport.width) : undefined);
++  return { device, viewport, inferred: !op.device && Boolean(device) };
++}
++
++export function matchesView({ op, view }: { op: ViewContext; view?: DeviceMode }): boolean {
++  const { device } = viewContext(op);
++  return !view || !device || device === view;
++}
