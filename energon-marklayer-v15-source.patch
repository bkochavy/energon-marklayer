+    <form id="comments-new-form" method="post" action="/account/comments/new" onsubmit={submit} aria-busy={submitting}>
+      <input type="hidden" name="url" value={data.url} />
+      <input type="hidden" name="idempotency_key" value={data.idempotency_key} />
+      <h1 id="new-review-title">Start a fresh review?</h1>
+      <p class="review-page">{data.title}</p>
+      <p id="new-review-description">Existing feedback stays in the previous review. This becomes the page’s current review.</p>
+      <div class="review-actions">
+        <a href={returnUrl} class="review-cancel" aria-disabled={submitting} onclick={cancel}>Cancel</a>
+        <button id="comments-new-submit" type="submit" disabled={submitting}>{submitting ? 'Starting…' : 'Start a new review'}</button>
+      </div>
+    </form>
+  </dialog>
+</main>
