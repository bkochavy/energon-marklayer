@@ -0,0 +1,16 @@
+/** Durable completion receipts for one-time runtime upgrades, not D1 migrations. */
+export async function bootstrapComplete(db: D1Database, name: string): Promise<boolean> {
+  try {
+    return !!await db.prepare("SELECT name FROM bootstrap_state WHERE name = ?").bind(name).first();
+  } catch (error) {
+    // Fresh and pre-0027 databases bootstrap themselves. Other errors must fail
+    // closed rather than being mistaken for an unfinished upgrade.
+    if (error instanceof Error && /no such table: bootstrap_state\b/.test(error.message)) return false;
+    throw error;
+  }
+}
+
+export async function completeBootstrap(db: D1Database, name: string): Promise<void> {
+  await db.prepare("INSERT OR IGNORE INTO bootstrap_state (name, completed_at) VALUES (?, ?)")
+    .bind(name, new Date().toISOString()).run();
+}
