+import type { Env } from "../types";
+
+/** Versioned, pinned frontend; hosted MarkLayer supplies only room data and synchronization. */
+export const COMMENT_WIDGET_PATH = "/static/comments/v15/widget.js";
+export function isCommentAssetPath(path: string): boolean { return path.startsWith("/static/comments/"); }
+
+export async function serveCommentAsset(env: Env, request: Request): Promise<Response> {
+  const asset = await env.ASSETS.fetch(request);
+  const headers = new Headers(asset.headers);
+  headers.set("access-control-allow-origin", "*");
+  headers.set("x-content-type-options", "nosniff");
+  if (asset.ok) headers.set("cache-control", "public, max-age=31536000, immutable");
+  return new Response(asset.body, { status: asset.status, headers });
+}
