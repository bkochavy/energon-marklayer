index 0000000000000000000000000000000000000000..c583db63b9c359112f5590a450ce02bff6bf73be
--- /dev/null
+++ b/test/legacy-ownership.spec.ts
@@ -0,0 +1,95 @@
+import { env } from "cloudflare:test";
+import { expect, it } from "vitest";
+import { ensureSchema } from "../src/db";
+import { ensureUser } from "../src/handles";
+import { canSetWritePolicy } from "../src/policy";
+import type { Actor, Env } from "../src/types";
+
+const email = "legacy@esperlabs.app";
+
+async function legacyDatabase() {
+  const names = ["bootstrap_state", "sites", "site_files", "loose_files", "tokens", "users", "handle_reservations", "agent_connections", "admin_audit", "upload_grants", "gate_attempts", "platform_quota", "site_versions", "site_version_files", "site_deployments", "site_operation_leases", "storage_allocations", "site_conversions", "site_version_files_insert_guard", "site_version_files_update_guard", "site_version_files_delete_guard", "site_deployments_intent_guard", "reject_attachment"];
+  const prefix = `ownership_${crypto.randomUUID().replaceAll("-", "")}_`;
+  const executed: string[] = [];
+  const rewrite = (sql: string) => sql.replace(new RegExp(`\\b(${names.join("|")}|idx_\\w+)\\b`, "g"), name => prefix + name);
+  const binding = () => ({
+    prepare: (sql: string) => { executed.push(sql); return env.DB.prepare(rewrite(sql)); },
+    batch: env.DB.batch.bind(env.DB),
+  }) as D1Database;
+  const db = binding();
+  // The wrapper prefixes table names; pre-create the empty receipt table so
+  // the production missing-table check need not recognize test-only names.
+  await db.prepare(`CREATE TABLE bootstrap_state (name TEXT PRIMARY KEY, completed_at TEXT NOT NULL)`).run();
+  await db.prepare(`CREATE TABLE sites (handle TEXT, slug TEXT, created_at TEXT, updated_at TEXT, created_by TEXT, last_written_by TEXT, password_hash TEXT, PRIMARY KEY(handle, slug))`).run();
+  await db.prepare(`CREATE TABLE site_files (handle TEXT, slug TEXT, path TEXT, size INTEGER, content_type TEXT, updated_at TEXT, last_written_by TEXT, PRIMARY KEY(handle, slug, path))`).run();
+  await db.prepare(`CREATE TABLE loose_files (id TEXT PRIMARY KEY, filename TEXT, size INTEGER, content_type TEXT, created_at TEXT, created_by TEXT, handle TEXT)`).run();
+  await db.prepare(`CREATE TABLE tokens (id TEXT PRIMARY KEY, user_email TEXT, label TEXT, token_hash TEXT, token_secret TEXT, created_at TEXT, last_used_at TEXT, revoked_at TEXT)`).run();
+  await db.prepare(`INSERT INTO sites VALUES ('legacy', 'page', '2026-01-01', '2026-01-01', ?, ?, NULL)`).bind(email, email).run();
+  await db.prepare(`INSERT INTO loose_files VALUES ('old-file', 'hello.txt', 1, 'text/plain', '2026-01-01', ?, 'legacy')`).bind(email).run();
+  await db.prepare(`INSERT INTO tokens VALUES ('old-token', ?, 'old', 'hash', NULL, '2026-01-01', NULL, NULL)`).bind(email).run();
+  await ensureSchema(db);
+  const app = { ...env, DB: db } as Env;
+  const owners = async () => ({
+    site: await db.prepare(`SELECT owner_id FROM sites WHERE slug = 'page'`).first<string>("owner_id"),
+    file: await db.prepare(`SELECT owner_id FROM loose_files WHERE id = 'old-file'`).first<string>("owner_id"),
+    token: await db.prepare(`SELECT user_id FROM tokens WHERE id = 'old-token'`).first<string>("user_id"),
+  });
+  expect(await owners()).toEqual({ site: null, file: null, token: null });
+  return { app, db, binding, executed, owners };
+}
+
+it("attaches all deferred ownership at first login after schema completion without repeating bootstrap", async () => {
+  const { app, db, binding, executed, owners } = await legacyDatabase();
+  const receipts = await db.prepare(`SELECT * FROM bootstrap_state`).all();
+  const user = await ensureUser(app, email, "legacy-sub");
+  expect(await owners()).toEqual({ site: user.id, file: user.id, token: user.id });
+  expect(canSetWritePolicy({ email, userId: user.id } as Actor, email, user.id)).toBe(true);
+  executed.length = 0;
+  await ensureSchema(binding());
+  expect(executed).toHaveLength(1);
+  expect(executed[0]).toContain("FROM bootstrap_state");
+  expect(await db.prepare(`SELECT * FROM bootstrap_state`).all()).toMatchObject({ results: receipts.results });
+  expect(await db.prepare(`SELECT handle FROM sites`).first("handle")).toBe("legacy");
+});
+
+it("repairs a user created during the regression and preserves other identities and assigned owners", async () => {
+  const { app, db, owners } = await legacyDatabase();
+  await db.prepare(`INSERT INTO users (id, email, handle, created_at) VALUES ('existing', ?, 'existing', '2026-01-01')`).bind(email).run();
+  await db.prepare(`UPDATE sites SET owner_id = 'other-owner'`).run();
+  await db.prepare(`UPDATE loose_files SET owner_id = ''`).run();
+  await db.prepare(`INSERT INTO tokens (id, user_email, user_id) VALUES ('other-token', 'other@esperlabs.app', NULL)`).run();
