@@ -0,0 +1,30 @@
+import { describe, expect, it } from 'vitest';
+import { commentLinks } from './comment-links';
+
+const page = 'https://share.example.com/ben/s/Abc123/site/page.html?variant=b#pricing';
+
+describe('comments link actions', () => {
+  it('keeps clean URLs unchanged and preserves page parameters and fragments for new rounds', () => {
+    const source = { url: page, review_url: page.replace('#pricing', '&comments=room_123#pricing') };
+    const links = commentLinks(source)!;
+    expect(source.url).toBe(page);
+    expect(links.review).toBe(source.review_url);
+    const fresh = new URL(links.fresh);
+    expect(fresh.searchParams.get('variant')).toBe('b');
+    expect(fresh.searchParams.getAll('comments')).toEqual(['new']);
+    expect(fresh.hash).toBe('#pricing');
+  });
+
+  it('requires server eligibility rather than inferring support from an HTML filename', () => {
+    expect(commentLinks({ url: page })).toBeNull();
+    expect(commentLinks({ url: page, review_url: page + '?comments=1', link_access: 'private' })).toBeNull();
+    expect(commentLinks({ url: page, review_url: page + '?comments=1', password_protected: true })).toBeNull();
+    expect(commentLinks({ url: page, review_url: page + '?comments=1', password: 'shared-phrase' })).toBeNull();
+  });
+
+  it('does not turn malformed or foreign discovery data into navigation', () => {
+    expect(commentLinks({ url: page, review_url: 'not a URL' })).toBeNull();
+    expect(commentLinks({ url: page, review_url: 'javascript:alert(1)' })).toBeNull();
+    expect(commentLinks({ url: page, review_url: 'https://elsewhere.example/page?comments=1' })).toBeNull();
+  });
+});
