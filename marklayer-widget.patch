+
+/** The selected centered edge tuck leaves native controls mounted. */
+export function BrowseVisibility({
+  enabled,
+  onReveal,
+  children,
+}: {
+  enabled: boolean;
+  onReveal: () => void;
+  children: ComponentChildren;
+}) {
+  const { root, retreated, reveal, revealAndFocus } = useBrowseVisibility(enabled, onReveal);
+  return (
+    <div ref={root} class="ml-browse-visibility" data-retreated={retreated} onFocusCapture={reveal}>
+      {children}
+      <button
+        type="button"
+        class="ml-browse-return"
+        aria-label="Show feedback controls"
+        aria-expanded={!retreated}
+        tabIndex={retreated ? 0 : -1}
+        onClick={revealAndFocus}
+        onFocus={revealAndFocus}
+      >
+        <ChevronUp size={13} /> Feedback
+      </button>
+    </div>
+  );
+}
