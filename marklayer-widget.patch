@@ -0,0 +1,222 @@
+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { type DeviceMode, isClosed, opAnchor } from '@marklayer/types/ops';
+import { cn } from '@marklayer/ui/cn';
+import { ArrowLeft, MessageCircle, TextSelect, X } from 'lucide-preact';
+import { useEffect, useRef, useState } from 'preact/hooks';
+import { CommentMedia } from '../components/CommentMedia';
+import { MentionText } from '../components/MentionText';
+import { SuggestionDiff } from '../components/SelectionEdit';
+import { ReplyComposer, ThreadHeader, ThreadReplies } from '../components/ThreadCard';
+import { applyAnchorDelta, reprojectRects } from '../lib/anchor';
+import { editableTarget } from '../lib/dom';
+import { geist } from '../lib/geist';
+import { glass } from '../lib/glass';
+import { getReplies, rootComments, selections } from '../lib/ops';
+import { scrollPageTo } from '../lib/scroller';
+import { fileUrl, uploadFile } from '../lib/share';
+import { getCommentStatus, STATUS_LABELS } from '../lib/status-ui';
+import { timeAgo } from '../lib/time';
+import type { CommentOp, SelectionOp } from '../lib/types';
+
+import { matchesView, viewContext } from '../lib/view-context';
+
+import { CopyReviewLink } from './CopyReviewLink';
+import { reviewPanelOpen } from './review-state';
+
+type Thread = CommentOp | SelectionOp;
+const body = (op: Thread) => (op.tool === 'selection' ? op.comment || 'Highlighted text' : op.text || 'Attachment');
+const label = (op: Thread) => (op.tool === 'selection' ? 'Text comment' : `Pin ${op.num}`);
+const DEVICE_LABELS = { mobile: 'Mobile', tablet: 'Tablet', desktop: 'Desktop' };
+
+function ViewBadge({ op }: { op: Thread }) {
+  const { device, viewport, inferred } = viewContext(op);
+  return (
+    <span class="ml-review-meta ml-review-view">
+      <span class="ml-review-view-badge">
+        {device ? DEVICE_LABELS[device] : 'Unknown view'}
+        {inferred ? ' (inferred)' : ''}
+      </span>
+      {viewport && (
+        <span>
+          {Math.round(viewport.width)} × {Math.round(viewport.height)}
+        </span>
+      )}
+    </span>
+  );
+}
+
+function locate(op: Thread) {
+  const at = opAnchor(op);
+  const point =
+    op.tool === 'selection'
+      ? (reprojectRects({ target: op.target, rects: op.rects }) ?? at)
+      : applyAnchorDelta(op.target, { docX: at.x, docY: at.y });
+  scrollPageTo(window, { top: Math.max(0, point.y - 100), behavior: 'smooth' });
+}
+
+export const REVIEW_PANEL_CSS = `
+.ml-review-button { display:inline-flex; justify-content:center; align-items:center; gap:8px; height:38px; min-width:38px; border:0; border-radius:8px; padding:0 10px; background:transparent; color:var(--ds-gray-900); cursor:pointer; font:inherit; font-size:13px; font-weight:500; white-space:nowrap; }
+.ml-review-button:hover { background:var(--ds-gray-alpha-100); color:var(--ds-gray-1000); }
+.ml-review-button[aria-pressed="true"] { background:var(--ds-gray-1000); color:var(--ds-background-100); }
+.ml-review-button:focus-visible,.ml-review-row:focus-visible { outline:2px solid var(--ds-focus-color,#0070f7); outline-offset:2px; }
+.ml-review-count { font-variant-numeric:tabular-nums; opacity:.65; }
+.ml-review-panel { position:fixed; right:16px; top:16px; bottom:84px; width:360px; max-width:calc(100vw - 32px); display:flex; flex-direction:column; z-index:2147483647; pointer-events:auto; overflow:hidden; }
+.ml-review-panel-header { display:flex; align-items:center; gap:6px; padding:10px; border-bottom:1px solid var(--ds-gray-alpha-300); flex-shrink:0; }
+.ml-review-panel-title { margin:0; font-size:14px; font-weight:600; flex:1; color:var(--ds-gray-1000); }
+.ml-review-scroll { overflow:auto; overscroll-behavior:contain; min-height:0; flex:1; }
+.ml-review-row { display:block; width:100%; text-align:left; padding:14px; border:0; border-bottom:1px solid var(--ds-gray-alpha-300); background:transparent; color:var(--ds-gray-1000); cursor:pointer; font:inherit; }
+.ml-review-row:hover { background:var(--ds-gray-alpha-100); }
+.ml-review-meta { display:flex; align-items:center; gap:7px; color:var(--ds-gray-800); font-size:11px; line-height:1.5; }
+.ml-review-view { flex-wrap:wrap; margin:7px 0; }
+.ml-review-view-badge { padding:1px 5px; border-radius:4px; background:var(--ds-gray-alpha-100); }
+.ml-review-preview { margin:7px 0; font-size:13px; line-height:1.5; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:3; overflow:hidden; overflow-wrap:anywhere; }
+.ml-review-quote { margin:8px 0 0; padding-left:9px; border-left:2px solid var(--ds-gray-alpha-400); color:var(--ds-gray-900); font-size:12px; line-height:1.5; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; }
+.ml-review-empty { margin:0; padding:28px 20px; color:var(--ds-gray-900); font-size:13px; line-height:1.6; }
+@media(max-width:640px) { .ml-review-panel { top:auto; left:12px; right:12px; width:auto; max-width:none; bottom:calc(env(safe-area-inset-bottom,0px) + 80px); max-height:58dvh; min-height:220px; } .ml-review-button { height:42px; min-width:42px; } }
+`;
+
+/** Shared thread list and detail panel; the host owns its launcher and focus restoration. */
+export function ReviewPanel({ onClose, deviceView }: { onClose?: () => void; deviceView?: DeviceMode }) {
+  const [selectedId, setSelectedId] = useState<string | null>(null);
+  const closeButton = useRef<HTMLButtonElement>(null);
+  const open = reviewPanelOpen.value;
+  const threads: Thread[] = [...rootComments.value, ...selections.value].sort((a, b) => b.ts - a.ts);
+  const selected = threads.find((op) => op.id === selectedId);
+  const close = () => {
+    reviewPanelOpen.value = false;
+    onClose?.();
+  };
+
+  useEffect(() => {
+    if (!open) {
+      setSelectedId(null);
+      return;
+    }
+    closeButton.current?.focus();
+    const onEscape = (e: KeyboardEvent) => {
+      if (e.key !== 'Escape' || editableTarget(e)) return;
+      e.preventDefault();
+      close();
+    };
+    window.addEventListener('keydown', onEscape);
+    return () => window.removeEventListener('keydown', onEscape);
+  }, [open]);
+
+  return (
+    <>
+      {open && (
+        <section
+          role="dialog"
+          aria-label="Page threads"
+          aria-modal="false"
+          class={cn('ml-review-panel', geist.surface, glass.font)}
+        >
+          <header class="ml-review-panel-header">
+            {selected && (
+              <button
+                class="ml-review-button"
+                type="button"
+                aria-label="Back to all threads"
+                onClick={() => setSelectedId(null)}
+              >
+                <ArrowLeft size={16} />
+              </button>
+            )}
+            <h2 class="ml-review-panel-title">
+              {selected ? label(selected) : 'Threads'}
+              {!selected && <span class="ml-review-count"> · {threads.length}</span>}
+            </h2>
+            <CopyReviewLink surface="panel" />
+            <button
+              ref={closeButton}
+              class="ml-review-button"
+              type="button"
+              aria-label="Close threads"
+              title="Close threads · Esc"
+              onClick={close}
+            >
+              <X size={16} />
+            </button>
+          </header>
+          <div class="ml-review-scroll">
+            {selected ? (
+              <div key={selected.id}>
+                <ThreadHeader
+                  label={selected.tool === 'comment' ? String(selected.num) : (selected.author || '?')[0]!}
+                  color={selected.color}
+                  author={selected.author}
+                  authorId={selected.authorId}
+                  ts={selected.ts}
+                  priority={selected.priority}
+                />
+                <div style={{ padding: '0 14px 14px' }}>
+                  <ViewBadge op={selected} />
+                  {!matchesView({ op: selected, view: deviceView }) && (
+                    <p class="ml-review-meta">This comment was left in another view. Its marker is hidden here.</p>
+                  )}
+                  {selected.tool === 'selection' &&
+                    (selected.suggestion ? (
+                      <SuggestionDiff
+                        text={selected.text}
+                        suggestion={selected.suggestion}
+                        resolved={isClosed(getCommentStatus(selected))}
+                      />
+                    ) : (
+                      <blockquote class="ml-review-quote">“{selected.text}”</blockquote>
+                    ))}
+                  <p class="ml-review-preview" style={{ display: 'block', whiteSpace: 'pre-wrap' }}>
+                    <MentionText text={body(selected)} mentions={selected.mentions} />
+                  </p>
+                  {selected.tool === 'comment' && <CommentMedia op={selected} resolveUrl={fileUrl} />}
+                </div>
+                <ThreadReplies replies={getReplies(selected.id)} resolveUrl={fileUrl} />
+                <ReplyComposer
+                  parent={{ id: selected.id, ...opAnchor(selected) }}
+                  upload={uploadFile}
+                  resolveUrl={fileUrl}
+                />
+              </div>
+            ) : threads.length ? (
+              threads.map((op) => {
+                const replies = getReplies(op.id);
+                return (
+                  <button
+                    key={op.id}
+                    type="button"
+                    class="ml-review-row"
+                    onClick={() => {
+                      setSelectedId(op.id);
+                      if (matchesView({ op, view: deviceView })) locate(op);
+                    }}
+                  >
+                    <span class="ml-review-meta">
+                      {op.tool === 'selection' ? <TextSelect size={14} /> : <MessageCircle size={14} />}
+                      <span>{label(op)}</span>
+                      <span style={{ marginLeft: 'auto' }}>{STATUS_LABELS[getCommentStatus(op)]}</span>
+                    </span>
+                    <ViewBadge op={op} />
+                    {op.tool === 'selection' && <span class="ml-review-quote">“{op.text}”</span>}
+                    <span class="ml-review-preview">{body(op)}</span>
+                    <span class="ml-review-meta">
+                      <span>{op.author || 'Anonymous'}</span>
+                      <span>· {timeAgo(op.ts)}</span>
+                      <span style={{ marginLeft: 'auto' }}>
+                        {replies.length
+                          ? `${replies.length} ${replies.length === 1 ? 'reply' : 'replies'}`
+                          : 'View thread'}
+                      </span>
+                    </span>
+                  </button>
+                );
+              })
+            ) : (
+              <p class="ml-review-empty">
+                No comments yet. Click the comment tool to pin feedback, or highlight text on the page.
+              </p>
+            )}
+          </div>
+        </section>
+      )}
+    </>
+  );
+}
