+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { cn } from '@marklayer/ui/cn';
+import { geist } from '../lib/geist';
+import { useCoarsePointer } from '../lib/media';
+import { useEdgeClamp } from '../lib/popover';
+
+/** An explicit invitation to comment, preserving the page selection until chosen. */
+export function SelectionOffer({ anchor, onConfirm }: { anchor: { x: number; y: number }; onConfirm: () => void }) {
+  const touch = useCoarsePointer();
+  const { attach, top, horizontal } = useEdgeClamp<HTMLButtonElement>({
+    top: touch ? window.innerHeight : anchor.y + 8,
+  });
+  return (
+    <button
+      ref={attach}
+      type="button"
+      data-ml-selection-comment
+      class={cn(
+        geist.surfaceSmall,
+        'fixed pointer-events-auto px-3 py-1.5 text-xs font-medium pointer-coarse:min-h-11 pointer-coarse:min-w-25',
+      )}
+      style={{
+        left: touch
+          ? horizontal.left + (horizontal.width - 100) / 2
+          : Math.max(8, Math.min(anchor.x, window.innerWidth - 100)),
+        top,
+        zIndex: 2147483647,
+        cursor: 'pointer',
+      }}
+      onPointerDown={(e) => {
+        e.preventDefault();
+        e.stopPropagation();
+      }}
+      onClick={(e) => {
+        e.stopPropagation();
+        onConfirm();
+      }}
+    >
+      Comment
+    </button>
+  );
+}
