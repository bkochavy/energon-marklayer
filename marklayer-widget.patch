+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { afterEach, expect, mock, test } from 'bun:test';
+import { render } from 'preact';
+import * as compat from 'preact/compat';
+import * as jsxRuntime from 'preact/jsx-runtime';
+import { act } from 'preact/test-utils';
+import { hydrateIdentity } from '../lib/identity';
+import { configureReviewerName, reviewerNameChoice, skipReviewerName } from '../lib/reviewer-name';
+
+const baseUi = Bun.resolveSync('@base-ui/react', import.meta.dir);
+mock.module(Bun.resolveSync('react', baseUi), () => compat);
+mock.module(Bun.resolveSync('react-dom', baseUi), () => compat);
+mock.module(Bun.resolveSync('react/jsx-runtime', baseUi), () => jsxRuntime);
+const { ReviewerNameAction } = await import('./ReviewerNameAction');
+const root = document.createElement('div');
+afterEach(() => {
+  render(null, root);
+  root.remove();
+  hydrateIdentity(undefined);
+  reviewerNameChoice.value = 'disabled';
+});
+async function click(label: string) {
+  await act(() => {
+    const button = [...document.querySelectorAll('button')].find((b) => b.textContent?.trim() === label);
+    if (!button) throw new Error(`Missing ${label}`);
+    button.click();
+  });
+}
+test('Add your name remains after skip, Not now does not persist, explicit Save hides it', async () => {
+  const saved = mock(() => {});
+  hydrateIdentity({ persistDefaults: false, load: () => ({ id: 'reviewer', name: 'Guest' }), save: saved });
+  configureReviewerName(null, () => {});
+  skipReviewerName();
+  document.body.append(root);
+  await act(() => render(<ReviewerNameAction />, root));
+  await click('Add your name');
+  const field = document.querySelector<HTMLInputElement>('input[aria-label="Your name"]');
+  expect(field?.value).toBe('');
+  await click('Not now');
+  expect(saved).not.toHaveBeenCalled();
+  expect(root.textContent).toContain('Add your name');
+  await click('Add your name');
+  await act(() => {
+    const input = document.querySelector<HTMLInputElement>('input[aria-label="Your name"]')!;
+    input.value = 'Alex';
+    input.dispatchEvent(new Event('input', { bubbles: true }));
+  });
+  await click('Save name');
+  await act(async () => {
+    await new Promise((resolve) => setTimeout(resolve, 50));
+  });
+  expect(saved).toHaveBeenCalledTimes(1);
+  expect(reviewerNameChoice.value).toBe('ready');
+  expect(root.textContent).not.toContain('Add your name');
+});
+
+test('Save returns focus to the stable toolbar when no composer is open', async () => {
+  hydrateIdentity({ persistDefaults: false, load: () => ({ id: 'reviewer', name: 'Guest' }), save: () => {} });
+  configureReviewerName(null, () => {});
+  document.body.append(root);
+  await act(() =>
+    render(
+      <>
+        <button type="button" data-feedback-focus>
+          Browse
+        </button>
+        <ReviewerNameAction />
+      </>,
+      root,
+    ),
+  );
+  await click('Add your name');
+  await act(() => {
+    const input = document.querySelector<HTMLInputElement>('input[aria-label="Your name"]')!;
+    input.value = 'Alex';
+    input.dispatchEvent(new Event('input', { bubbles: true }));
+  });
+  await click('Save name');
+  await act(async () => {
+    await new Promise((resolve) => setTimeout(resolve, 50));
+  });
+  expect(document.activeElement).toBe(root.querySelector('[data-feedback-focus]'));
+  expect(root.textContent).not.toContain('Add your name');
+});
