+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { afterEach, expect, spyOn, test } from 'bun:test';
+import { render } from 'preact';
+import { act } from 'preact/test-utils';
+import { activeRoomId } from '../lib/room-id';
+import { toasts } from '../lib/toasts';
+import { activeTool } from '../lib/tool-state';
+import { useFeedbackFlow } from './useFeedbackFlow';
+
+const root = document.createElement('div');
+function Flow() {
+  useFeedbackFlow();
+  return <input aria-label="Draft" />;
+}
+afterEach(() => {
+  render(null, root);
+  root.remove();
+  activeTool.value = 'navigate';
+});
+test('B and V both browse through the native keymap but do not steal typing', async () => {
+  document.body.append(root);
+  await act(() => render(<Flow />, root));
+  for (const key of ['b', 'v']) {
+    activeTool.value = 'comment';
+    await act(() => {
+      window.dispatchEvent(new KeyboardEvent('keydown', { key, code: `Key${key.toUpperCase()}`, bubbles: true }));
+    });
+    expect(String(activeTool.value)).toBe('navigate');
+  }
+  activeTool.value = 'comment';
+  await act(() => {
+    root.querySelector('input')!.dispatchEvent(new KeyboardEvent('keydown', { key: 'b', code: 'KeyB', bubbles: true }));
+  });
+  expect(activeTool.value).toBe('comment');
+});
+
+test('L copies the current published page and concrete active room through the native clipboard path', async () => {
+  document.body.append(root);
+  const originalUrl = location.href;
+  history.replaceState(null, '', '/review/?feedback=1&variant=b#section');
+  activeRoomId.value = 'actual-room';
+  const write = spyOn(navigator.clipboard, 'writeText').mockResolvedValue(undefined);
+  try {
+    await act(() => render(<Flow />, root));
+    const press = async (init: KeyboardEventInit = {}, target: EventTarget = window) => {
+      await act(async () => {
+        target.dispatchEvent(
+          new KeyboardEvent('keydown', { key: 'l', code: 'KeyL', bubbles: true, cancelable: true, ...init }),
+        );
+        await Promise.resolve();
+      });
+    };
+    await press();
+    expect(write).toHaveBeenCalledTimes(1);
+    expect(write).toHaveBeenCalledWith('https://example.com/review/?variant=b&comments=actual-room#section');
+    expect(toasts.value.at(-1)?.message).toBe('Review link copied');
+    await press({ repeat: true });
+    await press({ isComposing: true });
+    await press({ ctrlKey: true });
+    await press({ metaKey: true });
+    await press({}, root.querySelector('input')!);
+    await act(() => {
+      const consumed = new KeyboardEvent('keydown', { key: 'l', code: 'KeyL', bubbles: true, cancelable: true });
+      consumed.preventDefault();
+      window.dispatchEvent(consumed);
+    });
+    expect(write).toHaveBeenCalledTimes(1);
+    activeRoomId.value = null;
+    await press();
+    expect(write).toHaveBeenCalledTimes(1);
+  } finally {
+    write.mockRestore();
+    history.replaceState(null, '', originalUrl);
+    activeRoomId.value = null;
+  }
+});
diff --git a/apps/extension/widget/useFeedbackFlow.ts b/apps/extension/widget/useFeedbackFlow.ts
new file mode 100644
index 0000000000000000000000000000000000000000..dd761ac501e411ed08c62d51b300dd81218bbe46
--- /dev/null
+++ b/apps/extension/widget/useFeedbackFlow.ts
@@ -0,0 +1,125 @@
+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { useCallback, useEffect, useRef, useState } from 'preact/hooks';
+import { editableTarget } from '../lib/dom';
+import { bindKeymap } from '../lib/keymap';
+import { overlayHost } from '../lib/overlay-mount';
+import { activeTool, selectTool } from '../lib/tool-state';
+import { TOOL_SHORTCUTS } from '../lib/tools';
+import { copyReviewLink } from './copy-review-link';
+import { reviewPanelOpen } from './review-state';
+
+/** Transitions for the selected review bar; annotation state stays in the native layers. */
+export function useFeedbackFlow() {
+  const [pinOpen, setPinOpen] = useState(false);
+  const [textOpen, setTextOpen] = useState(false);
+  const pinCancel = useRef<(() => void) | null>(null);
+  const textCancel = useRef<(() => void) | null>(null);
+  const [confirmation, setConfirmation] = useState(false);
+  const successTimer = useRef<ReturnType<typeof setTimeout>>();
+  useEffect(() => () => clearTimeout(successTimer.current), []);
+
+  const focusControls = useCallback(() => {
+    const focus = () => {
+      overlayHost()?.shadowRoot?.querySelector<HTMLElement>('[data-feedback-focus]')?.focus({ preventScroll: true });
+    };
+    focus();
+    requestAnimationFrame(focus);
+  }, []);
+
+  const cancel = useCallback(() => {
+    const dismiss = textCancel.current ?? pinCancel.current;
+    if (dismiss) return dismiss();
+    activeTool.value = 'navigate';
+    reviewPanelOpen.value = false;
+    setConfirmation(false);
+    clearTimeout(successTimer.current);
+    window.getSelection()?.removeAllRanges();
+    focusControls();
+  }, [focusControls]);
+
+  const comment = useCallback(() => {
+    clearTimeout(successTimer.current);
+    setConfirmation(false);
+    reviewPanelOpen.value = false;
+    selectTool({ tool: 'comment', via: 'toolbar' });
+  }, []);
+
+  const submitted = useCallback(() => {
+    activeTool.value = 'navigate';
+    setConfirmation(true);
+    clearTimeout(successTimer.current);
+    successTimer.current = setTimeout(() => setConfirmation(false), 1600);
+  }, []);
+
+  const composerClosed = useCallback(() => {
+    activeTool.value = 'navigate';
+    focusControls();
+  }, [focusControls]);
+
+  const showThreads = useCallback(() => {
+    activeTool.value = 'navigate';
+    reviewPanelOpen.value = !reviewPanelOpen.value;
+    if (!reviewPanelOpen.value) focusControls();
+  }, [focusControls]);
+
+  useEffect(
+    () =>
+      bindKeymap({
+        scope: window,
+        bindings: [
+          ...[...TOOL_SHORTCUTS, { tool: 'navigate' as const, pattern: 'KeyB' }]
+            .filter(({ tool }) => ['comment', 'selection', 'navigate'].includes(tool))
+            .map(({ tool, pattern }) => ({
+              keys: pattern,
+              on: (e: KeyboardEvent) => {
+                if (e.defaultPrevented || e.isComposing || editableTarget(e)) return;
+                e.preventDefault();
+                if (tool === 'comment') return comment();
+                if (tool === 'navigate') return cancel();
+                reviewPanelOpen.value = false;
+                selectTool({ tool, via: 'shortcut' });
+              },
+            })),
+          {
+            keys: 'KeyL',
+            on: (e: KeyboardEvent) => {
+              if (e.defaultPrevented || e.isComposing || e.repeat || editableTarget(e)) return;
+              if (copyReviewLink()) e.preventDefault();
+            },
+          },
+          {
+            keys: 'KeyT',
+            on: (e: KeyboardEvent) => {
+              if (e.isComposing || e.repeat || editableTarget(e) || pinOpen || textOpen) return;
+              e.preventDefault();
+              showThreads();
+            },
+          },
+          {
+            keys: 'Escape',
+            on: (e: KeyboardEvent) => {
+              if (e.defaultPrevented || e.isComposing || editableTarget(e)) return;
+              cancel();
+            },
+          },
+        ],
+      }),
+    [pinOpen, textOpen, comment, cancel, showThreads],
+  );
+
+  return {
+    pinOpen,
+    setPinOpen,
+    textOpen,
+    setTextOpen,
+    pinCancel,
+    textCancel,
+    confirmation,
+    focusControls,
+    cancel,
+    comment,
+    submitted,
+    composerClosed,
+    showThreads,
+  };
+}
