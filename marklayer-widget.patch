+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { Link } from 'lucide-preact';
+import { activeRoomId } from '../lib/room-id';
+import { ControlHint } from './ControlHint';
+import { copyReviewLink } from './copy-review-link';
+
+/** One link action with the existing control treatment appropriate to its surface. */
+export function CopyReviewLink({ surface }: { surface: 'toolbar' | 'panel' }) {
+  const hintId = `ml-copy-review-${surface}-tip`;
+  return (
+    <button
+      type="button"
+      class={`ml-hint-trigger ${surface === 'toolbar' ? 'ml-feedback-action ml-feedback-copy' : 'ml-review-button'}`}
+      aria-label="Copy review link"
+      aria-keyshortcuts="L"
+      aria-describedby={hintId}
+      disabled={!activeRoomId.value}
+      onClick={() => copyReviewLink()}
+    >
+      <Link size={17} strokeWidth={1.6} aria-hidden="true" />
+      <ControlHint
+        id={hintId}
+        title="Copy review link"
+        shortcut="L"
+        side={surface === 'panel' ? 'bottom' : 'top'}
+      />
+    </button>
+  );
+}
diff --git a/apps/extension/widget/ReviewDock.tsx b/apps/extension/widget/ReviewDock.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..c8c8276d04d06c2bdb1266c2296429930e642a72
--- /dev/null
+++ b/apps/extension/widget/ReviewDock.tsx
@@ -0,0 +1,122 @@
+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { Check, List, MessageCircle, MousePointer2, X } from 'lucide-preact';
+import { useCoarsePointer } from '../lib/media';
+import { COMMENT_GUIDANCE, ControlHint } from './ControlHint';
+import { CopyReviewLink } from './CopyReviewLink';
+import { ReviewerNameAction } from './ReviewerNameAction';
+
+export const REVIEW_DOCK_CSS = `
+.ml-feedback-controls { position:fixed; bottom:calc(env(safe-area-inset-bottom,0px) + 16px); z-index:2147483647; pointer-events:auto; color:#27272a; font:500 13px/1.4 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; max-width:calc(100vw - 24px); }
+.ml-feedback-controls { left:50%; transform:translateX(-50%); }
+.ml-feedback-controls > .ml-feedback-surface { width:max-content; min-width:min(340px,calc(100vw - 24px)); max-width:calc(100vw - 24px); box-sizing:border-box; justify-content:space-between; }
+.ml-feedback-controls .ml-feedback-status { flex:1; }
+.ml-feedback-surface { display:flex; align-items:center; gap:4px; padding:5px; border:1px solid rgba(24,24,27,.13); border-radius:12px; background:#fff; box-shadow:0 3px 12px rgba(0,0,0,.07),0 12px 32px rgba(0,0,0,.06); }
+.ml-feedback-action { position:relative; display:inline-flex; align-items:center; justify-content:center; gap:7px; min-height:36px; padding:0 11px; border:0; border-radius:8px; background:transparent; color:inherit; font:inherit; cursor:pointer; white-space:nowrap; }
+.ml-feedback-action:hover { background:#f4f4f5; }
+.ml-feedback-action[aria-pressed="true"],.ml-feedback-action[aria-expanded="true"] { background:#f0f0f1; color:#09090b; }
+.ml-feedback-action:focus-visible { outline:2px solid #0070f3; outline-offset:2px; }
+.ml-feedback-count { color:#71717a; font-size:12px; font-variant-numeric:tabular-nums; }
+.ml-feedback-divider { width:1px; height:20px; margin:0 2px; background:#e4e4e7; }
+/* Keep the labelled controls centered and stationary; only the surface's right edge grows. */
+.ml-feedback-controls > .ml-feedback-idle { position:relative; isolation:isolate; min-width:0; border-color:transparent; background:transparent; box-shadow:none; }
+.ml-feedback-idle::before { content:""; position:absolute; inset:-1px; z-index:-1; border:1px solid rgba(24,24,27,.13); border-radius:12px; background:#fff; box-shadow:0 3px 12px rgba(0,0,0,.07),0 12px 32px rgba(0,0,0,.06); transition:right 200ms cubic-bezier(.22,1,.36,1); }
+.ml-feedback-controls .ml-feedback-copy { position:absolute; left:calc(100% - 2px); top:5px; width:32px; min-width:32px; padding:0; opacity:0; pointer-events:none; transition:opacity 130ms ease; }
+.ml-feedback-controls:is(:hover,:has(:focus-visible)) .ml-feedback-idle::before { right:-37px; }
+.ml-feedback-controls:is(:hover,:has(:focus-visible)) .ml-feedback-copy { opacity:1; pointer-events:auto; }
+/* Touch and narrow screens keep the action discoverable and the complete bar within the viewport. */
+@media(hover:none),(max-width:480px) {
+ .ml-feedback-controls > .ml-feedback-idle { padding-right:41px; flex-wrap:wrap; justify-content:center; }
+ .ml-feedback-controls > .ml-feedback-surface { flex-wrap:wrap; }
+ .ml-feedback-controls .ml-feedback-idle::before { right:-1px; }
+ .ml-feedback-controls .ml-feedback-copy { left:auto; right:5px; opacity:1; pointer-events:auto; }
+}
+@media(prefers-reduced-motion:reduce) { .ml-feedback-idle::before,.ml-feedback-copy { transition:none; } }
+.ml-feedback-status { display:flex; align-items:center; gap:8px; padding:0 8px; font-size:12px; white-space:nowrap; }
+@media(max-width:389px) { .ml-feedback-controls .ml-feedback-action { padding:0 6px; gap:4px; font-size:11px; } .ml-feedback-controls .ml-feedback-action > svg { width:15px; height:15px; } .ml-feedback-controls .ml-feedback-copy { padding:0; min-width:28px; width:28px; } .ml-feedback-status { padding:0 5px; font-size:11px; } }
+`;
+
+/** The selected labelled review bar; native layers own comments and drafts. */
+export function ReviewDock({
+  count,
+  commenting,
+  composing,
+  panelOpen,
+  confirmation,
+  onBrowse,
+  onComment,
+  onThreads,
+}: {
+  count: number;
+  commenting: boolean;
+  composing: boolean;
+  panelOpen: boolean;
+  confirmation: boolean;
+  onBrowse: () => void;
+  onComment: () => void;
+  onThreads: () => void;
+}) {
+  const guidance = useCoarsePointer() ? 'Double tap to comment' : COMMENT_GUIDANCE;
+  const active = commenting || composing || confirmation;
+  return (
+    <div data-ml-toolbar data-browse-controls class="ml-feedback-controls">
+      <div class={`ml-feedback-surface${active ? '' : ' ml-feedback-idle'}`} role="toolbar" aria-label="Page feedback">
+        {active ? (
+          <>
+            <span class="ml-feedback-status" role="status">
+              {confirmation ? <Check size={16} strokeWidth={1.8} /> : <MessageCircle size={16} strokeWidth={1.6} />}
+              {confirmation ? 'Comment added' : composing ? 'Write your comment' : guidance}
+            </span>
+            <ReviewerNameAction />
+            <span class="ml-feedback-divider" aria-hidden="true" />
+            <button type="button" data-feedback-focus class="ml-feedback-action" onClick={onBrowse}>
+              {!confirmation && <X size={14} />} {confirmation ? 'Done' : 'Cancel'}
+            </button>
+          </>
+        ) : (
+          <>
+            <button
+              type="button"
+              data-feedback-focus
+              class="ml-feedback-action ml-hint-trigger"
+              aria-pressed={!panelOpen}
+              aria-label="Browse"
+              aria-keyshortcuts="B V"
+              aria-describedby="ml-browse-tip"
+              onClick={onBrowse}
+            >
+              <MousePointer2 size={17} strokeWidth={1.6} /> Browse
+              <ControlHint id="ml-browse-tip" title="Browse page" shortcut="B" />
+            </button>
+            <button
+              type="button"
+              aria-label="Comment"
+              aria-keyshortcuts="C"
+              class="ml-feedback-action ml-hint-trigger"
+              aria-describedby="ml-comment-tip"
+              onClick={onComment}
+            >
+              <MessageCircle size={17} strokeWidth={1.6} /> Comment
+              <ControlHint id="ml-comment-tip" title={guidance} shortcut="C" />
+            </button>
+            <button
+              type="button"
+              class="ml-feedback-action ml-hint-trigger"
+              aria-pressed={panelOpen}
+              aria-label={`Threads, ${count}`}
+              aria-describedby="ml-threads-tip"
+              aria-keyshortcuts="T"
+              aria-expanded={panelOpen}
+              onClick={onThreads}
+            >
+              <List size={17} strokeWidth={1.6} /> Threads
+              <span class="ml-feedback-count">{count}</span>
+              <ControlHint id="ml-threads-tip" title="Threads" shortcut="T" />
+            </button>
+            <ReviewerNameAction />
+            <CopyReviewLink surface="toolbar" />
+          </>
+        )}
+      </div>
+    </div>
+  );
+}
