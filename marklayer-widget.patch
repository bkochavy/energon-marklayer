index 0000000000000000000000000000000000000000..13e2befad6e72d8d3c0c3c343ef159ee2a5b7819
--- /dev/null
+++ b/apps/extension/widget/identity-store.ts
@@ -0,0 +1,81 @@
+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import type { IdentityStore } from '../lib/host-config';
+import { randomUserName } from '../lib/identity';
+import { configureReviewerName } from '../lib/reviewer-name';
+import { toast } from '../lib/toasts';
+
+export interface ReviewerIdentity {
+  id: string;
+  name: string | null;
+  endpoint: string;
+  capability: string;
+}
+
+/** The response decorator supplies only this narrow, same-host preference capability. */
+export function parseReviewerIdentity(raw: string | undefined, scriptUrl: string): ReviewerIdentity | undefined {
+  if (!raw) return;
+  try {
+    const value = JSON.parse(raw) as ReviewerIdentity;
+    const endpoint = new URL(value.endpoint);
+    if (
+      typeof value.id !== 'string' ||
+      !value.id ||
+      !(value.name === null || (typeof value.name === 'string' && value.name.length <= 24)) ||
+      typeof value.capability !== 'string' ||
+      !value.capability ||
+      endpoint.origin !== new URL(scriptUrl).origin ||
+      endpoint.pathname !== '/comments/identity' ||
+      endpoint.search ||
+      endpoint.hash ||
+      endpoint.username ||
+      endpoint.password
+    )
+      return;
+    return value;
+  } catch {
+    return;
+  }
+}
+
+/** Serial preference writes are independent of native comment transport. Never retry a stale capability. */
+export function createReviewerIdentityStore(initial: ReviewerIdentity): IdentityStore {
+  let capability = initial.capability;
+  let queue = Promise.resolve();
+  const write = (name: string | null) => {
+    queue = queue.then(async () => {
+      let expired = false;
+      try {
+        const response = await fetch(initial.endpoint, {
+          method: name === null ? 'DELETE' : 'POST',
+          credentials: 'omit',
+          cache: 'no-store',
+          keepalive: true,
+          signal: AbortSignal.timeout(10_000),
+          headers: { Authorization: `Bearer ${capability}`, 'content-type': 'application/json' },
+          ...(name === null ? {} : { body: JSON.stringify({ name }) }),
+        });
+        expired = response.status === 401;
+        if (!response.ok) throw new Error('Preference not saved');
+        const result = (await response.json()) as { capability?: string };
+        if (typeof result.capability !== 'string' || !result.capability) throw new Error('Invalid preference response');
+        capability = result.capability;
+      } catch {
+        toast(
+          name === null
+            ? 'Name cleared here. Couldn’t forget it for other links; reopen this review to try again.'
+            : expired
+              ? 'Using your name here. Reopen this review to remember it for next time.'
+              : 'Using your name here. Couldn’t remember it for next time.',
+        );
+      }
+    });
+  };
+  configureReviewerName(initial.name, () => write(null));
+  return {
+    persistDefaults: false,
+    load: () => ({ id: initial.id, name: initial.name || randomUserName() }),
+    save: ({ name }) => {
+      if (name) write(name);
+    },
+  };
+}
