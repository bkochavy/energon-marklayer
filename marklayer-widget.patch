@@ -0,0 +1,37 @@
+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { reviewPageUrl } from './review-link';
+import { adoptStyles } from './styles';
+
+const CSS = `:host{all:initial;position:fixed;bottom:16px;left:50%;transform:translateX(-50%);z-index:2147483647;font:13px system-ui;max-width:calc(100vw - 32px)}div{padding:10px 14px;border:1px solid #ddd;border-radius:10px;background:white;color:#27272a;box-shadow:0 3px 12px #0001}button,a{font:inherit;margin-left:8px;cursor:pointer}a{color:#27272a;text-decoration:underline}`;
+
+/** Reload clears failed module imports cached by WebKit; missing rooms need a deliberate new selection. */
+export function showLoadFailure({
+  missing,
+  pageUrl,
+  onReload,
+}: {
+  missing: boolean;
+  pageUrl: string;
+  onReload: () => void;
+}): HTMLElement {
+  const host = document.createElement('energon-comment-status');
+  const root = host.attachShadow({ mode: 'open' });
+  adoptStyles({ root, css: CSS });
+  const message = document.createElement('div');
+  message.setAttribute('role', 'status');
+  message.textContent = missing ? 'This review is no longer available.' : 'Comments could not load.';
+  if (missing) {
+    const link = document.createElement('a');
+    link.href = reviewPageUrl(pageUrl, '1');
+    link.textContent = 'Open current review';
+    message.append(link);
+  } else {
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.textContent = 'Reload page';
+    button.addEventListener('click', onReload);
+    message.append(button);
+  }
+  root.append(message);
+  return host;
+}
