+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { Popover } from '@base-ui/react/popover';
+import { cn } from '@marklayer/ui/cn';
+import { useRef, useState } from 'preact/hooks';
+import { ReviewerNameForm } from '../components/ReviewerName';
+import { geist } from '../lib/geist';
+import { glass } from '../lib/glass';
+import { useCoarsePointer } from '../lib/media';
+import { useEdgeClamp } from '../lib/popover';
+import { portalContainer } from '../lib/portal';
+import { commitReviewerName, reviewerNameChoice, reviewerNameFocusTarget } from '../lib/reviewer-name';
+
+/** Voluntary attribution uses the same identity, independent of any open draft. */
+export function ReviewerNameAction() {
+  const [open, setOpen] = useState(false);
+  const [present, setPresent] = useState(false);
+  const input = useRef<HTMLInputElement>(null);
+  const touch = useCoarsePointer();
+  const { attach, top, maxHeight, horizontal } = useEdgeClamp({ top: window.innerHeight, enabled: open && touch });
+  const available = reviewerNameChoice.value !== 'disabled' && reviewerNameChoice.value !== 'ready';
+  return (
+    <Popover.Root
+      open={open}
+      onOpenChange={(next) => {
+        if (next) setPresent(true);
+        setOpen(next);
+      }}
+      onOpenChangeComplete={(next) => {
+        if (!next) setPresent(false);
+      }}
+    >
+      {(available || present) && (
+        <Popover.Trigger data-reviewer-name-action className="ml-feedback-action">
+          Add your name
+        </Popover.Trigger>
+      )}
+      <Popover.Portal container={portalContainer.value ?? undefined}>
+        <Popover.Backdrop data-reviewer-name-action className="fixed inset-0 pointer-events-auto z-2147483647" />
+        <Popover.Positioner
+          ref={touch ? attach : undefined}
+          style={
+            touch
+              ? { top, left: horizontal.left + Math.max(8, (horizontal.width - 320) / 2), transform: 'none' }
+              : undefined
+          }
+          positionMethod="fixed"
+          side="top"
+          align="center"
+          sideOffset={12}
+          collisionPadding={8}
+          className="pointer-events-auto z-2147483647"
+        >
+          <Popover.Popup
+            data-reviewer-name-action
+            initialFocus={input}
+            finalFocus={() =>
+              reviewerNameFocusTarget() ??
+              (portalContainer.value ?? document).querySelector<HTMLElement>('[data-feedback-focus]') ??
+              true
+            }
+            style={{
+              maxHeight: touch ? maxHeight : 'var(--available-height)',
+              maxWidth: touch ? Math.max(0, horizontal.width - 16) : 'min(320px, var(--available-width))',
+            }}
+            className={cn(
+              geist.surface,
+              glass.font,
+              'w-[320px] max-w-[calc(100vw-16px)] outline-none overflow-y-auto overscroll-contain',
+            )}
+          >
+            <Popover.Title className="sr-only">Add your name</Popover.Title>
+            <ReviewerNameForm
+              inputRef={input}
+              onSave={(name) => {
+                if (commitReviewerName(name)) setOpen(false);
+              }}
+              onDismiss={() => setOpen(false)}
+            />
+          </Popover.Popup>
+        </Popover.Positioner>
+      </Popover.Portal>
+    </Popover.Root>
+  );
+}
