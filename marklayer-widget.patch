+++ b/apps/extension/components/ReviewerAuthor.test.tsx
@@ -0,0 +1,198 @@
+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { afterEach, beforeEach, expect, mock, test } from 'bun:test';
+import { render } from 'preact';
+import { act } from 'preact/test-utils';
+import { CardHold } from '../lib/card-hold';
+import { hydrateIdentity, localUser } from '../lib/identity';
+import { operations } from '../lib/ops';
+import { configureReviewerName, forgetReviewerName, reviewerNameChoice } from '../lib/reviewer-name';
+import { ReviewerAuthor } from './ReviewerName';
+
+let root: HTMLDivElement;
+const hold = mock((_open: boolean) => {});
+const save = mock((_value: unknown) => {});
+const click = async (label: string) => {
+  await act(() => root.querySelector<HTMLButtonElement>(`[aria-label="${label}"]`)!.click());
+};
+beforeEach(async () => {
+  hold.mockClear();
+  save.mockClear();
+  hydrateIdentity({ persistDefaults: false, load: () => ({ id: 'mine', name: 'Guest' }), save });
+  configureReviewerName(null, () => {});
+  const base = {
+    tool: 'comment' as const,
+    x: 1,
+    y: 2,
+    text: 'saved',
+    num: 1,
+    ts: 1,
+    color: '#000',
+    lineWidth: 1,
+    author: 'Guest',
+  };
+  operations.value = [
+    { ...base, id: 'mine-op', authorId: 'mine' },
+    { ...base, id: 'reply', parentId: 'mine-op', authorId: 'mine' },
+    { ...base, id: 'theirs', authorId: 'peer' },
+    { ...base, id: 'legacy' },
+  ];
+  root = document.createElement('div');
+  document.body.append(root);
+  await act(() =>
+    render(
+      <CardHold value={hold}>
+        <ReviewerAuthor author="Guest" authorId="mine" />
+      </CardHold>,
+      root,
+    ),
+  );
+});
+afterEach(() => {
+  render(null, root);
+  root.remove();
+  operations.value = [];
+  hydrateIdentity(undefined);
+  reviewerNameChoice.value = 'disabled';
+});
+
+test('explicit save uses native relabeling for own signed root and replies, and releases the hover hold', async () => {
+  await click('Change your name: Guest');
+  expect(hold.mock.calls).toEqual([[true]]);
+  await act(() => {
+    const field = root.querySelector('input')!;
+    field.value = 'Ben';
+    field.dispatchEvent(new Event('input', { bubbles: true }));
+  });
+  expect(operations.value[0]?.author).toBe('Guest');
+  await click('Save name');
+  expect(operations.value.map((op) => op.author)).toEqual(['Ben', 'Ben', 'Guest', 'Guest']);
+  expect(localUser.name).toBe('Ben');
+  expect(hold.mock.calls).toEqual([[true], [false]]);
+  forgetReviewerName();
+  expect(operations.value[0]?.author).toBe('Ben');
+  await act(() =>
+    render(
+      <CardHold value={hold}>
+        <ReviewerAuthor author="Ben" authorId="mine" />
+      </CardHold>,
+      root,
+    ),
+  );
+  await click(`Change your name: ${localUser.name}`);
+  await act(() => {
+    const field = root.querySelector('input')!;
+    field.value = 'Alex';
+    field.dispatchEvent(new Event('input', { bubbles: true }));
+  });
+  await click('Save name');
+  expect(operations.value.map((op) => op.author)).toEqual(['Alex', 'Alex', 'Guest', 'Guest']);
+});
+
+test('Escape releases the hold without renaming or saving', async () => {
+  await click('Change your name: Guest');
+  await act(() => {
+    root.querySelector('input')!.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', bubbles: true }));
+  });
+  expect(hold.mock.calls).toEqual([[true], [false]]);
+  expect(save).not.toHaveBeenCalled();
