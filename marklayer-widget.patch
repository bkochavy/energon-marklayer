@@ -0,0 +1,77 @@
+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { expect, mock, test } from 'bun:test';
+import { render } from 'preact';
+import * as compat from 'preact/compat';
+import * as jsxRuntime from 'preact/jsx-runtime';
+import { act } from 'preact/test-utils';
+import { operations } from '../lib/ops';
+import { reviewerNameChoice } from '../lib/reviewer-name';
+import { activeTool } from '../lib/tool-state';
+
+const baseUi = Bun.resolveSync('@base-ui/react', import.meta.dir);
+mock.module(Bun.resolveSync('react', baseUi), () => compat);
+mock.module(Bun.resolveSync('react-dom', baseUi), () => compat);
+mock.module(Bun.resolveSync('react/jsx-runtime', baseUi), () => jsxRuntime);
+const { SelectionLayer } = await import('./SelectionLayer');
+
+test('in-place text edit preserves origin view and geometry through resize before saving', async () => {
+  const previous = {
+    width: window.innerWidth,
+    height: window.innerHeight,
+    rects: Range.prototype.getClientRects,
+    tool: activeTool.value,
+    choice: reviewerNameChoice.value,
+    ops: operations.value,
+  };
+  const el = document.createElement('p');
+  const root = document.createElement('div');
+  el.id = 'resize-edit-target';
+  el.textContent = 'Hello world';
+  document.body.append(el, root);
+  const rect = new DOMRect(20, 100, 200, 30);
+  Range.prototype.getClientRects = () => Object.assign([rect], { item: () => rect });
+  el.getBoundingClientRect = () => (window.innerWidth < 768 ? rect : new DOMRect(40, 50, 600, 20));
+  try {
+    operations.value = [];
+    reviewerNameChoice.value = 'disabled';
+    activeTool.value = 'selection';
+    window.innerWidth = 390;
+    window.innerHeight = 844;
+    await act(() => render(<SelectionLayer deviceView="mobile" />, root));
+    await act(() => {
+      el.dispatchEvent(new MouseEvent('dblclick', { bubbles: true, clientX: 25, clientY: 105 }));
+    });
+    expect(el.getAttribute('contenteditable')).toBe('plaintext-only');
+    el.textContent = 'Hello there';
+    window.innerWidth = 1280;
+    window.innerHeight = 900;
+    await act(() => render(<SelectionLayer deviceView="desktop" />, root));
+    await act(() => {
+      el.dispatchEvent(new KeyboardEvent('keydown', { key: 'Enter', code: 'Enter', bubbles: true, cancelable: true }));
+    });
+    const save = [...root.querySelectorAll('button')].find((b) => b.textContent?.trim() === 'Save ↵');
+    if (!save) throw new Error('Missing Save');
+    await act(() => save.click());
+    expect(operations.value).toHaveLength(1);
+    const op = operations.value[0];
+    if (op?.tool !== 'selection') throw new Error('Missing selection');
+    expect(op).toMatchObject({
+      device: 'mobile',
+      captureViewport: { width: 390, height: 844 },
+      rects: [{ x: 20, y: 100, width: 200, height: 30 }],
+      target: { rect: { x: 20, y: 100, width: 200, height: 30 }, offsetX: 0, offsetY: 0 },
+      text: 'Hello world',
+      suggestion: 'Hello there',
+    });
+  } finally {
+    await act(() => render(null, root));
+    el.remove();
+    root.remove();
+    window.innerWidth = previous.width;
+    window.innerHeight = previous.height;
+    Range.prototype.getClientRects = previous.rects;
+    activeTool.value = previous.tool;
+    reviewerNameChoice.value = previous.choice;
+    operations.value = previous.ops;
+  }
+});
