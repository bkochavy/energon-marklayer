index 0000000000000000000000000000000000000000..a156bef3ab3da3f4ca7cc810625b450ce6363288
--- /dev/null
+++ b/apps/extension/components/ReplyComposer.test.tsx
@@ -0,0 +1,53 @@
+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { afterEach, expect, mock, test } from 'bun:test';
+import { render } from 'preact';
+import * as compat from 'preact/compat';
+import * as jsxRuntime from 'preact/jsx-runtime';
+import { act } from 'preact/test-utils';
+import { hydrateIdentity } from '../lib/identity';
+import { operations } from '../lib/ops';
+import { configureReviewerName, reviewerNameChoice } from '../lib/reviewer-name';
+
+// Match the production Vite aliases used by native Base UI components.
+const baseUi = Bun.resolveSync('@base-ui/react', import.meta.dir);
+mock.module(Bun.resolveSync('react', baseUi), () => compat);
+mock.module(Bun.resolveSync('react-dom', baseUi), () => compat);
+mock.module(Bun.resolveSync('react/jsx-runtime', baseUi), () => jsxRuntime);
+const { ReplyComposer } = await import('./ThreadCard');
+const root = document.createElement('div');
+
+afterEach(() => {
+  render(null, root);
+  root.remove();
+  operations.value = [];
+  hydrateIdentity(undefined);
+  reviewerNameChoice.value = 'disabled';
+});
+
+async function click(label: string) {
+  await act(() => {
+    const button = [...root.querySelectorAll('button')].find((b) => b.textContent?.trim() === label);
+    if (!button) throw new Error(`Missing button: ${label}`);
+    button.click();
+  });
+}
+
+test('Escape from initial name step closes reply without posting or choosing a name', async () => {
+  document.body.append(root);
+  configureReviewerName(null, () => {});
+  await act(() =>
+    render(
+      <ReplyComposer parent={{ id: 'parent', x: 1, y: 2 }} upload={async () => null} resolveUrl={(id) => id} />,
+      root,
+    ),
+  );
+  await click('Reply');
+  await act(() => {
+    root.querySelector('input')!.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', bubbles: true }));
+  });
+  expect(root.querySelector('input')).toBeNull();
+  expect(operations.value).toHaveLength(0);
+  expect(reviewerNameChoice.value).toBe('ask');
+  await click('Reply');
+  expect(root.textContent).toContain('First, what’s your name?');
+});
diff --git a/apps/extension/components/ReviewerAuthor.test.tsx b/apps/extension/components/ReviewerAuthor.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..3f02949637c218b35bbac0f1d3c4e002857adebb
