@@ -0,0 +1,190 @@
+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { isEditableElement } from './dom';
+import { adoptStyles } from './dom-styles';
+import { isExtensionElement } from './selector';
+import { textHitAt } from './text-hit';
+
+// ColdBru test modification: native selection stays available while placing comments.
+const COMMENT_CURSOR = `url("data:image/svg+xml,${encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 28 28"><path d="M5 3h18a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H11l-7 5V5a2 2 0 0 1 1-2Z" fill="white" stroke="#171717" stroke-width="2" stroke-linejoin="round"/><path d="M9 9h11M9 14h8" stroke="#171717" stroke-width="1.5" stroke-linecap="round"/></svg>')}" ) 4 25, pointer`;
+
+function pageTarget(e: Event): Element | null {
+  const target = e.composedPath()[0];
+  if (!(target instanceof Element)) return null;
+  // closest() cannot cross a shadow root; the event path includes our UI's host.
+  if (e.composedPath().some((node) => node instanceof Element && isExtensionElement(node))) return null;
+  if (isEditableElement(target)) return null;
+  return target;
+}
+
+/** Capture completed gestures only; the browser owns text selection and scrolling. */
+export function bindCommentGestures(
+  onPin: (e: MouseEvent) => void,
+  { touchDoubleTap = false }: { touchDoubleTap?: boolean } = {},
+): () => void {
+  let down: {
+    id: number;
+    x: number;
+    y: number;
+    scrollX: number;
+    scrollY: number;
+    dragged: boolean;
+    touch: boolean;
+    started: number;
+  } | null = null;
+  let lastTap: { x: number; y: number; time: number; target: Element } | null = null;
+  let pendingTouchClick = false;
+  let textTarget: Element | null = null;
+  let pointer: { x: number; y: number } | null = null;
+  let scrollFrame = 0;
+  const clearTextCursor = () => {
+    textTarget?.removeAttribute('data-ml-text-hit');
+    textTarget = null;
+  };
+  const cursorAt = (target: Element | null) => {
+    const hit =
+      pointer && target && !target.closest('img, svg, video, canvas, iframe') && textHitAt(pointer.x, pointer.y)
+        ? target
+        : null;
+    if (hit === textTarget) return;
+    clearTextCursor();
+    textTarget = hit;
+    textTarget?.setAttribute('data-ml-text-hit', '');
+  };
+  const onScroll = () => {
+    lastTap = null;
+    if (!pointer || scrollFrame) return;
+    scrollFrame = requestAnimationFrame(() => {
+      scrollFrame = 0;
+      if (!pointer) return;
+      const target = document.elementFromPoint(pointer.x, pointer.y);
+      cursorAt(target && !isExtensionElement(target) ? target : null);
+    });
+  };
+  const leave = () => {
+    pointer = null;
+    clearTextCursor();
+  };
+  const onOut = (e: PointerEvent) => {
+    if (!e.relatedTarget) leave();
+  };
+  const start = (e: PointerEvent) => {
+    pendingTouchClick = false;
+    down =
+      e.isPrimary && e.button === 0 && pageTarget(e)
+        ? {
+            id: e.pointerId,
+            x: e.clientX,
+            y: e.clientY,
+            scrollX,
+            scrollY,
+            dragged: false,
+            touch: e.pointerType === 'touch',
+            started: Date.now(),
+          }
+        : null;
+  };
+  const move = (e: PointerEvent) => {
+    pointer = { x: e.clientX, y: e.clientY };
+    cursorAt(pageTarget(e));
+    if (down?.id === e.pointerId && Math.hypot(e.clientX - down.x, e.clientY - down.y) > 5) {
+      down.dragged = true;
+      lastTap = null;
+    }
+  };
+  const cancel = () => {
+    down = null;
+    lastTap = null;
+    pendingTouchClick = false;
+    leave();
+  };
+  const complete = (e: MouseEvent) => {
+    const gesture = down;
+    down = null;
+    if (e.button !== 0 || !pageTarget(e)) return;
+    if (!gesture) return;
+    if (gesture.dragged || Math.hypot(e.clientX - gesture.x, e.clientY - gesture.y) > 5) {
+      lastTap = null;
+      return;
+    }
+    if (scrollX !== gesture.scrollX || scrollY !== gesture.scrollY) {
+      lastTap = null;
+      return;
+    }
+    if (gesture.touch && Date.now() - gesture.started > 450) {
+      lastTap = null;
+      return;
+    }
+    const selection = window.getSelection();
+    if (selection && !selection.isCollapsed && selection.toString().trim()) {
+      lastTap = null;
+      return;
+    }
+    if (touchDoubleTap && gesture.touch) {
+      const target = pageTarget(e)!;
+      const time = Date.now();
+      const paired =
+        lastTap &&
+        lastTap.target === target &&
+        time - lastTap.time <= 400 &&
+        Math.hypot(e.clientX - lastTap.x, e.clientY - lastTap.y) <= 24;
+      lastTap = paired ? null : { x: e.clientX, y: e.clientY, time, target };
+      if (!paired) return;
+    } else lastTap = null;
+    onPin(e);
+    return true;
+  };
+
+  // Mobile Safari can emit a complete touch pointer sequence without a click.
+  // The same tap can then emit mouse events onto the newly opened composer.
+  // Own that tail until its click, or the next pointerdown if no click arrives.
+  const release = (e: PointerEvent) => {
+    if (touchDoubleTap && down?.touch && down.id === e.pointerId) pendingTouchClick = complete(e) === true;
+  };
+  const consumeTouchMouse = (e: MouseEvent) => {
+    // Keyboard/assistive clicks have detail=0 and are independent actions.
+    if (!pendingTouchClick || e.button !== 0 || e.detail === 0) return false;
+    e.preventDefault();
+    e.stopImmediatePropagation();
+    if (e.type === 'click') pendingTouchClick = false;
+    return true;
+  };
+  const click = (e: MouseEvent) => {
+    if (consumeTouchMouse(e)) return;
+    if (e.button !== 0 || !pageTarget(e)) return;
+    e.preventDefault();
+    e.stopImmediatePropagation();
+    complete(e);
+  };
+
+  const removeCursor = adoptStyles({
+    root: document,
+    css: `body, body * { cursor: ${COMMENT_CURSOR} !important; }
+    body [data-ml-text-hit], body[data-ml-text-hit] { cursor: text !important; }
+    body input, body textarea, body select, body [contenteditable], body [contenteditable] * { cursor: auto !important; }`,
+  });
+  window.addEventListener('pointerdown', start, true);
+  window.addEventListener('pointermove', move, true);
+  window.addEventListener('pointerup', release, true);
+  window.addEventListener('pointercancel', cancel, true);
+  window.addEventListener('mousedown', consumeTouchMouse, true);
+  window.addEventListener('mouseup', consumeTouchMouse, true);
+  window.addEventListener('click', click, true);
+  window.addEventListener('blur', cancel);
+  window.addEventListener('pointerout', onOut, true);
+  window.addEventListener('scroll', onScroll, true);
+  return () => {
+    removeCursor();
+    leave();
+    cancelAnimationFrame(scrollFrame);
+    window.removeEventListener('pointerdown', start, true);
+    window.removeEventListener('pointermove', move, true);
+    window.removeEventListener('pointerup', release, true);
+    window.removeEventListener('pointercancel', cancel, true);
+    window.removeEventListener('mousedown', consumeTouchMouse, true);
+    window.removeEventListener('mouseup', consumeTouchMouse, true);
+    window.removeEventListener('click', click, true);
+    window.removeEventListener('blur', cancel);
+    window.removeEventListener('pointerout', onOut, true);
+    window.removeEventListener('scroll', onScroll, true);
+  };
+}
