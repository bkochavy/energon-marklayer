+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { afterEach, describe, expect, test } from 'bun:test';
+import { textHitAt } from './text-hit';
+
+const parents: HTMLElement[] = [];
+afterEach(() => {
+  for (const parent of parents.splice(0)) parent.remove();
+});
+
+function fixture({ text = 'a b', fallback = false, userSelect = '' } = {}) {
+  const parent = document.createElement('p');
+  parent.textContent = text;
+  parent.style.userSelect = userSelect;
+  document.body.append(parent);
+  parents.push(parent);
+  const node = parent.firstChild!;
+  let start = 0;
+  const doc = {
+    defaultView: window,
+    caretPositionFromPoint: fallback ? undefined : () => ({ offsetNode: node, offset: 1 }),
+    caretRangeFromPoint: () => ({ startContainer: node, startOffset: 1 }),
+    createRange: () => ({
+      setStart: (_node: Node, offset: number) => {
+        start = offset;
+      },
+      setEnd: () => {},
+      getClientRects: () => [{ left: start * 10, right: start * 10 + 10, top: 20, bottom: 35, width: 10, height: 15 }],
+    }),
+  } as unknown as Document;
+  return doc;
+}
+
+describe('text cursor hit testing', () => {
+  test('a real character box is selectable', () => {
+    expect(textHitAt(5, 25, fixture())).toBe(true);
+  });
+  test('nearest caret in paragraph padding is not a text hit', () => {
+    expect(textHitAt(100, 25, fixture())).toBe(false);
+  });
+  test('vertical space outside a line does not get an I-beam', () => {
+    expect(textHitAt(5, 50, fixture())).toBe(false);
+  });
+  test('a rendered internal space retains the normal text cursor', () => {
+    expect(textHitAt(15, 25, fixture())).toBe(true);
+  });
+  test('user-select none and whitespace-only nodes stay non-text', () => {
+    expect(textHitAt(5, 25, fixture({ userSelect: 'none' }))).toBe(false);
+    expect(textHitAt(5, 25, fixture({ text: '   ' }))).toBe(false);
+  });
+  test('the range-based browser fallback uses the same character bounds', () => {
+    expect(textHitAt(5, 25, fixture({ fallback: true }))).toBe(true);
+    expect(textHitAt(100, 25, fixture({ fallback: true }))).toBe(false);
+  });
+});
diff --git a/apps/extension/lib/text-hit.ts b/apps/extension/lib/text-hit.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6387e0f93c5bc2df15344b51328c87277bfa635a
--- /dev/null
+++ b/apps/extension/lib/text-hit.ts
@@ -0,0 +1,30 @@
+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+/** Use the browser's caret hit test, but reject its nearest-text answer outside real character boxes. */
+export function textHitAt(x: number, y: number, doc: Document = document): boolean {
+  const native = doc as Document & {
+    caretPositionFromPoint?: (x: number, y: number) => { offsetNode: Node; offset: number } | null;
+    caretRangeFromPoint?: (x: number, y: number) => Range | null;
+  };
+  const caret = native.caretPositionFromPoint?.(x, y);
+  const fallback = caret ? null : native.caretRangeFromPoint?.(x, y);
+  const node = caret?.offsetNode ?? fallback?.startContainer;
+  const offset = caret?.offset ?? fallback?.startOffset;
+  if (!node || node.nodeType !== Node.TEXT_NODE || offset === undefined || !node.textContent?.trim()) return false;
+  const parent = node.parentElement;
+  if (!parent || parent.closest('input, textarea, select, [contenteditable], [inert], mark-layer, marklayer-feedback'))
+    return false;
+  if (doc.defaultView?.getComputedStyle(parent).userSelect === 'none') return false;
+
+  const range = doc.createRange();
+  // A caret is at either edge of the character underneath the pointer. Check both adjacent characters.
+  for (const start of [offset - 1, offset]) {
+    if (start < 0 || start >= node.textContent.length) continue;
+    range.setStart(node, start);
+    range.setEnd(node, start + 1);
+    for (const rect of range.getClientRects()) {
+      if (rect.width > 0 && rect.height > 0 && x >= rect.left && x <= rect.right && y >= rect.top && y <= rect.bottom)
+        return true;
+    }
+  }
+  return false;
+}
