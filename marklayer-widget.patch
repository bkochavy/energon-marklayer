@@ -0,0 +1,140 @@
+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { afterEach, beforeEach, describe, expect, spyOn, test } from 'bun:test';
+import { bindCommentGestures } from './comment-gestures';
+
+describe('feedback gestures on the real page', () => {
+  let root: HTMLDivElement;
+  let link: HTMLAnchorElement;
+  let dispose: () => void;
+  let pins: number;
+  let activations: number;
+  let selection: ReturnType<typeof spyOn> | undefined;
+
+  const pointer = (target: Element, type: string, x = 10, y = 10) => {
+    const event = new PointerEvent(type, {
+      bubbles: true,
+      composed: true,
+      cancelable: true,
+      isPrimary: true,
+      pointerId: 1,
+      button: 0,
+      clientX: x,
+      clientY: y,
+    });
+    target.dispatchEvent(event);
+    return event;
+  };
+  const click = (target: Element, x = 10, y = 10) => {
+    const event = new MouseEvent('click', {
+      bubbles: true,
+      composed: true,
+      cancelable: true,
+      button: 0,
+      detail: 1,
+      clientX: x,
+      clientY: y,
+    });
+    target.dispatchEvent(event);
+    return event;
+  };
+
+  beforeEach(() => {
+    root = document.createElement('div');
+    root.innerHTML =
+      '<a href="#destination">Selectable page copy</a><input><textarea></textarea><div contenteditable="true">Editable</div><marklayer-feedback><button>Feedback</button></marklayer-feedback>';
+    document.body.append(root);
+    link = root.querySelector('a')!;
+    pins = 0;
+    activations = 0;
+    link.addEventListener('click', () => {
+      activations++;
+    });
+    dispose = bindCommentGestures(() => {
+      pins++;
+    });
+  });
+
+  afterEach(() => {
+    selection?.mockRestore();
+    selection = undefined;
+    dispose();
+    root.remove();
+  });
+
+  test('a click places exactly one pin without activating the link, while pointerdown remains native', () => {
