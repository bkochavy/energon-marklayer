@@ -0,0 +1,8 @@
+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+/** A review belongs to the published page; the provider room endpoint is never a share link. */
+export function reviewPageUrl(pageUrl: string, room: string): string {
+  const url = new URL(pageUrl);
+  for (const key of ['comment', 'comments', 'feedback']) url.searchParams.delete(key);
+  url.searchParams.set('comments', room);
+  return url.href;
+}
