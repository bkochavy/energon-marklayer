+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { describe, expect, test } from 'bun:test';
+import { adoptStyles } from './dom-styles';
+
+describe('adoptStyles', () => {
+  test('preserves existing and subsequently adopted sheets through repeated cleanup', () => {
+    const root = document.createElement('div').attachShadow({ mode: 'open' });
+    const authored = new CSSStyleSheet();
+    root.adoptedStyleSheets = [authored];
+    const removeFirst = adoptStyles({ root, css: '.first { color: red }' });
+    const removeSecond = adoptStyles({ root, css: '.second { color: blue }' });
+    expect(root.adoptedStyleSheets).toHaveLength(3);
+    expect(root.querySelector('style')).toBeNull();
+    removeFirst();
+    removeFirst();
+    expect(root.adoptedStyleSheets).toHaveLength(2);
+    expect(root.adoptedStyleSheets[0]).toBe(authored);
+    removeSecond();
+    expect(root.adoptedStyleSheets).toEqual([authored]);
+  });
+
+  test('document cursor sheets clean up without removing authored styles', () => {
+    const existing = [...document.adoptedStyleSheets];
+    const authored = new CSSStyleSheet();
+    document.adoptedStyleSheets = [...existing, authored];
+    for (let i = 0; i < 2; i++) {
+      const remove = adoptStyles({ root: document, css: 'body { cursor: pointer }' });
+      expect(document.adoptedStyleSheets).toHaveLength(existing.length + 2);
+      remove();
+      expect(document.adoptedStyleSheets).toEqual([...existing, authored]);
+    }
+    document.adoptedStyleSheets = existing;
+  });
+});
