+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { cn } from '@marklayer/ui/cn';
+import { Check } from 'lucide-preact';
+import type { RefObject } from 'preact';
+import { useEffect, useRef, useState } from 'preact/hooks';
+import { secondaryBtn, submitBtn } from '../lib/buttons';
+import { useCardHold } from '../lib/card-hold';
+import { localUser, setAttributionName } from '../lib/identity';
+import { relabelOwnWork, setUserName } from '../lib/rename';
+import {
+  commitReviewerName,
+  forgetReviewerName,
+  REVIEWER_NAME_LIMIT,
+  registerReviewerComposer,
+  reviewerNameChoice,
+  skipReviewerName,
+} from '../lib/reviewer-name';
+
+/** The name step opens with the composer and never owns a pending submission. */
+export function useReviewerName({
+  focusRef,
+  active = true,
+  onCancel,
+}: {
+  focusRef: RefObject<HTMLTextAreaElement | null>;
+  active?: boolean;
+  onCancel: () => void;
+}) {
+  const wasActive = useRef(false);
+  const needsName = useRef(false);
+  const choice = reviewerNameChoice.value;
+  if (active && !wasActive.current) needsName.current = choice === 'ask';
+  if (choice !== 'ask') needsName.current = false;
+  wasActive.current = active;
+  const asking = active && needsName.current;
+  const hold = useCardHold();
+  const boundaryRef = useRef<HTMLDivElement>(null);
+  useEffect(() => {
+    const field = focusRef.current;
+    if (!active || asking || !field) return;
+    return registerReviewerComposer(field);
+  }, [active, asking, focusRef]);
+  useEffect(() => {
+    if (!asking) return;
+    hold?.(true);
+    return () => hold?.(false);
+  }, [asking]);
+  const wasAsking = useRef(asking);
+  useEffect(() => {
+    if (active && wasAsking.current && !asking) focusRef.current?.focus();
+    wasAsking.current = asking;
+  }, [active, asking]);
+  return {
+    boundaryRef,
+    asking,
+    cancel: onCancel,
+    accept(name: string) {
+      commitReviewerName(name);
+    },
+    skip: skipReviewerName,
+  };
+}
+
+const field =
+  'min-w-0 flex-1 w-full h-7 box-border rounded-md border border-solid border-(--ds-gray-900) bg-(--ds-background-100) px-2 text-meta pointer-coarse:text-[16px] text-(--ds-gray-1000) placeholder:text-(--ds-gray-900) placeholder:opacity-100 outline-none focus:border-(--ds-gray-1000) focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-(--ds-focus-color)';
+
+/** Shared by the first-composer card and the voluntary toolbar action. */
+export function ReviewerNameForm({
+  beforeWriting = false,
+  onSave,
+  onDismiss,
+  inputRef,
+}: {
+  beforeWriting?: boolean;
+  onSave: (name: string) => void;
+  onDismiss: () => void;
+  inputRef?: RefObject<HTMLInputElement>;
+}) {
+  const [draft, setDraft] = useState('');
+  const ownInput = useRef<HTMLInputElement>(null);
+  const input = inputRef ?? ownInput;
+  useEffect(() => {
+    input.current?.focus();
+  }, []);
+  const save = () => {
+    if (draft.trim()) onSave(draft);
+  };
+  return (
+    <div
+      class="p-4 min-w-0"
+      onKeyDown={(e) => {
+        if (e.key === 'Enter' && e.target === input.current && !e.isComposing) {
+          e.preventDefault();
+          e.stopPropagation();
+          save();
+        }
+      }}
+    >
+      <h2 class="m-0 text-ui font-semibold text-(--ds-gray-1000)">
+        {beforeWriting ? 'First, what’s your name?' : 'Add your name'}
+      </h2>
+      <p class="mt-1.5 mb-3 text-meta leading-body text-(--ds-gray-900)">
+        Your name helps everyone know who left the feedback.
+      </p>
+      <input
+        ref={input}
+        class={cn(field, 'h-9')}
+        aria-label="Your name"
+        placeholder="Your name"
+        autoComplete="name"
+        maxLength={REVIEWER_NAME_LIMIT}
+        value={draft}
+        onInput={(e) => setDraft(e.currentTarget.value)}
+      />
+      <div class="mt-3 flex flex-wrap items-center gap-2">
+        <button
+          type="button"
+          class={cn(submitBtn, 'disabled:opacity-40 disabled:cursor-default')}
+          disabled={!draft.trim()}
+          onClick={save}
+        >
+          {beforeWriting ? 'Continue to comment' : 'Save name'}
+        </button>
+        <button type="button" class={secondaryBtn} onClick={onDismiss}>
+          {beforeWriting ? 'Skip for this review' : 'Not now'}
+        </button>
+      </div>
+    </div>
+  );
+}
+
+export function ReviewerNameRow({ gate }: { gate: ReturnType<typeof useReviewerName> }) {
+  return (
+    <div
+      onKeyDown={(e) => {
+        if (e.key === 'Escape' && !e.isComposing) {
+          e.preventDefault();
+          e.stopPropagation();
+          gate.cancel();
+        }
+      }}
+    >
+      <ReviewerNameForm beforeWriting onSave={gate.accept} onDismiss={gate.skip} />
+    </div>
+  );
+}
+
+/** Own author text edits native signed work; Forget only changes future attribution. */
+export function ReviewerAuthor({ author, authorId }: { author?: string; authorId?: string }) {
+  const [editing, setEditing] = useState(false);
+  // A dismissed edit is local to this author control; null means start from the committed name.
+  const [draft, setDraft] = useState<string | null>(null);
+  const hold = useCardHold();
+  const input = useRef<HTMLInputElement>(null);
+  const button = useRef<HTMLButtonElement>(null);
+  const editor = useRef<HTMLSpanElement>(null);
+  const close = () => {
+    setDraft(null);
+    setEditing(false);
+    requestAnimationFrame(() => button.current?.focus());
+  };
+  useEffect(() => {
+    if (!editing) return;
+    input.current?.focus();
+    hold?.(true);
+    const onEscape = (event: KeyboardEvent) => {
+      if (event.key !== 'Escape' || event.defaultPrevented || event.isComposing) return;
+      event.preventDefault();
+      close();
+    };
+    // Composed-path dismissal works inside the shadow root.
+    // Pointer movement never dismisses; an outside press preserves the draft and the clicked target's focus.
+    const onOutside = (event: PointerEvent) => {
+      if (!editor.current || event.composedPath().includes(editor.current)) return;
+      setEditing(false);
+    };
+    document.addEventListener('pointerdown', onOutside, true);
+    document.addEventListener('keydown', onEscape);
+    return () => {
+      document.removeEventListener('pointerdown', onOutside, true);
+      document.removeEventListener('keydown', onEscape);
+      hold?.(false);
+    };
+    // The provider's report closure changes on a latch render; this is one hold per edit.
+  }, [editing]);
+  if (reviewerNameChoice.value === 'disabled' || !authorId || authorId !== localUser.id)
+    return <>{author || 'Anonymous'}</>;
+  const save = () => {
+    const name = (draft ?? '').trim().slice(0, REVIEWER_NAME_LIMIT);
+    if (!name) return;
+    if (name === localUser.name) setAttributionName(name);
+    else setUserName(name);
+    // A stored ID proves ownership; ambiguous legacy names and assignments stay untouched.
+    relabelOwnWork({ authorIdOnly: true });
+    reviewerNameChoice.value = 'ready';
+    close();
+  };
+  if (editing)
+    return (
+      <span
+        ref={editor}
+        class="inline-flex items-center gap-1 w-full min-w-0"
+        onKeyDown={(e) => {
+          if (e.key === 'Escape' && !e.isComposing) {
+            e.preventDefault();
+            e.stopPropagation();
+            close();
+          }
+        }}
+      >
+        <input
+          ref={input}
+          class={cn(field, 'h-5 px-1')}
+          aria-label="Your name"
+          title="Update your name on your comments"
+          maxLength={REVIEWER_NAME_LIMIT}
+          value={draft ?? ''}
+          onInput={(e) => setDraft(e.currentTarget.value)}
+          onKeyDown={(e) => {
+            if (e.key === 'Enter' && !e.isComposing) {
+              e.preventDefault();
+              e.stopPropagation();
+              save();
+            }
+          }}
+        />
+        <button
+          type="button"
+          aria-label="Save name"
+          disabled={!draft?.trim()}
+          onClick={save}
+          class="shrink-0 p-0 border-0 bg-transparent text-inherit cursor-pointer disabled:opacity-40"
+        >
+          <Check size={13} />
+        </button>
+        <button
+          type="button"
+          onClick={() => {
+            forgetReviewerName();
+            close();
+          }}
+          class="shrink-0 p-0 border-0 bg-transparent text-inherit text-micro cursor-pointer"
+        >
+          Forget
+        </button>
+      </span>
+    );
+  return (
+    <button
+      ref={button}
+      type="button"
+      aria-label={`Change your name: ${localUser.name}`}
+      title="Change your name"
+      class="max-w-full truncate p-0 border-0 bg-transparent text-inherit font-inherit cursor-pointer hover:underline focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-(--ds-focus-color)"
+      onClick={() => {
+        if (draft === null) setDraft(localUser.name);
+        setEditing(true);
+      }}
+    >
+      {author || 'Anonymous'}
+    </button>
+  );
+}
