new file mode 100644
index 0000000000000000000000000000000000000000..83eb807fb714bfcac13e79aa42a3748463db3ea1
--- /dev/null
+++ b/apps/extension/lib/useSelectionOffer.ts
@@ -0,0 +1,122 @@
+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { useEffect, useRef, useState } from 'preact/hooks';
+import { editableTarget, isEditableElement } from './dom';
+import { bindKeymap } from './keymap';
+import { useCoarsePointer } from './media';
+import { type CapturedSelection, captureSelection } from './selection-capture';
+import { isExtensionElement } from './selector';
+import { isTextEditing } from './text-edit';
+import { selectionCaptureArmed } from './tool-state';
+
+/** Owns the pending native selection and its dismissal, without opening a composer. */
+export function useSelectionOffer<T>({
+  enabled,
+  createOffer,
+}: {
+  enabled: boolean;
+  createOffer: (selection: CapturedSelection) => T | null;
+}) {
+  const coarse = useCoarsePointer();
+  const [pending, setPending] = useState<T | null>(null);
+  const create = useRef(createOffer);
+  create.current = createOffer;
+
+  // Capture before focus moves into our composer; a bare selection keeps its
+  // native focus and copy behavior until the user explicitly chooses Comment.
+  useEffect(() => {
+    if (!enabled) {
+      setPending(null);
+      return;
+    }
+    let frame = 0;
+    let snapshot: Range | null = null;
+    let touching = coarse;
+    let suppressed = false;
+    let beforePointer: Range | null = null;
+    const sameRange = (a: Range, b: Range) =>
+      a.startContainer === b.startContainer &&
+      a.startOffset === b.startOffset &&
+      a.endContainer === b.endContainer &&
+      a.endOffset === b.endOffset;
+    const ownEvent = (e: Event) => e.composedPath().some((node) => node instanceof Element && isExtensionElement(node));
+    const clear = () => {
+      cancelAnimationFrame(frame);
+      snapshot = null;
+      setPending(null);
+    };
+    const start = (e: PointerEvent) => {
+      if (ownEvent(e)) return;
+      touching = e.pointerType === 'touch' || coarse;
+      suppressed = false;
+      const sel = window.getSelection();
+      beforePointer = sel?.rangeCount ? sel.getRangeAt(0).cloneRange() : null;
+      clear();
+    };
+    const read = (requireChanged = false) => {
+      const sel = window.getSelection();
+      const captured = captureSelection({ sel });
+      if (!captured || !sel?.rangeCount || isExtensionElement(captured.el)) {
+        clear();
+        return;
+      }
+      // Clicking elsewhere must not resurrect a pill for an old selection.
+      if (requireChanged && beforePointer && sameRange(beforePointer, sel.getRangeAt(0))) return;
+      const next = create.current(captured);
+      if (!next) {
+        clear();
+        return;
+      }
+      snapshot = sel.getRangeAt(0).cloneRange();
+      setPending(next);
+    };
+    const release = (e: PointerEvent) => {
+      if (e.button !== 0 || ownEvent(e) || editableTarget(e) || !selectionCaptureArmed.value || isTextEditing()) return;
+      cancelAnimationFrame(frame);
+      frame = requestAnimationFrame(() => read(true));
+    };
+    const changed = () => {
+      // Native touch handles update Selection without a DOM pointerup. Read the
+      // final range on the next frame; never focus or open a composer here.
+      if (touching && !suppressed && selectionCaptureArmed.value && !isTextEditing()) {
+        cancelAnimationFrame(frame);
+        frame = requestAnimationFrame(() => {
+          // Inputs keep a separate selection on some engines. A toolbar button
+          // may retain focus in Safari while the user selects page text, however.
+          let focused = document.activeElement;
+          while (focused?.shadowRoot?.activeElement) focused = focused.shadowRoot.activeElement;
+          if (isEditableElement(focused)) {
+            clear();
+            return;
+          }
+          read();
+        });
+        return;
+      }
+      if (!snapshot) return;
+      const sel = window.getSelection();
+      const range = sel?.rangeCount ? sel.getRangeAt(0) : null;
+      if (!range || sel?.isCollapsed || !sameRange(range, snapshot)) clear();
+    };
+    const dismiss = () => {
+      suppressed = true;
+      clear();
+    };
+    const unbind = bindKeymap({ scope: window, bindings: [{ keys: 'Escape', on: dismiss }] });
+    window.addEventListener('pointerdown', start, true);
+    window.addEventListener('pointerup', release);
+    window.addEventListener('pointercancel', clear);
+    window.addEventListener('scroll', dismiss, true);
+    document.addEventListener('selectionchange', changed);
+    return () => {
+      cancelAnimationFrame(frame);
+      window.removeEventListener('pointerdown', start, true);
+      window.removeEventListener('pointerup', release);
+      window.removeEventListener('pointercancel', clear);
+      window.removeEventListener('scroll', dismiss, true);
+      unbind();
+      document.removeEventListener('selectionchange', changed);
+    };
+  }, [enabled, coarse]);
+
+  return { pending, dismiss: () => setPending(null) };
+}
