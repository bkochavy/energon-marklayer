+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { useComputed } from '@preact/signals';
+import { scrollTick } from '../lib/host-mutations';
+import { deviceForWidth } from '../lib/view-context';
+
+/** useOverlayHost already feeds this native tick on scroll and resize. */
+export function useReviewView() {
+  return useComputed(() => {
+    scrollTick.value;
+    return deviceForWidth(window.innerWidth);
+  }).value;
+}
