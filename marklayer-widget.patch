+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { Tooltip } from '../components/Tooltip';
+
+export const COMMENT_GUIDANCE = 'Click or highlight text';
+
+/** Shared, stable hover/focus labels for every feedback control surface. */
+export const CONTROL_HINT_CSS = `
+.ml-hint-trigger { position:relative; }
+.ml-control-hint { display:block; box-sizing:border-box; max-width:calc(100vw - 24px); padding:8px 10px; border:1px solid #ffffff14; border-radius:8px; background:#27272a; color:#fafafa; box-shadow:0 4px 14px #0002; font:400 11px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; letter-spacing:0; text-align:left; white-space:nowrap; pointer-events:none; outline:none; transition:opacity .1s ease; }
+.ml-control-hint-detail-layout { width:224px; white-space:normal; }
+.ml-control-hint-title { display:flex; align-items:center; justify-content:space-between; gap:14px; font-weight:500; }
+.ml-control-hint-detail { display:block; margin-top:4px; color:#d4d4d8; font-weight:400; }
+.ml-control-hint kbd { display:inline-flex; align-items:center; justify-content:center; min-width:17px; height:17px; padding:0 3px; border:1px solid #ffffff35; border-radius:4px; font:inherit; font-size:10px; font-weight:500; line-height:1; color:#e4e4e7; }
+.ml-control-hint[data-starting-style],.ml-control-hint[data-ending-style] { opacity:0; }
+@media(prefers-reduced-motion:reduce) { .ml-control-hint { transition:none; } }
+`;
+
+export function ControlHint({
+  id,
+  title,
+  shortcut,
+  detail,
+  align = 'center',
+  side = 'top',
+}: {
+  id: string;
+  title: string;
+  shortcut?: string;
+  detail?: string;
+  align?: 'center' | 'end';
+  side?: 'top' | 'bottom';
+}) {
+  return (
+    <Tooltip
+      id={id}
+      placement={side}
+      align={align}
+      sideOffset={side === 'top' ? 12 : 8}
+      delay={200}
+      className={`ml-control-hint${detail ? ' ml-control-hint-detail-layout' : ''}`}
+    >
+      <span class="ml-control-hint-title">
+        {title}
+        {shortcut && <kbd>{shortcut}</kbd>}
+      </span>
+      {detail && <span class="ml-control-hint-detail">{detail}</span>}
+    </Tooltip>
+  );
+}
