+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { afterEach, beforeEach, describe, expect, mock, test } from 'bun:test';
+import { hydrateIdentity, localUser, setAttributionName, signedBy } from '../lib/identity';
+import { operations } from '../lib/ops';
+import { commitReviewerName, forgetReviewerName, reviewerNameChoice, skipReviewerName } from '../lib/reviewer-name';
+import { toasts } from '../lib/toasts';
+import { createReviewerIdentityStore, parseReviewerIdentity, type ReviewerIdentity } from './identity-store';
+
+const initial: ReviewerIdentity = {
+  id: 'a'.repeat(64),
+  name: null,
+  endpoint: 'https://share.example.com/comments/identity',
+  capability: 'initial',
+};
+const fetchBefore = globalThis.fetch;
+const tick = () => new Promise((resolve) => setTimeout(resolve, 0));
+const ok = (capability: string) => Response.json({ capability });
+
+describe('native identity with explicit host persistence', () => {
+  beforeEach(() => {
+    toasts.value = [];
+    operations.value = [];
+  });
+  afterEach(() => {
+    globalThis.fetch = fetchBefore;
+    hydrateIdentity(undefined);
+    reviewerNameChoice.value = 'disabled';
+    operations.value = [];
+  });
+
+  test('hydrate restores native ID without saving generated values; skip is page-only and explicit Guest does save', async () => {
+    const fetcher = mock(async (_url: RequestInfo | URL, _options?: RequestInit) => ok('saved'));
+    globalThis.fetch = fetcher as unknown as typeof fetch;
+    hydrateIdentity(createReviewerIdentityStore(initial));
+    expect(signedBy()).toEqual({ author: expect.stringMatching(/^[A-Z][a-z]+ [A-Z][a-z]+$/), authorId: initial.id });
+    const anonymousName = localUser.name;
+    expect(reviewerNameChoice.value).toBe('ask');
+    skipReviewerName();
+    expect(localUser.name).toBe(anonymousName);
+    await tick();
+    expect(fetcher).not.toHaveBeenCalled();
+    commitReviewerName('Guest');
+    await tick();
+    expect(fetcher).toHaveBeenCalledTimes(1);
+    expect(JSON.parse(fetcher.mock.calls[0]?.[1]?.body as string)).toEqual({ name: 'Guest' });
+  });
+
+  test('restores a committed name into native attribution without a prompt', () => {
+    hydrateIdentity(createReviewerIdentityStore({ ...initial, name: 'Alex' }));
+    expect(localUser.name).toBe('Alex');
+    expect(reviewerNameChoice.value).toBe('ready');
+  });
+
+  test('save then Forget serialize their capabilities; neither operation rewrites history', async () => {
+    let release!: (response: Response) => void;
+    const fetcher = mock(
+      (_url: RequestInfo | URL, _options?: RequestInit): Promise<Response> =>
+        fetcher.mock.calls.length === 1
+          ? new Promise((resolve) => {
+              release = resolve;
+            })
+          : Promise.resolve(ok('forgotten')),
+    );
+    globalThis.fetch = fetcher as unknown as typeof fetch;
+    hydrateIdentity(createReviewerIdentityStore(initial));
+    operations.value = [
+      {
+        id: 'past',
+        tool: 'comment',
+        text: 'Existing',
+        author: 'Before',
+        authorId: initial.id,
+        x: 1,
+        y: 2,
+        num: 1,
+        ts: 1,
+        color: '#000',
+        lineWidth: 1,
+      },
+    ];
+    commitReviewerName('Alex');
+    forgetReviewerName();
+    await tick();
+    expect(fetcher).toHaveBeenCalledTimes(1);
+    expect(localUser.name).toMatch(/^[A-Z][a-z]+ [A-Z][a-z]+$/);
+    expect(reviewerNameChoice.value).toBe('ask');
+    release(ok('after-save'));
+    await tick();
+    expect(fetcher).toHaveBeenCalledTimes(2);
+    const options = fetcher.mock.calls[1]?.[1];
+    expect(options?.method).toBe('DELETE');
+    expect(options?.headers).toEqual({ Authorization: 'Bearer after-save', 'content-type': 'application/json' });
+    expect(options?.credentials).toBe('omit');
+    expect(options?.signal).toBeInstanceOf(AbortSignal);
+    expect(operations.value[0]?.author).toBe('Before');
+  });
+
+  test('stale save is not retried and cannot prevent explicit Forget from running', async () => {
+    const fetcher = mock((_url: RequestInfo | URL, _options?: RequestInit) =>
+      Promise.resolve(fetcher.mock.calls.length === 1 ? new Response('', { status: 409 }) : ok('forgotten')),
+    );
+    globalThis.fetch = fetcher as unknown as typeof fetch;
+    hydrateIdentity(createReviewerIdentityStore(initial));
+    commitReviewerName('Alex');
+    forgetReviewerName();
+    await tick();
+    expect(fetcher).toHaveBeenCalledTimes(2);
+    expect(fetcher.mock.calls[1]?.[1]?.method).toBe('DELETE');
+    expect(toasts.value[0]?.message).toContain('Couldn’t remember');
+  });
+
+  test('expired persistence keeps native attribution immediately and reports reopening, without retry', async () => {
+    const fetcher = mock(async () => new Response('', { status: 401 }));
+    globalThis.fetch = fetcher as unknown as typeof fetch;
+    hydrateIdentity(createReviewerIdentityStore(initial));
+    commitReviewerName('Alex');
+    expect(signedBy()).toEqual({ author: 'Alex', authorId: initial.id });
+    await tick();
+    expect(fetcher).toHaveBeenCalledTimes(1);
+    expect(toasts.value[0]?.message).toContain('Reopen this review');
+  });
+
+  test('ordinary native stores retain automatic defaults and future attribution saves', () => {
+    const save = mock(() => {});
+    hydrateIdentity({ load: () => ({}), save });
+    expect(save).toHaveBeenCalledTimes(1);
+    setAttributionName('Native');
+    expect(save).toHaveBeenLastCalledWith({ name: 'Native' });
+  });
+
+  test('bootstrap accepts only the same-host preference endpoint', () => {
+    expect(parseReviewerIdentity(JSON.stringify(initial), 'https://share.example.com/static/widget.js')).toEqual(
+      initial,
+    );
+    for (const endpoint of [
+      'https://evil.example/comments/identity',
+      'https://share.example.com/v1/files',
+      'https://share.example.com/comments/identity?token=x',
+    ]) {
+      expect(
+        parseReviewerIdentity(JSON.stringify({ ...initial, endpoint }), 'https://share.example.com/static/widget.js'),
+      ).toBeUndefined();
+    }
+    expect(parseReviewerIdentity('{bad', 'https://share.example.com/static/widget.js')).toBeUndefined();
+  });
+});
