+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { expect, test } from 'bun:test';
+import { reviewPageUrl } from './review-link';
+
+test.each(['comment', 'comments', 'feedback'])('canonical review link replaces %s without losing page state', (key) => {
+  const link = new URL(
+    reviewPageUrl(
+      `https://share.example.test/reviewer/s/site/example/?variant=one&${key}=new&variant=two#section`,
+      'concrete-room',
+    ),
+  );
+  expect(link.origin).toBe('https://share.example.test');
+  expect(link.pathname).toBe('/ben/s/site/example/');
