diff --git a/apps/extension/lib/comment-gesture-tail.test.ts b/apps/extension/lib/comment-gesture-tail.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..469806578201ce94b7592198ca56f52540e0c8b7
--- /dev/null
+++ b/apps/extension/lib/comment-gesture-tail.test.ts
@@ -0,0 +1,95 @@
+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { afterEach, expect, test } from 'bun:test';
+import { bindCommentGestures } from './comment-gestures';
+
+const page = document.createElement('div');
+const widget = document.createElement('mark-layer');
+const button = document.createElement('button');
+widget.attachShadow({ mode: 'open' }).append(button);
+let dispose: (() => void) | undefined;
+afterEach(() => {
+  dispose?.();
+  dispose = undefined;
+  page.remove();
+  widget.remove();
+});
+
+function pointer(target: Element, type: string) {
+  target.dispatchEvent(
+    new PointerEvent(type, {
+      bubbles: true,
+      composed: true,
+      isPrimary: true,
+      pointerId: 1,
+      pointerType: 'touch',
+      button: 0,
+      clientX: 20,
+      clientY: 20,
+    }),
+  );
+}
+function mouse(target: Element, type: string, detail = 1) {
+  const event = new MouseEvent(type, { bubbles: true, composed: true, cancelable: true, button: 0, detail });
+  target.dispatchEvent(event);
+  return event;
+}
+function open() {
+  document.body.append(page);
+  let pins = 0;
+  dispose = bindCommentGestures(
+    () => {
+      pins++;
+      document.documentElement.append(widget);
+    },
+    { touchDoubleTap: true },
+  );
+  pointer(page, 'pointerdown');
+  pointer(page, 'pointerup');
+  mouse(page, 'click');
+  pointer(page, 'pointerdown');
+  pointer(page, 'pointerup');
+  expect(pins).toBe(1);
+}
+
+test('opening touch gesture cannot activate a newly mounted composer control', () => {
+  open();
+  const received: string[] = [];
+  const record = (event: Event) => received.push(event.type);
+  for (const type of ['mousedown', 'mouseup', 'click']) button.addEventListener(type, record);
+  try {
+    for (const type of ['mousedown', 'mouseup', 'click']) expect(mouse(button, type).defaultPrevented).toBe(true);
+    expect(received).toEqual([]);
+    pointer(button, 'pointerdown');
+    pointer(button, 'pointerup');
+    expect(mouse(button, 'click').defaultPrevented).toBe(false);
+    expect(received).toEqual(['click']);
+  } finally {
+    for (const type of ['mousedown', 'mouseup', 'click']) button.removeEventListener(type, record);
+  }
+});
+
+test('pointerup-only browsers do not lose the next intentional UI tap', () => {
+  open();
+  pointer(button, 'pointerdown');
+  pointer(button, 'pointerup');
+  expect(mouse(button, 'click').defaultPrevented).toBe(false);
+});
+
+test('keyboard clicks remain independent of an unfinished compatibility tail', () => {
+  open();
+  expect(mouse(button, 'click', 0).defaultPrevented).toBe(false);
+  expect(mouse(button, 'click').defaultPrevented).toBe(true);
+  expect(mouse(button, 'click').defaultPrevented).toBe(false);
+});
+
+test('gesture cancellation and disposal release any pending compatibility tail', () => {
+  open();
+  pointer(page, 'pointercancel');
+  expect(mouse(button, 'click').defaultPrevented).toBe(false);
+  dispose?.();
+  open();
+  dispose?.();
+  expect(mouse(button, 'mousedown').defaultPrevented).toBe(false);
+  expect(mouse(button, 'mouseup').defaultPrevented).toBe(false);
+  expect(mouse(button, 'click').defaultPrevented).toBe(false);
+});
diff --git a/apps/extension/lib/comment-gestures.test.ts b/apps/extension/lib/comment-gestures.test.ts
