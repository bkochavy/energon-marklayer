diff --git a/apps/extension/lib/reviewer-name.ts b/apps/extension/lib/reviewer-name.ts
new file mode 100644
index 0000000000000000000000000000000000000000..901d23fa91f88883c4db80d12301fe80e3c84270
--- /dev/null
+++ b/apps/extension/lib/reviewer-name.ts
@@ -0,0 +1,51 @@
+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { signal } from '@preact/signals';
+import { randomUserName, setAttributionName } from './identity';
+
+/** The host's prompt policy, not a second identity: attribution stays in localUser. */
+export const reviewerNameChoice = signal<'disabled' | 'ask' | 'skipped' | 'ready'>('disabled');
+let forgetPreference: (() => void) | undefined;
+export const REVIEWER_NAME_LIMIT = 24;
+
+export function configureReviewerName(name: string | null, forget: () => void) {
+  reviewerNameChoice.value = name ? 'ready' : 'ask';
+  forgetPreference = forget;
+}
+
+export function commitReviewerName(name: string) {
+  const committed = name.trim().slice(0, REVIEWER_NAME_LIMIT);
+  if (!committed) return false;
+  setAttributionName(committed);
+  reviewerNameChoice.value = 'ready';
+  return true;
+}
+
+export function skipReviewerName() {
+  reviewerNameChoice.value = 'skipped';
+}
+
+export function forgetReviewerName() {
+  setAttributionName(randomUserName(), { persist: false });
+  reviewerNameChoice.value = 'ask';
+  forgetPreference?.();
+}
+
+const composerFields = new Set<HTMLTextAreaElement>();
+
+/** Keep native fields in focus order; closed composers unregister themselves. */
+export function registerReviewerComposer(field: HTMLTextAreaElement) {
+  const remember = () => {
+    composerFields.delete(field);
+    composerFields.add(field);
+  };
+  remember();
+  field.addEventListener('focus', remember);
+  return () => {
+    field.removeEventListener('focus', remember);
+    composerFields.delete(field);
+  };
+}
+
+export function reviewerNameFocusTarget() {
+  return [...composerFields].reverse().find((field) => field.isConnected);
+}
