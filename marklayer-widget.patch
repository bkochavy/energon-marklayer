+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { afterEach, expect, mock, test } from 'bun:test';
+import { render } from 'preact';
+import * as compat from 'preact/compat';
+import * as jsxRuntime from 'preact/jsx-runtime';
+import { act } from 'preact/test-utils';
+import { portalContainer } from '../lib/portal';
+
+const baseUi = Bun.resolveSync('@base-ui/react', import.meta.dir);
+mock.module(Bun.resolveSync('react', baseUi), () => compat);
+mock.module(Bun.resolveSync('react-dom', baseUi), () => compat);
+mock.module(Bun.resolveSync('react/jsx-runtime', baseUi), () => jsxRuntime);
+const { ControlHint } = await import('./ControlHint');
+const { Tooltip } = await import('../components/Tooltip');
+const root = document.createElement('div');
+const portal = document.createElement('div');
+const wait = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));
+
+afterEach(() => {
+  render(null, root);
+  root.remove();
+  portal.remove();
+  portalContainer.value = null;
+});
+
+test('review hint uses native portal with the chosen title, key and detail after its delay', async () => {
+  document.body.append(root, portal);
+  portalContainer.value = portal;
+  await act(() =>
+    render(
+      <button type="button">
+        Comment
+        <ControlHint
+          id="review-hint"
+          title="Click or highlight text"
+          shortcut="C"
+          detail="Keep this selected guidance"
+        />
+      </button>,
+      root,
+    ),
+  );
+  const button = root.querySelector('button')!;
+  await act(() => {
+    button.dispatchEvent(new MouseEvent('mouseenter'));
+  });
+  expect(portal.querySelector('#review-hint')).toBeNull();
+  await act(() => wait(220));
+  const tip = portal.querySelector('#review-hint')!;
+  expect(tip.getAttribute('role')).toBe('tooltip');
+  expect(tip.classList.contains('ml-control-hint')).toBe(true);
+  expect(tip.querySelector('.ml-control-hint-title')?.textContent).toBe('Click or highlight textC');
+  expect(tip.querySelector('.ml-control-hint-detail')?.textContent).toBe('Keep this selected guidance');
+  expect(root.querySelector('#review-hint')).toBeNull();
+  await act(() => {
+    button.dispatchEvent(new MouseEvent('mouseleave'));
+  });
+  expect(portal.querySelector('[data-open]')).toBeNull();
+});
+
+test('a brief hover and unmount cancel pending native hint reveals', async () => {
+  document.body.append(root, portal);
+  portalContainer.value = portal;
+  await act(() =>
+    render(
+      <button type="button">
+        Link
+        <ControlHint id="cancelled-hint" title="Copy review link" shortcut="L" />
+      </button>,
+      root,
+    ),
+  );
+  const button = root.querySelector('button')!;
+  await act(() => {
+    button.dispatchEvent(new MouseEvent('mouseenter'));
+    button.dispatchEvent(new MouseEvent('mouseleave'));
+  });
+  await act(() => wait(220));
+  expect(portal.querySelector('#cancelled-hint')).toBeNull();
+  await act(() => {
+    button.dispatchEvent(new MouseEvent('mouseenter'));
+    render(null, root);
+  });
+  await act(() => wait(220));
+  expect(portal.querySelector('#cancelled-hint')).toBeNull();
+});
+
+test('ordinary native Tooltip callers keep their default presentation and immediate opening', async () => {
+  document.body.append(root, portal);
+  portalContainer.value = portal;
+  await act(() =>
+    render(
+      <button type="button">
+        Native
+        <Tooltip text="Native label" shortcut="C" />
+      </button>,
+      root,
+    ),
+  );
+  await act(() => {
+    root.querySelector('button')!.dispatchEvent(new MouseEvent('mouseenter'));
+  });
+  const tip = portal.querySelector('[role="tooltip"]')!;
+  expect(tip.textContent).toContain('Native label');
+  expect(tip.querySelector('kbd')?.textContent).toBe('C');
+  expect(tip.classList.contains('ml-control-hint')).toBe(false);
+});
