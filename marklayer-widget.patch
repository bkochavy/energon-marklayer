+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { ChevronUp } from 'lucide-preact';
+import type { ComponentChildren } from 'preact';
+import { useBrowseVisibility } from './useBrowseVisibility';
+
+export const BROWSE_VISIBILITY_CSS = `
+.ml-browse-visibility [data-browse-controls] { transition:opacity 150ms ease,translate 180ms ease,visibility 180ms; }
+.ml-browse-visibility[data-retreated="true"] [data-browse-controls] { opacity:0; translate:0 calc(100% + 20px); visibility:hidden; pointer-events:none; }
+.ml-browse-return { position:fixed; left:50%; transform:translateX(-50%); bottom:0; z-index:2147483647; display:flex; align-items:center; justify-content:center; gap:6px; min-height:27px; padding:0 12px; box-sizing:border-box; border:1px solid #18181b21; border-bottom:0; border-radius:9px 9px 0 0; background:#fff; color:#52525b; box-shadow:0 2px 9px #0000000a; font:500 11px/1.4 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; cursor:pointer; opacity:0; visibility:hidden; pointer-events:none; transition:opacity 150ms ease,visibility 150ms; }
+.ml-browse-return:hover { color:#18181b; background:#fafafa; }
+.ml-browse-return:focus-visible { outline:2px solid #0070f3; outline-offset:2px; }
+.ml-browse-visibility[data-retreated="true"] > .ml-browse-return { opacity:1; visibility:visible; pointer-events:auto; }
+@media(prefers-reduced-motion:reduce) { .ml-browse-visibility [data-browse-controls],.ml-browse-return { transition:none; } }
