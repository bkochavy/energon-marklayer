+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { afterEach, expect, test } from 'bun:test';
+import { render } from 'preact';
+import { act } from 'preact/test-utils';
+import { useBrowseVisibility } from './useBrowseVisibility';
+
+const root = document.createElement('div');
+const originalScrollY = Object.getOwnPropertyDescriptor(window, 'scrollY');
+function Fixture({ nameOpen }: { nameOpen: boolean }) {
+  const state = useBrowseVisibility(true, () => {});
+  return (
+    <div ref={state.root} data-retreated={state.retreated}>
+      <button type="button" data-reviewer-name-action aria-expanded={nameOpen}>
+        Add your name
+      </button>
+    </div>
+  );
+}
+afterEach(() => {
+  render(null, root);
+  root.remove();
+  if (originalScrollY) Object.defineProperty(window, 'scrollY', originalScrollY);
+  else delete (window as unknown as { scrollY?: number }).scrollY;
+});
+
+test('keyboard scrolling cannot tuck the toolbar while the touch name popup is open', async () => {
+  document.body.append(root);
+  Object.defineProperty(window, 'scrollY', { configurable: true, value: 0 });
+  await act(() => render(<Fixture nameOpen />, root));
+  await act(() => {
+    Object.defineProperty(window, 'scrollY', { configurable: true, value: 200 });
+    window.dispatchEvent(new Event('scroll'));
+  });
+  expect(root.firstElementChild?.getAttribute('data-retreated')).toBe('false');
+  // Ordinary reading scroll resumes after dismissal; no permanent visibility lock.
+  await act(() => render(<Fixture nameOpen={false} />, root));
+  await act(() => {
+    Object.defineProperty(window, 'scrollY', { configurable: true, value: 400 });
+    window.dispatchEvent(new Event('scroll'));
+  });
+  expect(root.firstElementChild?.getAttribute('data-retreated')).toBe('true');
+});
diff --git a/apps/extension/widget/useBrowseVisibility.ts b/apps/extension/widget/useBrowseVisibility.ts
new file mode 100644
index 0000000000000000000000000000000000000000..14fa73a4a700fa8db135bb533c1e7dcd3b33ba0e
--- /dev/null
+++ b/apps/extension/widget/useBrowseVisibility.ts
@@ -0,0 +1,111 @@
+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { useCallback, useEffect, useLayoutEffect, useRef, useState } from 'preact/hooks';
+import { editableTarget } from '../lib/dom';
+
+/** Scroll intent belongs to the page; active feedback and deliberate interaction always win. */
+export function useBrowseVisibility(enabled: boolean, onReveal: () => void) {
+  const root = useRef<HTMLDivElement>(null);
+  const [retreated, setRetreated] = useState(false);
+  const reveal = useCallback(() => setRetreated(false), []);
+
+  const focusRequested = useRef(false);
+  const revealAndFocus = useCallback(() => {
+    focusRequested.current = true;
+    reveal();
+    onReveal();
+  }, [onReveal, reveal]);
+  useLayoutEffect(() => {
+    if (!retreated && focusRequested.current) {
+      focusRequested.current = false;
+      onReveal();
+    }
+  }, [retreated, onReveal]);
+
+  useEffect(() => {
+    if (!enabled) {
+      reveal();
+      return;
+    }
+    let lastX = window.scrollX;
+    let lastY = window.scrollY;
+    let distance = 0;
+    let lastPointer: { x: number; y: number } | null = null;
+    let pointerNear = false;
+    const selecting = () => {
+      const selection = window.getSelection();
+      return Boolean(selection && !selection.isCollapsed && selection.toString().trim());
+    };
+    const protectedInteraction = () =>
+      pointerNear ||
+      selecting() ||
+      // A touch-focused name field is portalled outside this root and need not
+      // match :focus-visible. Keyboard-induced page scroll must not hide its trigger.
+      Boolean(root.current?.querySelector(':focus-visible,[data-reviewer-name-action][aria-expanded="true"]'));
+    const reset = () => {
+      distance = 0;
+    };
+    const show = () => {
+      reset();
+      reveal();
+    };
+    const onScroll = () => {
+      const x = window.scrollX;
+      const y = window.scrollY;
+      const delta = Math.hypot(x - lastX, y - lastY);
+      lastX = x;
+      lastY = y;
+      if (protectedInteraction()) {
+        show();
+        return;
+      }
+      // Direction changes and reaching the top do not interrupt reading.
+      if (delta === 0) return;
+      distance += delta;
+      if (distance >= 100) setRetreated(true);
+    };
+    const onPointerMove = (event: PointerEvent) => {
+      if (event.pointerType !== 'mouse' && event.pointerType !== 'pen') return;
+      const moved = !lastPointer || Math.hypot(event.clientX - lastPointer.x, event.clientY - lastPointer.y) >= 2;
+      if (!moved) return;
+      lastPointer = { x: event.clientX, y: event.clientY };
+      const container = root.current;
+      const tucked = container?.dataset.retreated === 'true';
+      const target = container?.querySelector(tucked ? '.ml-browse-return' : '[data-browse-controls]');
+      const rect = target?.getBoundingClientRect();
+      if (!rect) return;
+      // Measure the actual control/handle, not a broad band across the bottom.
+      const padding = tucked ? 14 : 10;
+      pointerNear =
+        event.clientX >= rect.left - padding &&
+        event.clientX <= rect.right + padding &&
+        event.clientY >= rect.top - padding &&
+        event.clientY <= rect.bottom + padding;
+      if (pointerNear) show();
+    };
+    const onPointerLeave = () => {
+      pointerNear = false;
+      lastPointer = null;
+    };
+    const onSelection = () => {
+      if (selecting()) show();
+    };
+    const onKey = (event: KeyboardEvent) => {
+      if (event.isComposing || editableTarget(event)) return;
+      if (event.key === 'Tab') show();
+    };
+    window.addEventListener('scroll', onScroll, { passive: true });
+    window.addEventListener('pointermove', onPointerMove, { passive: true });
+    document.documentElement.addEventListener('pointerleave', onPointerLeave);
+    document.addEventListener('selectionchange', onSelection);
+    window.addEventListener('keydown', onKey, true);
+    return () => {
+      window.removeEventListener('scroll', onScroll);
+      window.removeEventListener('pointermove', onPointerMove);
+      document.documentElement.removeEventListener('pointerleave', onPointerLeave);
+      document.removeEventListener('selectionchange', onSelection);
+      window.removeEventListener('keydown', onKey, true);
+    };
+  }, [enabled, reveal]);
+
+  return { root, retreated: enabled && retreated, reveal, revealAndFocus };
+}
