+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { expect, test } from 'bun:test';
+import { captureView, deviceForWidth, matchesView, viewContext } from './view-context';
+
+test('embed bands include tablet and use CSS width, not browser identity', () => {
+  expect([390, 767, 768, 1023, 1024, 1440].map(deviceForWidth)).toEqual([
+    'mobile',
+    'mobile',
+    'tablet',
+    'tablet',
+    'desktop',
+    'desktop',
+  ]);
+});
+
+test('explicit native view wins over dimensions; legacy dimensions are inferred', () => {
+  const viewport = { width: 390, height: 844 };
+  expect(viewContext({ device: 'desktop', captureViewport: viewport })).toEqual({
+    device: 'desktop',
+    viewport,
+    inferred: false,
+  });
+  expect(viewContext({ meta: { viewport } })).toEqual({ device: 'mobile', viewport, inferred: true });
+  expect(matchesView({ op: { captureViewport: viewport }, view: 'desktop' })).toBe(false);
+  expect(matchesView({ op: { device: 'mobile' }, view: 'mobile' })).toBe(true);
+  expect(matchesView({ op: { device: 'mobile' } })).toBe(true);
+});
+
+test('unknown and unusable historical dimensions stay visible on every view', () => {
+  for (const width of [0, -1, Number.NaN, Number.POSITIVE_INFINITY]) {
+    const op = { captureViewport: { width, height: 800 } };
+    expect(viewContext(op).device).toBeUndefined();
+    expect(matchesView({ op, view: 'mobile' })).toBe(true);
+    expect(matchesView({ op, view: 'desktop' })).toBe(true);
+  }
+  expect(viewContext({})).toEqual({ device: undefined, viewport: undefined, inferred: false });
+});
+
+test('captured view does not change when the window resizes during a draft', () => {
+  const original = window.innerWidth;
+  try {
+    window.innerWidth = 390;
+    const capture = captureView();
+    window.innerWidth = 1280;
+    expect(capture.device).toBe('mobile');
+    expect(capture.captureViewport.width).toBe(390);
+    expect(captureView().device).toBe('desktop');
+  } finally {
+    window.innerWidth = original;
+  }
+});
diff --git a/apps/extension/lib/view-context.ts b/apps/extension/lib/view-context.ts
new file mode 100644
index 0000000000000000000000000000000000000000..990f07267a04b6d075f80fe32d85ed78c96fb75f
--- /dev/null
+++ b/apps/extension/lib/view-context.ts
@@ -0,0 +1,30 @@
+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import type { CaptureViewport, DeviceMode } from '@marklayer/types/ops';
+
+export interface ViewContext {
+  device?: DeviceMode;
+  captureViewport?: CaptureViewport;
+  meta?: { viewport?: CaptureViewport };
+}
+
+/** Embed layout bands, not hardware detection or the full viewer's fixed frame sizes. */
+export function deviceForWidth(width: number): DeviceMode {
+  return width < 768 ? 'mobile' : width < 1024 ? 'tablet' : 'desktop';
+}
+
+export function captureView() {
+  const captureViewport = { width: window.innerWidth, height: window.innerHeight };
+  return { captureViewport, device: deviceForWidth(captureViewport.width) };
+}
+
+export function viewContext(op: ViewContext) {
+  const saved = op.captureViewport ?? op.meta?.viewport;
+  const viewport = saved && Number.isFinite(saved.width) && saved.width > 0 ? saved : undefined;
+  const device = op.device ?? (viewport ? deviceForWidth(viewport.width) : undefined);
+  return { device, viewport, inferred: !op.device && Boolean(device) };
+}
+
+export function matchesView({ op, view }: { op: ViewContext; view?: DeviceMode }): boolean {
+  const { device } = viewContext(op);
+  return !view || !device || device === view;
+}
