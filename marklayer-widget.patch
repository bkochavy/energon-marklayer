+/* Modified by Ben Kochavy for the Energon integration. SPDX-License-Identifier: Apache-2.0 */
+import { afterEach, expect, mock, spyOn, test } from 'bun:test';
+import { render } from 'preact';
+import * as compat from 'preact/compat';
+import * as jsxRuntime from 'preact/jsx-runtime';
+import { act } from 'preact/test-utils';
+import { activeRoomId } from '../lib/room-id';
+
+// Match the production Vite aliases used by native Base UI components.
+const baseUi = Bun.resolveSync('@base-ui/react', import.meta.dir);
+mock.module(Bun.resolveSync('react', baseUi), () => compat);
+mock.module(Bun.resolveSync('react-dom', baseUi), () => compat);
+mock.module(Bun.resolveSync('react/jsx-runtime', baseUi), () => jsxRuntime);
+const { CopyReviewLink } = await import('./CopyReviewLink');
+const { ReviewDock } = await import('./ReviewDock');
+
+const root = document.createElement('div');
+afterEach(() => {
+  render(null, root);
+  root.remove();
+  activeRoomId.value = null;
+});
+
+test('toolbar and panel copy controls share native copying and distinct shortcut hints', async () => {
+  document.body.append(root);
+  activeRoomId.value = 'existing-room';
+  const write = spyOn(navigator.clipboard, 'writeText').mockResolvedValue(undefined);
+  try {
+    await act(() =>
+      render(
+        <>
+          <CopyReviewLink surface="toolbar" />
+          <CopyReviewLink surface="panel" />
+        </>,
+        root,
+      ),
+    );
+    const buttons = [...root.querySelectorAll<HTMLButtonElement>('button')];
+    expect(buttons).toHaveLength(2);
+    for (const button of buttons) {
+      expect(button.getAttribute('aria-label')).toBe('Copy review link');
+      expect(button.getAttribute('aria-keyshortcuts')).toBe('L');
+      await act(async () => {
+        button.dispatchEvent(new MouseEvent('mouseenter'));
+        await new Promise((resolve) => setTimeout(resolve, 220));
+      });
+      const tooltip = document.querySelector(`#${button.getAttribute('aria-describedby')}`)!;
+      expect(tooltip.textContent).toContain('Copy review link');
+      expect(tooltip.querySelector('kbd')?.textContent).toBe('L');
+      expect(tooltip.getAttribute('data-side')).toBe(button === buttons[0] ? 'top' : 'bottom');
+      await act(async () => {
+        button.click();
+        button.dispatchEvent(new MouseEvent('mouseleave'));
+        await Promise.resolve();
+      });
+    }
+    expect(write.mock.calls).toEqual([
+      ['https://example.com/page?comments=existing-room'],
+      ['https://example.com/page?comments=existing-room'],
+    ]);
+  } finally {
+    write.mockRestore();
+  }
+});
+
+test('normal review toolbar includes one copy action without replacing the labelled controls', async () => {
+  activeRoomId.value = 'room';
+  await act(() =>
+    render(
+      <ReviewDock
+        count={2}
+        commenting={false}
+        composing={false}
+        panelOpen={false}
+        confirmation={false}
+        onBrowse={() => {}}
+        onComment={() => {}}
+        onThreads={() => {}}
+      />,
+      root,
+    ),
+  );
+  expect(root.querySelectorAll('[aria-label="Copy review link"]')).toHaveLength(1);
+  expect(root.querySelector('[aria-label="Browse"]')).not.toBeNull();
+  expect(root.querySelector('[aria-label="Comment"]')).not.toBeNull();
+  expect(root.querySelector('[aria-label="Threads, 2"]')).not.toBeNull();
+});
